{
  "name": "Scarlet",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#binary"
    },
    {
      "include": "#import-statement"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#const-definition"
    },
    {
      "include": "#variable-with-type"
    },
    {
      "include": "#backpass-binding"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#module-qualified-access"
    },
    {
      "include": "#constructor-call"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#labeled-argument"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.scrl"
            },
            "2": {
              "name": "entity.name.function.decorator.scrl"
            },
            "3": {
              "name": "punctuation.brackets.round.scrl"
            },
            "4": {
              "name": "string.unquoted.attribute.scrl"
            },
            "5": {
              "name": "punctuation.brackets.round.scrl"
            }
          },
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)(\\()?([a-zA-Z_][a-zA-Z0-9_]*)?(\\))?",
          "name": "meta.attribute.scrl"
        }
      ]
    },
    "backpass-binding": {
      "captures": {
        "1": {
          "patterns": [
            {
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
              "name": "variable.other.scrl"
            }
          ]
        },
        "2": {
          "name": "keyword.operator.backpass.scrl"
        }
      },
      "comment": "Backpass statement: binder(s) <- call(...)",
      "match": "\\b([a-z_][a-zA-Z0-9_]*(?:\\s*,\\s*[a-z_][a-zA-Z0-9_]*)*)\\s*(<-)"
    },
    "binary": {
      "begin": "<<",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.binary.begin.scrl"
        }
      },
      "comment": "Bit-string literal or pattern: <<expr:spec, ..rest>>. The spec names are contextual identifiers, not keywords.",
      "end": ">>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.binary.end.scrl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "captures": {
            "1": {
              "name": "punctuation.separator.colon.scrl"
            },
            "2": {
              "name": "storage.type.binary-spec.scrl"
            }
          },
          "match": "(:)\\s*(size|bytes)(?=\\s*\\()"
        },
        {
          "captures": {
            "1": {
              "name": "punctuation.separator.colon.scrl"
            },
            "2": {
              "name": "storage.type.binary-spec.scrl"
            }
          },
          "match": "(:)\\s*(binary|utf8)\\b"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.spread.scrl"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#module-qualified-access"
        },
        {
          "include": "#constructor-call"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.scrl"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.scrl"
        },
        {
          "begin": "/\\*\\*(?!/)",
          "comment": "`/**` opens a doc comment, but `/**/` does not.",
          "end": "\\*/",
          "name": "comment.block.documentation.scrl"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.scrl"
        }
      ]
    },
    "const-definition": {
      "captures": {
        "1": {
          "name": "storage.modifier.visibility.scrl"
        },
        "2": {
          "name": "keyword.other.const.scrl"
        },
        "3": {
          "name": "entity.name.function.scrl"
        },
        "4": {
          "name": "entity.name.type.scrl"
        },
        "5": {
          "name": "keyword.operator.assignment.scrl"
        }
      },
      "comment": "The declared name is scoped like a fn declaration name so themes colour toplevel value declarations uniformly.",
      "match": "\\b(pub\\s+)?(const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:([A-Z][a-zA-Z0-9_]*)\\s*)?(=)"
    },
    "constants": {
      "comment": "Prelude constructors themes expect as language constants.",
      "patterns": [
        {
          "match": "\\b(True|False)\\b",
          "name": "constant.language.boolean.scrl"
        },
        {
          "match": "\\bNil\\b",
          "name": "constant.language.nil.scrl"
        }
      ]
    },
    "constructor-call": {
      "captures": {
        "1": {
          "name": "entity.name.function.constructor.scrl"
        }
      },
      "comment": "Constructor invocation / pattern: Uppercase optionally followed by (",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "field-decl": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "variable.other.member.scrl"
            },
            "2": {
              "name": "entity.name.type.scrl"
            }
          },
          "comment": "Field label + concrete type",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.other.member.scrl"
            },
            "2": {
              "name": "variable.other.type.scrl"
            }
          },
          "comment": "Field label + type parameter",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([a-z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.scrl"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.scrl"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "function-call": {
      "captures": {
        "1": {
          "name": "entity.name.function.scrl"
        }
      },
      "comment": "Function calls",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "function-definition": {
      "begin": "\\b(pub\\s+)?(fn)\\s+([a-z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.visibility.scrl"
        },
        "2": {
          "name": "keyword.other.fn.scrl"
        },
        "3": {
          "name": "entity.name.function.scrl"
        }
      },
      "end": "(?=\\{|\\n|$)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#function-params"
        },
        {
          "include": "#type-args"
        },
        {
          "match": "\\bfn\\b",
          "name": "keyword.other.fn.scrl"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.scrl"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.type.scrl"
        }
      ]
    },
    "function-params": {
      "begin": "\\G\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.parameters.begin.scrl"
        }
      },
      "comment": "The param list opens immediately after the function name (\\G) and closes at the matching paren. Nested type-argument parens are consumed by #type-args so the inner ) of e.g. Option(a) cannot end the list early.",
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.scrl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-args"
        },
        {
          "captures": {
            "1": {
              "name": "variable.parameter.scrl"
            },
            "2": {
              "name": "entity.name.type.scrl"
            }
          },
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.parameter.scrl"
            },
            "2": {
              "name": "keyword.other.fn.scrl"
            }
          },
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+(fn)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.parameter.scrl"
            },
            "2": {
              "name": "variable.other.type.scrl"
            }
          },
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([a-z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.parameter.scrl"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.scrl"
        }
      ]
    },
    "generic-params": {
      "begin": "(?<=\\()",
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.scrl"
        }
      },
      "patterns": [
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.type.scrl"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.scrl"
        }
      ]
    },
    "import-statement": {
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.scrl"
        }
      },
      "end": "(?=$|\\n)",
      "patterns": [
        {
          "match": "\\b(as)\\b",
          "name": "keyword.control.import.scrl"
        },
        {
          "match": "/",
          "name": "punctuation.separator.path.scrl"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.scrl"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "entity.name.namespace.scrl"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.scrl"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "interpolation-expression": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#binary"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#module-qualified-access"
        },
        {
          "include": "#constructor-call"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#labeled-argument"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.scrl"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(in|match|if|else|or)\\b",
          "name": "keyword.control.scrl"
        },
        {
          "comment": "Contextual: a keyword after an if condition, a name after a dot.",
          "match": "(?<!\\.)\\bthen\\b",
          "name": "keyword.control.scrl"
        },
        {
          "match": "\\b(import|as)\\b",
          "name": "keyword.control.import.scrl"
        },
        {
          "match": "\\b(pub|opaque)\\b",
          "name": "storage.modifier.visibility.scrl"
        },
        {
          "match": "\\b(fn|type|const)\\b",
          "name": "keyword.other.scrl"
        }
      ]
    },
    "labeled-argument": {
      "captures": {
        "1": {
          "name": "variable.parameter.label.scrl"
        },
        "2": {
          "name": "punctuation.separator.colon.scrl"
        }
      },
      "comment": "Labeled call argument: label: value",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(:)"
    },
    "module-qualified-access": {
      "captures": {
        "1": {
          "name": "entity.name.namespace.scrl"
        },
        "2": {
          "name": "punctuation.accessor.scrl"
        }
      },
      "comment": "module.name access (lowercase qualifier)",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)(\\.)(?=[A-Za-z_])"
    },
    "numbers": {
      "comment": "Scanner::scan_number. Hex (`0x`) and binary (`0b`) first so they are not split into `0` + identifier. `_` is a digit separator only between two digits of that radix.",
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f]+(?:_[0-9A-Fa-f]+)*\\b",
          "name": "constant.numeric.hex.scrl"
        },
        {
          "match": "\\b0[bB][01]+(?:_[01]+)*\\b",
          "name": "constant.numeric.binary.scrl"
        },
        {
          "match": "\\b\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*\\b",
          "name": "constant.numeric.float.scrl"
        },
        {
          "match": "\\b\\d+(?:_\\d+)*\\b",
          "name": "constant.numeric.integer.scrl"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\+\\+|--|;|\\?)",
          "name": "invalid.illegal.unsupported-operator.scrl"
        },
        {
          "match": "(->)",
          "name": "keyword.operator.arrow.scrl"
        },
        {
          "match": "(<-)",
          "name": "keyword.operator.backpass.scrl"
        },
        {
          "match": "(\\.\\.)",
          "name": "keyword.operator.spread.scrl"
        },
        {
          "match": "(!=|<=|==|>=|<|>)",
          "name": "keyword.operator.comparison.scrl"
        },
        {
          "match": "(&&|\\|\\||!)",
          "name": "keyword.operator.logical.scrl"
        },
        {
          "match": "(\\|>)",
          "name": "keyword.operator.pipe.scrl"
        },
        {
          "match": "(\\|)",
          "name": "keyword.operator.pattern.scrl"
        },
        {
          "match": "(%|\\*|\\+|-|\\/)",
          "name": "keyword.operator.arithmetic.scrl"
        },
        {
          "match": "(=)",
          "name": "keyword.operator.assignment.scrl"
        },
        {
          "match": "(@)",
          "name": "keyword.operator.attribute.scrl"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.scrl"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.scrl"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.scrl"
        },
        {
          "match": "\\(",
          "name": "punctuation.section.parens.begin.scrl"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.parens.end.scrl"
        },
        {
          "match": "\\{",
          "name": "punctuation.section.braces.begin.scrl"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.braces.end.scrl"
        },
        {
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.scrl"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.scrl"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.scrl",
          "patterns": [
            {
              "match": "\\\\[ntr0\"'\\\\$]",
              "name": "constant.character.escape.scrl"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.scrl"
            },
            {
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.scrl"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.scrl"
                }
              },
              "name": "meta.interpolation.scrl",
              "patterns": [
                {
                  "include": "#interpolation-expression"
                }
              ]
            },
            {
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
              "name": "variable.other.interpolation.scrl"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.scrl",
          "patterns": [
            {
              "match": "\\\\[ntr0\"'\\\\$]",
              "name": "constant.character.escape.scrl"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.scrl"
            },
            {
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.scrl"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.scrl"
                }
              },
              "name": "meta.interpolation.scrl",
              "patterns": [
                {
                  "include": "#interpolation-expression"
                }
              ]
            },
            {
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
              "name": "variable.other.interpolation.scrl"
            }
          ]
        }
      ]
    },
    "type-args": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.begin.scrl"
        }
      },
      "comment": "Balanced ( ... ) for a parametrized/fn type. Recursive so Option(List(a)) and Result(a, e) nest correctly.",
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.scrl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\bfn\\b",
          "name": "keyword.other.fn.scrl"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.scrl"
        },
        {
          "include": "#type-args"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.type.scrl"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.scrl"
        }
      ]
    },
    "type-body": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.type.begin.scrl"
        }
      },
      "end": "(?=\\})",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.constructor.scrl"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.scrl"
            }
          },
          "comment": "Constructor with payload: Ctor(label Type, ...)",
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.scrl"
            }
          },
          "patterns": [
            {
              "include": "#field-decl"
            }
          ]
        },
        {
          "comment": "Nullary constructor",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.function.constructor.scrl"
        },
        {
          "include": "#field-decl"
        }
      ]
    },
    "type-definition": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "storage.modifier.visibility.scrl"
            },
            "2": {
              "name": "storage.modifier.visibility.scrl"
            },
            "3": {
              "name": "keyword.other.type.scrl"
            },
            "4": {
              "name": "entity.name.type.scrl"
            },
            "5": {
              "patterns": [
                {
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
                  "name": "variable.other.type.scrl"
                }
              ]
            },
            "6": {
              "name": "keyword.operator.assignment.scrl"
            }
          },
          "comment": "type alias: type Name(params) = Type",
          "match": "\\b(pub\\s+)?(opaque\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*\\(([^)]*)\\))?\\s*(=)"
        },
        {
          "captures": {
            "1": {
              "name": "storage.modifier.visibility.scrl"
            },
            "2": {
              "name": "storage.modifier.visibility.scrl"
            },
            "3": {
              "name": "keyword.other.type.scrl"
            },
            "4": {
              "name": "entity.name.type.scrl"
            },
            "5": {
              "patterns": [
                {
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
                  "name": "variable.other.type.scrl"
                }
              ]
            }
          },
          "comment": "external type: type Name(params) with no body, ends at EOL",
          "match": "\\b(pub\\s+)?(opaque\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*\\(([^)]*)\\))?\\s*$"
        },
        {
          "begin": "\\b(pub\\s+)?(opaque\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(\\())?",
          "beginCaptures": {

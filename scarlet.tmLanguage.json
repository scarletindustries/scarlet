{
  "name": "Scarlet",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#binary"
    },
    {
      "include": "#import-statement"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#const-definition"
    },
    {
      "include": "#variable-with-type"
    },
    {
      "include": "#backpass-binding"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#module-qualified-access"
    },
    {
      "include": "#constructor-call"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#labeled-argument"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.sca"
            },
            "2": {
              "name": "entity.name.function.decorator.sca"
            },
            "3": {
              "name": "punctuation.brackets.round.sca"
            },
            "4": {
              "name": "string.unquoted.attribute.sca"
            },
            "5": {
              "name": "punctuation.brackets.round.sca"
            }
          },
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)(\\()?([a-zA-Z_][a-zA-Z0-9_]*)?(\\))?",
          "name": "meta.attribute.sca"
        }
      ]
    },
    "backpass-binding": {
      "captures": {
        "1": {
          "patterns": [
            {
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
              "name": "variable.other.sca"
            }
          ]
        },
        "2": {
          "name": "keyword.operator.backpass.sca"
        }
      },
      "comment": "Backpass statement: binder(s) <- call(...)",
      "match": "\\b([a-z_][a-zA-Z0-9_]*(?:\\s*,\\s*[a-z_][a-zA-Z0-9_]*)*)\\s*(<-)"
    },
    "binary": {
      "begin": "<<",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.binary.begin.sca"
        }
      },
      "comment": "A bit-string literal or pattern, like <<expr:spec, ..rest>>. The spec names are contextual identifiers, not keywords.",
      "end": ">>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.binary.end.sca"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "captures": {
            "1": {
              "name": "punctuation.separator.colon.sca"
            },
            "2": {
              "name": "storage.type.binary-spec.sca"
            }
          },
          "match": "(:)\\s*(size|bytes)(?=\\s*\\()"
        },
        {
          "captures": {
            "1": {
              "name": "punctuation.separator.colon.sca"
            },
            "2": {
              "name": "storage.type.binary-spec.sca"
            }
          },
          "match": "(:)\\s*(binary|utf8)\\b"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.spread.sca"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#module-qualified-access"
        },
        {
          "include": "#constructor-call"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.sca"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.sca"
        },
        {
          "begin": "/\\*\\*(?!/)",
          "comment": "`/**` opens a doc comment, but `/**/` does not.",
          "end": "\\*/",
          "name": "comment.block.documentation.sca"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.sca"
        }
      ]
    },
    "const-definition": {
      "captures": {
        "1": {
          "name": "storage.modifier.visibility.sca"
        },
        "2": {
          "name": "keyword.other.const.sca"
        },
        "3": {
          "name": "entity.name.function.sca"
        },
        "4": {
          "name": "entity.name.type.sca"
        },
        "5": {
          "name": "keyword.operator.assignment.sca"
        }
      },
      "comment": "The declared name gets the same scope as a fn name, so themes colour every top-level value declaration the same way.",
      "match": "\\b(pub\\s+)?(const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:([A-Z][a-zA-Z0-9_]*)\\s*)?(=)"
    },
    "constants": {
      "comment": "Prelude constructors that themes expect to see as language constants.",
      "patterns": [
        {
          "match": "\\b(True|False)\\b",
          "name": "constant.language.boolean.sca"
        },
        {
          "match": "\\bNil\\b",
          "name": "constant.language.nil.sca"
        }
      ]
    },
    "constructor-call": {
      "captures": {
        "1": {
          "name": "entity.name.function.constructor.sca"
        }
      },
      "comment": "Constructor call or pattern: an uppercase name followed by (",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "field-decl": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "variable.other.member.sca"
            },
            "2": {
              "name": "entity.name.type.sca"
            }
          },
          "comment": "Field label + concrete type",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.other.member.sca"
            },
            "2": {
              "name": "variable.other.type.sca"
            }
          },
          "comment": "Field label + type parameter",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([a-z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.sca"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.sca"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "function-call": {
      "captures": {
        "1": {
          "name": "entity.name.function.sca"
        }
      },
      "comment": "Function calls",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "function-definition": {
      "begin": "\\b(pub\\s+)?(fn)\\s+([a-z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.visibility.sca"
        },
        "2": {
          "name": "keyword.other.fn.sca"
        },
        "3": {
          "name": "entity.name.function.sca"
        }
      },
      "end": "(?=\\{|\\n|$)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#function-params"
        },
        {
          "include": "#type-args"
        },
        {
          "match": "\\bfn\\b",
          "name": "keyword.other.fn.sca"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.sca"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.type.sca"
        }
      ]
    },
    "function-params": {
      "begin": "\\G\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.parameters.begin.sca"
        }
      },
      "comment": "The parameter list opens right after the function name (\\G) and closes at the matching paren. #type-args takes nested type-argument parens, so the inner ) of Option(a) can't end the list early.",
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.sca"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-args"
        },
        {
          "captures": {
            "1": {
              "name": "variable.parameter.sca"
            },
            "2": {
              "name": "entity.name.type.sca"
            }
          },
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.parameter.sca"
            },
            "2": {
              "name": "keyword.other.fn.sca"
            }
          },
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+(fn)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.parameter.sca"
            },
            "2": {
              "name": "variable.other.type.sca"
            }
          },
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([a-z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.parameter.sca"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.sca"
        }
      ]
    },
    "generic-params": {
      "begin": "(?<=\\()",
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.sca"
        }
      },
      "patterns": [
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.type.sca"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.sca"
        }
      ]
    },
    "import-statement": {
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.sca"
        }
      },
      "end": "(?=$|\\n)",
      "patterns": [
        {
          "match": "\\b(as)\\b",
          "name": "keyword.control.import.sca"
        },
        {
          "match": "/",
          "name": "punctuation.separator.path.sca"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.sca"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "entity.name.namespace.sca"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.sca"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "interpolation-expression": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#binary"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#module-qualified-access"
        },
        {
          "include": "#constructor-call"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#labeled-argument"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.sca"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(in|match|if|else|or)\\b",
          "name": "keyword.control.sca"
        },
        {
          "comment": "`then` is contextual. It's a keyword after an if condition and a name after a dot.",
          "match": "(?<!\\.)\\bthen\\b",
          "name": "keyword.control.sca"
        },
        {
          "match": "\\b(import|as)\\b",
          "name": "keyword.control.import.sca"
        },
        {
          "match": "\\b(pub|opaque)\\b",
          "name": "storage.modifier.visibility.sca"
        },
        {
          "match": "\\b(fn|type|const)\\b",
          "name": "keyword.other.sca"
        }
      ]
    },
    "labeled-argument": {
      "captures": {
        "1": {
          "name": "variable.parameter.label.sca"
        },
        "2": {
          "name": "punctuation.separator.colon.sca"
        }
      },
      "comment": "Labelled call argument: label: value",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(:)(?!:)"
    },
    "module-qualified-access": {
      "captures": {
        "1": {
          "name": "entity.name.namespace.sca"
        },
        "2": {
          "name": "punctuation.accessor.module.sca"
        }
      },
      "comment": "module::name access",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)(::)(?=[A-Za-z_])"
    },
    "numbers": {
      "comment": "Mirrors Scanner::scan_number. Hex (`0x`) and binary (`0b`) come first so they aren't split into `0` and an identifier. `_` separates digits only when it sits between two digits of that radix.",
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f]+(?:_[0-9A-Fa-f]+)*\\b",
          "name": "constant.numeric.hex.sca"
        },
        {
          "match": "\\b0[bB][01]+(?:_[01]+)*\\b",
          "name": "constant.numeric.binary.sca"
        },
        {
          "match": "\\b\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*\\b",
          "name": "constant.numeric.float.sca"
        },
        {
          "match": "\\b\\d+(?:_\\d+)*\\b",
          "name": "constant.numeric.integer.sca"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\+\\+|--|;|\\?)",
          "name": "invalid.illegal.unsupported-operator.sca"
        },
        {
          "match": "(->)",
          "name": "keyword.operator.arrow.sca"
        },
        {
          "match": "(<-)",
          "name": "keyword.operator.backpass.sca"
        },
        {
          "match": "(\\.\\.)",
          "name": "keyword.operator.spread.sca"
        },
        {
          "match": "(!=|<=|==|>=|<|>)",
          "name": "keyword.operator.comparison.sca"
        },
        {
          "match": "(&&|\\|\\||!)",
          "name": "keyword.operator.logical.sca"
        },
        {
          "match": "(\\|>)",
          "name": "keyword.operator.pipe.sca"
        },
        {
          "match": "(\\|)",
          "name": "keyword.operator.pattern.sca"
        },
        {
          "match": "(%|\\*|\\+|-|\\/)",
          "name": "keyword.operator.arithmetic.sca"
        },
        {
          "match": "(=)",
          "name": "keyword.operator.assignment.sca"
        },
        {
          "match": "(@)",
          "name": "keyword.operator.attribute.sca"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.sca"
        },
        {
          "match": "::",
          "name": "punctuation.accessor.module.sca"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.sca"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.sca"
        },
        {
          "match": "\\(",
          "name": "punctuation.section.parens.begin.sca"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.parens.end.sca"
        },
        {
          "match": "\\{",
          "name": "punctuation.section.braces.begin.sca"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.braces.end.sca"
        },
        {
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.sca"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.sca"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.sca",
          "patterns": [
            {
              "match": "\\\\[ntr0\"'\\\\$]",
              "name": "constant.character.escape.sca"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.sca"
            },
            {
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.sca"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.sca"
                }
              },
              "name": "meta.interpolation.sca",
              "patterns": [
                {
                  "include": "#interpolation-expression"
                }
              ]
            },
            {
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
              "name": "variable.other.interpolation.sca"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.sca",
          "patterns": [
            {
              "match": "\\\\[ntr0\"'\\\\$]",
              "name": "constant.character.escape.sca"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.sca"
            },
            {
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.sca"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.sca"
                }
              },
              "name": "meta.interpolation.sca",
              "patterns": [
                {
                  "include": "#interpolation-expression"
                }
              ]
            },
            {
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
              "name": "variable.other.interpolation.sca"
            }
          ]
        }
      ]
    },
    "type-args": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.begin.sca"
        }
      },
      "comment": "Balanced ( ... ) for a parameterised type or a fn type. It includes itself, so Option(List(a)) and Result(a, e) nest correctly.",
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.sca"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\bfn\\b",
          "name": "keyword.other.fn.sca"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.sca"
        },
        {
          "include": "#type-args"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.type.sca"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.sca"
        }
      ]
    },
    "type-body": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.type.begin.sca"
        }
      },
      "end": "(?=\\})",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.constructor.sca"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.sca"
            }
          },
          "comment": "Constructor with payload: Ctor(label Type, ...)",
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.sca"
            }
          },
          "patterns": [
            {
              "include": "#field-decl"
            }
          ]
        },
        {
          "comment": "Nullary constructor",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.function.constructor.sca"
        },
        {
          "include": "#field-decl"
        }
      ]
    },
    "type-definition": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "storage.modifier.visibility.sca"
            },
            "2": {
              "name": "storage.modifier.visibility.sca"
            },
            "3": {
              "name": "keyword.other.type.sca"
            },
            "4": {
              "name": "entity.name.type.sca"
            },
            "5": {
              "patterns": [
                {
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
                  "name": "variable.other.type.sca"
                }
              ]
            },
            "6": {
              "name": "keyword.operator.assignment.sca"
            }
          },
          "comment": "type alias: type Name(params) = Type",
          "match": "\\b(pub\\s+)?(opaque\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*\\(([^)]*)\\))?\\s*(=)"
        },
        {
          "captures": {
            "1": {
              "name": "storage.modifier.visibility.sca"
            },
            "2": {
              "name": "storage.modifier.visibility.sca"
            },
            "3": {
              "name": "keyword.other.type.sca"
            },
            "4": {
              "name": "entity.name.type.sca"
            },
            "5": {
              "patterns": [
                {
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
                  "name": "variable.other.type.sca"
                }
              ]
            }
          },
          "comment": "external type: type Name(params) with no body, ends at EOL",
          "match": "\\b(pub\\s+)?(opaque\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*\\(([^)]*)\\))?\\s*$"
        },
        {

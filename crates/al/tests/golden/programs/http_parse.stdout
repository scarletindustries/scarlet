== header values survive zero-copy ==
host (lower lookup): example.com
cookie (upper lookup): a=1; b=2
x-missing: missing
has x-custom: True

== header mutation ==
before: [Host=a, Set-Cookie=x=1, host=b]
set HOST=z (dedups, keeps casing): [Host=z, Set-Cookie=x=1]
set absent appends: [Host=a, Set-Cookie=x=1, host=b, X-New=1]
delete host (case-insensitive, all): [Set-Cookie=x=1]
delete absent is identity: [Host=a, Set-Cookie=x=1, host=b]
append keeps duplicates in order: [Host=a, Set-Cookie=x=1, host=b, Set-Cookie=y=2]
render parts: ["Host", ": ", "a", "\r\n", "Set-Cookie", ": ", "x=1", "\r\n", "host", ": ", "b", "\r\n"]
render of empty: []

== header validation ==
plain field: Ok "X-Ok"="value"
full token charset name: Ok "X-Ok!#$%*+-.^_|~"="v"
empty value is fine: Ok "X-Ok"=""
space in name: Err BadName "X Bad"
colon in name: Err BadName "X:Bad"
empty name: Err BadName ""
cr in value: Err BadValue "a\rb"
lf in value: Err BadValue "a\nb"
nul in value: Err BadValue "a\0b"
valid: empty list: True
valid: token name + clean value: True
invalid: colon in name: False
invalid: lf in value: False
invalid: one bad field among good: False


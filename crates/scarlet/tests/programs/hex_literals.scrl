// Hex (`0x`) and binary (`0b`) integer literals.
//
// Both are magnitudes in that radix, not two's-complement bit patterns:
// `0xFF` is 255, and `0xFFFFFFFFFFFFFFFF` is out of range, not -1. Prefix
// case and hex-digit case are insignificant. `_` may sit between two digits
// of that radix, the same rule as decimal. There is no octal prefix: `08`
// is decimal 8. Hex/bin floats are not a thing: `0xFF.5` is `0xFF` then `.5`.
//
// Range is i64, same as decimal:
//   0x7FFFFFFFFFFFFFFF == int.max_value            (ok)
//   0x8000000000000000                             (compile error: out of range)
//   9223372036854775808                            (same error, decimal)
// i64::MIN cannot be written as a positive-magnitude literal in any base.
// As a match-pattern the parser glues a leading `-` onto the token, so
// `-9223372036854775808` and `-0x8000000000000000` both parse as min_value;
// as an expression the unary minus is applied after the magnitude is
// checked, so `-0x8000000000000000` is still an overflow.

import scarlet/int

fn ok(b Bool) String {
	if b { 'PASS' } else { 'FAIL' }
}

pub fn main() {
	println('hex: ${0xFF} ${0xff} ${0X10}')
	println('bin: ${0b1010} ${0B11} ${0b0}')
	println('sep: ${0xDE_AD_BE_EF} ${0b1111_0000}')
	println('eq: ${ok(0xFF == 255)} ${ok(0b1111 == 15)} ${ok(0xDE_AD_BE_EF == 3735928559)}')
	println('neg: ${-0xFF} ${ok(-0xFF == -255)} ${ok(-0b1010 == -10)}')
	println(
		'max: ${ok(
			0x7FFFFFFFFFFFFFFF == int.max_value,
		)} ${ok(0x7FFF_FFFF_FFFF_FFFF == 9223372036854775807)}',
	)

	// 2^47 is the first boxed Int; a hex spelling must not notice.
	boxed = 0x800000000000
	println('boxed: ${boxed} ${ok(boxed == 140737488355328)} ${ok(boxed - 1 == 0x7FFFFFFFFFFF)}')

	println(
		'match: ${match 255 {
			0xFF -> 'hex'
			_ -> 'no'
		}} ${match -255 {
			-0xFF -> 'neg'
			_ -> 'no'
		}} ${match 10 {
			0b1010 -> 'bin'
			_ -> 'no'
		}}',
	)
	println(
		'min pattern: ${match int.min_value {
			-0x8000000000000000 -> 'min'
			_ -> 'no'
		}}',
	)

	// The WebSocket masking key the bitwise suite had to write as 3735928559.
	key = 0xDEADBEEF
	mask_byte = int.bitwise_and(int.bitwise_shift_right(key, 24), 0xFF)
	println('ws: ${key} ${mask_byte} ${ok(mask_byte == 0xDE)}')
}

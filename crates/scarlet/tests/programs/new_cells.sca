type Tree {
	Leaf
	Node(l Tree, n Int, r Tree)
}

type List {
	End
	Cons(h String, t List)
}

// For each width: every field taken, every field read again after, one value in
// every field, and some fields taken, some shared and some the program's own.

fn taken1(s String) R1 {
	R1("${s}0")
}

fn shared1(s String, t String) (R1, Int) {
	r = R1(s)
	(r, string::length(s) + string::length(t))
}

fn same1(s String) R1 {
	R1(s)
}

fn mixed1(s String) (R1, Int) {
	r = R1("own")
	(r, string::length(s))
}

fn over1(s String) fn(String) String {
	c0 = "${s}0"
	fn(x) x + c0
}

fn changed1(r R1) R1 {
	R1(..r, f0: "changed")
}

fn taken2(s String) R2 {
	R2("${s}0", "${s}1")
}

fn shared2(s String, t String) (R2, Int) {
	r = R2(s, t)
	(r, string::length(s) + string::length(t))
}

fn same2(s String) R2 {
	R2(s, s)
}

fn mixed2(s String) (R2, Int) {
	r = R2("own", s)
	(r, string::length(s))
}

fn turned2(r R2) R2 {
	match r {
		R2(a0, a1) -> R2(a1, a0)
	}
}

fn tuple2(s String) (String, Int) {
	("${s}0", 1)
}

fn twice2(s String) (String, String) {
	(s, s)
}

fn over2(s String) fn(String) String {
	c0 = "${s}0"
	c1 = "${s}1"
	fn(x) x + c0 + c1
}

fn changed2(r R2) R2 {
	R2(..r, f1: "changed")
}


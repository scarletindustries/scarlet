fn over20(s String) fn(String) String {
	c0 = "${s}0"
	c1 = "${s}1"
	c2 = "${s}2"
	c3 = "${s}3"
	c4 = "${s}4"
	c5 = "${s}5"
	c6 = "${s}6"
	c7 = "${s}7"
	c8 = "${s}8"
	c9 = "${s}9"
	c10 = "${s}10"
	c11 = "${s}11"
	c12 = "${s}12"
	c13 = "${s}13"
	c14 = "${s}14"
	c15 = "${s}15"
	c16 = "${s}16"
	c17 = "${s}17"
	c18 = "${s}18"
	c19 = "${s}19"
	fn(x) x +
		c0 +
		c1 +
		c2 +
		c3 +
		c4 +
		c5 +
		c6 +
		c7 +
		c8 +
		c9 +

	R20(..r, f19: "changed")
}

fn tree(n Int) Tree {
	if n == 0 {
		Leaf
	} else {
		Node(tree(n - 1), n, tree(n - 1))
	}
}

fn sum(t Tree) Int {
	match t {
		Leaf -> 0
		Node(l, n, r) -> sum(l) + n + sum(r)
	}
}

fn grown(n Int, acc List) List {
	if n == 0 {
		acc
	} else {
		grown(n - 1, Cons("${n}", acc))
	}
}

fn length(l List, n Int) Int {
	match l {
		End -> n
		Cons(_, t) -> length(t, n + 1)
	}
}

// Each turn gives a cell up, and the next turn takes it.
fn spin(n Int, acc Int) Int {
	if n == 0 {
		acc
	} else {
		r = R3("${n}", "b", "c")
		spin(n - 1, acc + string::length(r.f0))
	}
}

// Each closure holds the one before.
fn chain(n Int, f fn(Int) Int) fn(Int) Int {
	if n == 0 {
		f
	} else {
		chain(n - 1, fn(x) f(x + n))
	}
}


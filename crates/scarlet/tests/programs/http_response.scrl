// The HTTP CLIENT contract: response-head parsing, response body framing, URL
// parsing, and the whole request/response path driven over a transport that is
// not a socket.
//
// The last part is the point. `scarlet/http/client` is parameterised over its
// transport (an `Io` of three closures) precisely so the request bytes it
// writes and the response bytes it reads can both be a Binary held by a
// process in this file — no listener, no bind(2), no timing. What is asserted
// here is therefore the CLIENT's behaviour, not the network's.
//
// Every malformed case below is asserted to be REPORTED. A parser that returns
// a default on bad input passes "it did not crash", so a truncated status
// line, a header with no colon, a body shorter than Content-Length and a
// chunked body that lies about its size each have a named error here, and the
// happy case next to it proves the same code path can also succeed.

import scarlet/array
import scarlet/binary
import scarlet/http/client
import scarlet/http/h1
import scarlet/http/headers
import scarlet/int
import scarlet/http/url
import scarlet/net/socket
import scarlet/process
import scarlet/result
import scarlet/string

fn str(b Binary) String {
	binary.to_string(b) or '<not utf8>'
}

// Control bytes escaped so a CRLF-bearing blob stays on ONE golden line.
fn vis(b Binary) String {
	vis_from(b, 0, binary.byte_size(b), '')
}

fn vis_from(b Binary, i Int, len Int, acc String) String {
	if i >= len {
		acc
	} else {
		piece = match binary.byte_at(b, i) {
			13 -> '\\r'
			10 -> '\\n'
			9 -> '\\t'
			0 -> '\\0'
			_ -> result.then(binary.slice_bytes(b, i, 1), binary.to_string) or '?'
		}
		vis_from(b, i + 1, len, '${acc}${piece}')
	}
}

fn q(b Binary) String {
	'"${vis(b)}"'
}

fn list(parts Array(String)) String {
	match parts {
		[] -> '[]'
		[head, ..rest] -> '[${array.fold(rest, head, fn(acc, p) '${acc}, ${p}')}]'
	}
}

fn grow(b Binary, n Int) Binary {
	if binary.byte_size(b) >= n {
		b
	} else {
		grow(binary.append(b, b), n)
	}
}

// ---------------------------------------------------------------------------
// 1. h1.parse_response
// ---------------------------------------------------------------------------

fn show_response(label String, input Binary) Nil {
	out = match h1.parse_response(input, 0) {
		h1.ResponseDone(version, code, reason, hdrs, _, consumed) ->
			'Done version=${version} code=${code} reason=${q(
				reason,
			)} headers=${array.length(hdrs)} consumed=${consumed}'
		h1.ResponseNeedMore -> 'NeedMore'
		h1.ResponseBad(err) -> 'Bad ${err}'
	}
	println('${label}: ${out}')
}

// ---------------------------------------------------------------------------
// 2. h1.response_framing — where a response is NOT a request
// ---------------------------------------------------------------------------

fn show_response_framing(label String, code Int, input Binary) Nil {
	out = match h1.parse_response(input, 0) {
		h1.ResponseDone(_, _, _, hdrs, _, _) -> match h1.response_framing(hdrs, code) {
			h1.BodyNone -> 'BodyNone'
			h1.BodyLength(n) -> 'BodyLength ${n}'
			h1.BodyChunked -> 'BodyChunked'
			h1.BodyUntilClose -> 'BodyUntilClose'
			h1.BodyInvalid(err) -> 'BodyInvalid ${err}'
		}
		h1.ResponseNeedMore -> 'parse: NeedMore'
		h1.ResponseBad(err) -> 'parse: Bad ${err}'
	}
	println('${label}: ${out}')
}

// ---------------------------------------------------------------------------
// 3. scarlet/http/url
// ---------------------------------------------------------------------------

fn show_url(text String) Nil {
	out = match url.parse(text) {
		Ok(u) ->
			'${u.scheme} host=${u.host} port=${u.port} target=${q(u.target)} host-field=${q(
				url.authority(u),
			)}'
		Err(e) -> 'Err ${string.inspect(e)}'
	}
	println('${text} -> ${out}')
}

// ---------------------------------------------------------------------------
// 4. The client, over a transport that is not a socket
// ---------------------------------------------------------------------------

// What the scripted transport is asked to do. A process owns the script and
// the write log, which is the mutable cell Scarlet does not otherwise have —
// and it is deterministic here because exactly one client talks to it, in
// lockstep.
type Wire {
	// Hand back up to `max` more scripted bytes, or Closed once spent.
	Want(max Int, reply process.Subject(socket.Read))
	// Record bytes the client wrote.
	Wrote(bytes Binary)
	// Answer everything written so far.
	Dump(reply process.Subject(Binary))
	// End the process, and say so. Acknowledged rather than fire-and-forget:
	// a parked process keeps the whole program alive (the same trap
	// `examples/sockets.scrl` documents for an unclosed listener), so the
	// exchange must not finish until this one has actually gone.
	Stop(reply process.Subject(Nil))
}

fn wire_loop(inbox process.Subject(Wire), script Binary, written Binary) Nil {
	match process.receive(inbox) {
		Want(max, reply) -> {
			n = int.min(max, binary.byte_size(script))
			if n <= 0 {
				process.send(reply, socket.Closed)
				wire_loop(inbox, script, written)
			} else {
				(chunk, rest) = binary.split_at_bytes(script, n)
				process.send(reply, socket.Data(chunk))
				wire_loop(inbox, rest, written)
			}
		}
		Wrote(bytes) -> wire_loop(inbox, script, binary.append(written, bytes))
		Dump(reply) -> {
			process.send(reply, written)
			wire_loop(inbox, script, written)
		}
		Stop(reply) -> process.send(reply, Nil)
	}
}

// Shut a scripted transport down and wait for it to be gone.
fn stop(inbox process.Subject(Wire)) Nil {
	reply = process.subject()
	process.send(inbox, Stop(reply))
	process.receive(reply)
}

// `chunk` bounds how much the transport hands over per read, so the client's
// incremental paths (NeedMore, partial bodies) are exercised rather than
// hidden behind one read that returns everything.
fn scripted(script Binary) process.Subject(Wire) {
	handshake = process.subject()
	_ = process.spawn(fn() {
		inbox = process.subject()
		process.send(handshake, inbox)
		wire_loop(inbox, script, <<>>)
	})
	inbox = process.receive(handshake)
	inbox
}

fn wire_io(inbox process.Subject(Wire), chunk Int) client.Io {
	client.Io(
		read: fn(max, _deadline) {
			reply = process.subject()
			process.send(inbox, Want(int.min(max, chunk), reply))
			Ok(process.receive(reply))
		},
		write: fn(bytes) {
			process.send(inbox, Wrote(bytes))
			Ok(Nil)
		},
		close: fn() Ok(Nil),
	)
}

fn show_exchange(label String, req_url String, method Binary, script Binary, chunk Int) Nil {
	match url.parse(req_url) {
		Err(e) -> println('${label}: url Err ${string.inspect(e)}')
		Ok(u) -> {
			inbox = scripted(script)
			io = wire_io(inbox, chunk)
			req = client.Request(method: method, url: u, headers: [], body: <<>>)
			out = match client.send(io, req) {
				Ok(r) ->
					'${r.status} reason=${q(r.reason)} headers=${array.length(
						r.headers,
					)} body=${q(r.body)}'
				Err(e) -> 'Err ${string.inspect(e)}'
			}
			stop(inbox)
			println('${label}: ${out}')
		}
	}
}

fn show_bounded(label String, script Binary, max_body Int) Nil {
	inbox = scripted(script)
	io = wire_io(inbox, 65536)
	u = url.parse('http://example.com/a') or url.Url(
		scheme: url.Http,
		host: 'x',
		port: 80,
		target: <<'/'>>,
	)
	req = client.Request(method: <<'GET'>>, url: u, headers: [], body: <<>>)
	out = match client.send_bounded(io, req, max_body) {
		Ok(r) -> '${r.status} body=${q(r.body)}'
		Err(e) -> 'Err ${string.inspect(e)}'
	}
	stop(inbox)
	println('${label}: ${out}')
}

// The request head is asserted as bytes: the routing point may not quietly
// change what goes on the wire.
fn show_written(label String, req_url String, method Binary, extra Array(headers.Header), body Binary) Nil {
	match url.parse(req_url) {
		Err(e) -> println('${label}: url Err ${string.inspect(e)}')
		Ok(u) -> {
			inbox = scripted(<<'HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n'>>)
			io = wire_io(inbox, 65536)
			req = client.Request(method: method, url: u, headers: extra, body: body)
			outcome = match client.send(io, req) {
				Ok(r) -> 'sent, got ${r.status}'
				Err(e) -> 'Err ${string.inspect(e)}'
			}
			reply = process.subject()
			process.send(inbox, Dump(reply))
			wrote = process.receive(reply)
			stop(inbox)
			println('${label}: ${outcome}')
			println('  wrote: ${q(wrote)}')
		}
	}
}

pub fn main() {
	println('== status line ==')
	show_response('minimal', <<'HTTP/1.1 200 OK\r\n\r\n'>>)
	show_response('http/1.0', <<'HTTP/1.0 404 Not Found\r\n\r\n'>>)
	// RFC 9112 §4 allows an empty reason phrase, and a client must ignore its
	// content either way. Both forms parse; neither is an error.
	show_response('empty reason after space', <<'HTTP/1.1 204 \r\n\r\n'>>)
	show_response('no reason and no space', <<'HTTP/1.1 204\r\n\r\n'>>)
	show_response('reason with spaces', <<'HTTP/1.1 418 I am a teapot\r\n\r\n'>>)

	println('')
	println('== status line rejects ==')
	// TRUNCATED, three ways. Only the first is recoverable: more bytes may still
	// arrive. The other two are complete lines that cannot be status lines, and
	// each is REPORTED rather than defaulted to 200.
	show_response('truncated mid-line (no CRLF yet)', <<'HTTP/1.1 20'>>)
	show_response('truncated: line ends before the code', <<'HTTP/1.1\r\n\r\n'>>)
	show_response('truncated: two-digit code', <<'HTTP/1.1 20\r\n\r\n'>>)
	show_response('code is not digits', <<'HTTP/1.1 2x0 OK\r\n\r\n'>>)
	show_response('no space after version', <<'HTTP/1.1_200 OK\r\n\r\n'>>)
	show_response('junk before the reason', <<'HTTP/1.1 200_OK\r\n\r\n'>>)
	show_response('not HTTP at all', <<'ICY 200 OK\r\n\r\n'>>)
	show_response('binary junk (a TLS record header)', <<22, 3, 1, 0, 100, 1, 0, 0, 96, 3, 3, 13, 10>>)
	// `HTTP/` and a version we do not speak is a DIFFERENT answer from "not
	// HTTP/1": one means retry with another protocol, the other means this peer is
	// not speaking HTTP/1 at all.
	show_response('http/2', <<'HTTP/2.0 200 OK\r\n\r\n'>>)
	show_response('http/0.9', <<'HTTP/0.9 200 OK\r\n\r\n'>>)
	// A bare LF inside the reason phrase would split the status line for anything
	// that re-serialized it.
	show_response('bare LF in reason', <<'HTTP/1.1 200 O\nK\r\n\r\n'>>)
	show_response('bare CR in reason', <<'HTTP/1.1 200 O\rK\r\n\r\n'>>)
	// The request parser tolerates leading CRLFs (RFC 7230 §3.5). The response
	// parser must not: a stray CRLF before a status line means the connection has
	// desynchronized.
	show_response('leading CRLF is NOT skipped', <<'\r\nHTTP/1.1 200 OK\r\n\r\n'>>)

	println('')
	println('== header block: the same grammar as a request head ==')
	show_response('two fields', <<'HTTP/1.1 200 OK\r\nContent-Length: 3\r\nX-A: b\r\n\r\nabc'>>)
	show_response('field with no colon', <<'HTTP/1.1 200 OK\r\nContent-Length 3\r\n\r\n'>>)
	show_response('space before colon', <<'HTTP/1.1 200 OK\r\nContent-Length : 3\r\n\r\n'>>)
	show_response('obs-fold continuation', <<'HTTP/1.1 200 OK\r\nX-A: b\r\n c\r\n\r\n'>>)
	show_response('empty field name', <<'HTTP/1.1 200 OK\r\n: b\r\n\r\n'>>)
	show_response('head not terminated', <<'HTTP/1.1 200 OK\r\nX-A: b\r\n'>>)
	// The 64 KiB head cap measures from the status line, exactly as a request
	// head's does from the request line.
	big = grow(<<'X-Pad: 0123456789012345678901234567890123456789012345678901234\r\n'>>, 70000)
	show_response('head over 64 KiB', binary.append(<<'HTTP/1.1 200 OK\r\n'>>, big))
	show_response('no CRLF anywhere, over cap', grow(<<'HTTP/1.1 200 OKKKKKKK'>>, 70000))

	println('')
	println('== consumed threads to the body ==')
	framed = <<'HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello-and-then-some'>>
	match h1.parse_response(framed, 0) {
		h1.ResponseDone(_, _, _, _, _, consumed) -> {
			// NOT an argued-unreachable arm. `5` is this case's advertised
			// Content-Length, so a `consumed` that does not thread to the body
			// is the exact failure this line exists to catch — it has to print
			// as an error rather than as an empty window.
			body = match binary.slice_bytes(framed, consumed, 5) {
				Ok(v) -> q(v)
				Err(Nil) -> 'OUT OF RANGE'
			}
			println('body starts at ${consumed}: ${body}')
		}
		other -> println('unexpected: ${other}')
	}

	println('')
	println('== response framing ==')
	// THE ASYMMETRY: no framing field means "no body" on a request and "until the
	// connection closes" on a response. Reusing h1.framing here would truncate
	// every close-framed reply to empty.
	show_response_framing('no framing fields -> until close', 200, <<'HTTP/1.1 200 OK\r\n\r\n'>>)
	show_response_framing('content-length', 200, <<'HTTP/1.1 200 OK\r\nContent-Length: 7\r\n\r\n'>>)
	show_response_framing(
		'chunked',
		200,
		<<'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n'>>,
	)
	// 1xx / 204 / 304 have no body whatever the fields claim.
	show_response_framing('204 with a content-length', 204, <<'HTTP/1.1 204 No Content\r\nContent-Length: 9\r\n\r\n'>>)
	show_response_framing('304 with a content-length', 304, <<'HTTP/1.1 304 Not Modified\r\nContent-Length: 9\r\n\r\n'>>)
	show_response_framing('100 continue', 100, <<'HTTP/1.1 100 Continue\r\n\r\n'>>)
	show_response_framing('199 is still 1xx', 199, <<'HTTP/1.1 199 Early\r\nContent-Length: 4\r\n\r\n'>>)
	show_response_framing('200 is not', 200, <<'HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n'>>)
	// The smuggling conflicts are rejected once, in h1.framing, for both
	// directions — a response cannot claim both framings either.
	show_response_framing(
		'content-length AND chunked',
		200,
		<<'HTTP/1.1 200 OK\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n'>>,
	)
	show_response_framing(
		'unknown transfer coding',
		200,
		<<'HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\n\r\n'>>,
	)
	show_response_framing(
		'two disagreeing content-lengths',
		200,
		<<'HTTP/1.1 200 OK\r\nContent-Length: 4\r\nContent-Length: 5\r\n\r\n'>>,
	)

	println('')
	println('== url ==')
	show_url('http://example.com')
	show_url('https://example.com')
	show_url('https://example.com/')
	show_url('http://example.com/a/b?q=1')
	show_url('http://example.com?q=1')
	show_url('http://example.com/a#frag')
	show_url('http://example.com/a?q=1#frag')
	show_url('http://example.com:8080/a')
	show_url('https://example.com:443/a')
	show_url('https://example.com:8443/a')
	show_url('HTTPS://Example.COM/a')
	show_url('http://[::1]:9000/a')
	show_url('http://[::1]/a')

	println('')
	println('== url rejects ==')
	show_url('/just/a/path')
	show_url('example.com/a')
	show_url('ftp://example.com/a')
	show_url('ws://example.com/a')
	show_url('http:///a')
	show_url('http://:8080/a')
	show_url('http://example.com:/a')
	show_url('http://example.com:0/a')
	show_url('http://example.com:65536/a')
	show_url('http://example.com:-1/a')
	show_url('http://example.com:80x/a')
	show_url('http://user:pw@example.com/a')
	show_url('http://[::1/a')
	show_url('http://[::1]x/a')

	println('')
	println('== client round trips (in-memory transport) ==')
	show_exchange(
		'content-length body',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello'>>,
		65536,
	)
	// One byte per read: every incremental path in the client runs.
	show_exchange(
		'content-length body, one byte per read',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello'>>,
		1,
	)
	show_exchange(
		'chunked body',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n'>>,
		3,
	)
	show_exchange(
		'close-framed body',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\n\r\nno framing fields here'>>,
		7,
	)
	// A HEAD response has a Content-Length and NO body. Reading one would consume
	// the next response off a reused connection.
	show_exchange(
		'HEAD: content-length but no body',
		'http://example.com/a',
		<<'HEAD'>>,
		<<'HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n'>>,
		65536,
	)
	show_exchange(
		'204 has no body whatever it says',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 204 No Content\r\nContent-Length: 5\r\n\r\n'>>,
		65536,
	)
	// An unsolicited interim response is dropped, not returned as the answer.
	show_exchange(
		'100 Continue before the real reply',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 201 Created\r\nContent-Length: 2\r\n\r\nhi'>>,
		65536,
	)
	show_exchange(
		'two interim responses',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi'>>,
		65536,
	)

	println('')
	println('== client round trips that must FAIL ==')
	// A body SHORTER than Content-Length. The peer closed with two of five bytes
	// delivered: reported, never returned as a two-byte body.
	show_exchange(
		'body shorter than content-length',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhe'>>,
		65536,
	)
	show_exchange(
		'peer closes mid-head',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nContent-Le'>>,
		65536,
	)
	show_exchange(
		'peer closes with nothing at all',
		'http://example.com/a',
		<<'GET'>>,
		<<>>,
		65536,
	)
	show_exchange(
		'malformed status line',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 2x0 OK\r\nContent-Length: 0\r\n\r\n'>>,
		65536,
	)
	show_exchange(
		'header with no colon',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nContent-Length 0\r\n\r\n'>>,
		65536,
	)
	show_exchange(
		'framing conflict',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nContent-Length: 2\r\nTransfer-Encoding: chunked\r\n\r\nhi'>>,
		65536,
	)
	show_exchange(
		'chunked body with a lying size',
		'http://example.com/a',
		<<'GET'>>,
		<<'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhelloTHISISNOTCRLF'>>,
		65536,
	)

	println('')
	println('== the body budget ==')

	// Refused on the ADVERTISED length, before a byte of the body is read.
	show_bounded(
		'content-length over budget',
		<<'HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\n'>>,
		10,
	)
	show_bounded(
		'content-length exactly at budget',
		<<'HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nabcd'>>,
		64,
	)
	// A close-framed body has no advertised length, so the budget stops the read.
	show_bounded(
		'close-framed body over budget',
		binary.append(<<'HTTP/1.1 200 OK\r\n\r\n'>>, grow(<<'padpadpa'>>, 200)),
		64,
	)

	println('')
	println('== what the client actually wrote ==')

	show_written('GET /', 'http://example.com/', <<'GET'>>, [], <<>>)
	show_written('GET with query and port', 'http://example.com:8080/a?q=1', <<'GET'>>, [], <<>>)
	show_written('GET https default port omits it', 'https://example.com/a', <<'GET'>>, [], <<>>)
	show_written('GET ipv6 host is bracketed', 'http://[::1]:9000/a', <<'GET'>>, [], <<>>)
	show_written(
		'POST with a body',
		'http://example.com/e',
		<<'POST'>>,
		[headers.Header(name: <<'Content-Type'>>, value: <<'text/plain'>>)],
		<<'hi'>>,
	)
	// A caller-set Content-Length is REPLACED, not duplicated: two disagreeing
	// Content-Length fields is the request-smuggling vector.
	show_written(
		'caller-set Content-Length is replaced',
		'http://example.com/e',
		<<'POST'>>,
		[headers.Header(name: <<'content-length'>>, value: <<'999'>>)],
		<<'hi'>>,
	)
	show_written(
		'caller-set Host is replaced',
		'http://example.com/e',
		<<'GET'>>,
		[headers.Header(name: <<'Host'>>, value: <<'evil.example'>>)],
		<<>>,
	)
	// A header value carrying CRLF would split the request head into two
	// requests at any proxy. Refused before the connection is even used.
	show_written(
		'CRLF in a header value is refused',
		'http://example.com/e',
		<<'GET'>>,
		[headers.Header(name: <<'X-A'>>, value: <<'b\r\nX-Injected: yes'>>)],
		<<>>,
	)
	show_written(
		'a header name that is not a token is refused',
		'http://example.com/e',
		<<'GET'>>,
		[headers.Header(name: <<'X A'>>, value: <<'b'>>)],
		<<>>,
	)

	println('')
	println('== url errors reach the client surface ==')
	match client.get('nonsense') {
		Ok(_) -> println('client.get of a non-URL: Ok?!')
		Err(e) -> println('client.get of a non-URL: Err ${string.inspect(e)}')
	}
	match client.get('ftp://example.com/a') {
		Ok(_) -> println('client.get of ftp: Ok?!')
		Err(e) -> println('client.get of ftp: Err ${string.inspect(e)}')
	}
}

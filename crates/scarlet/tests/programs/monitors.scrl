// Monitors: being told when a process ends. Every line here is sequenced by
// a receive, so the output is fixed even though the processes race; the one
// negative case (a released monitor stays silent) is a generous timeout.

import scarlet/process

fn check(name String, ok Bool) Nil {
	if ok {
		println('PASS ${name}')
	} else {
		println('FAIL ${name}')
	}
}

// A child that stays alive until released: its pid, and the subject that
// releases it. Only a subject's owner may receive on it, so the child makes
// the gate itself and hands it back.
fn parked() (process.Pid, process.Subject(Nil)) {
	boot = process.subject()
	pid = process.spawn(fn() {
		gate = process.subject()
		process.send(boot, gate)
		process.receive(gate)
	})
	(pid, process.receive(boot))
}

// --- the notice is wrapped into the receiver's own message type -----------------
// The supervisor pattern: one inbox carries ordinary traffic and down
// notices side by side, and the wrap closure tags each notice with whatever
// the receiver wants to know — here, which worker slot it was.

type Event {
	Work(n Int)
	WorkerDown(slot Int, down process.Down)
}

fn drain(inbox process.Subject(Event), worker process.Pid, work Int) Int {
	match process.receive(inbox) {
		Work(n) -> drain(inbox, worker, work + n)
		WorkerDown(slot, d) -> {
			check('down tagged with the slot', slot == 7)
			check('down carries the worker pid', d.pid == worker)
			work
		}
	}
}

// --- request/reply against a server that may be gone ------------------------------
// The reply and the down notice share the reply subject and its type, so a
// caller sees exactly one of them. The server here answers once and returns,
// so the second call finds it dead.

type Reply {
	Answer(n Int)
	ServerDown
}

fn call(server process.Subject(process.Subject(Reply)), server_pid process.Pid) Reply {
	reply = process.subject()
	m = process.monitor(server_pid, reply, fn(_) ServerDown)
	process.send(server, reply)
	answer = process.receive(reply)
	process.demonitor(m)
	answer
}

pub fn main() {
	// --- a notice arrives after the process ends -----------------------------------
	// The child is parked, so the monitor is certainly placed before it ends.
	// The notice is a message of the parent's own type: here, just the Down.

	downs = process.subject()
	(child, go) = parked()
	_ = process.monitor(child, downs, fn(d) d)
	process.send(go, Nil)
	first = process.receive(downs)
	check('down names the process', first.pid == child)
	check('a returned process ended normally', match first.reason {
		process.Normal -> True
		process.NoProcess -> False
		process.Killed -> False
		process.Crashed(_) -> False
	})

	// --- monitoring a process that has already ended fires at once -----------------
	// `ended` is sent as the child's last act, and the sleep lets it finish; the
	// monitor is then placed on a pid that no longer exists, and must fire rather
	// than wait for ever.

	ended = process.subject()
	gone = process.spawn(fn() process.send(ended, Nil))
	process.receive(ended)
	process.sleep(20)
	_ = process.monitor(gone, downs, fn(d) d)
	late = process.receive(downs)
	check('monitoring an ended pid still delivers', late.pid == gone)
	check('and reports that it was already gone', match late.reason {
		process.NoProcess -> True
		process.Normal -> False
		process.Killed -> False
		process.Crashed(_) -> False
	})

	events = process.subject()
	(worker, release) = parked()
	_ = process.monitor(worker, events, fn(d) WorkerDown(7, d))
	process.send(events, Work(1))
	process.send(events, Work(2))
	process.send(release, Nil)

	check('traffic before the down was seen first', drain(events, worker, 0) == 3)

	// --- two monitors, two notices ---------------------------------------------------

	(twice, hold) = parked()
	_ = process.monitor(twice, downs, fn(d) d)
	_ = process.monitor(twice, downs, fn(d) d)
	process.send(hold, Nil)
	a = process.receive(downs)
	b = process.receive(downs)
	check('each monitor delivers its own notice', a.pid == twice && b.pid == twice)

	// --- a released monitor stays silent ---------------------------------------------

	(quiet, hold2) = parked()
	m = process.monitor(quiet, downs, fn(d) d)
	process.demonitor(m)
	process.send(hold2, Nil)
	check('demonitor before the end delivers nothing', match process.receive_within(downs, 100) {
		Ok(_) -> False
		Err(Nil) -> True
	})

	boot = process.subject()
	server = process.spawn(fn() {
		requests = process.subject()
		process.send(boot, requests)
		process.send(process.receive(requests), Answer(42))
	})
	requests = process.receive(boot)
	check('a live server answers', match call(requests, server) {
		Answer(n) -> n == 42
		ServerDown -> False
	})
	check('a dead server is reported as down', match call(requests, server) {
		Answer(_) -> False
		ServerDown -> True
	})

	// --- a watcher that ends first takes its monitors with it ---------------------------
	// Nothing observable is delivered; what is pinned is that the target's later
	// end, and the program's exit, are clean. `watched` outlives its watcher.

	watcher_done = process.subject()
	(watched, let_go) = parked()
	_ = process.spawn(fn() {
		scratch = process.subject()
		_ = process.monitor(watched, scratch, fn(d) d)
		process.send(watcher_done, Nil)
	})
	process.receive(watcher_done)
	process.sleep(20)
	process.send(let_go, Nil)
	println('done')
}

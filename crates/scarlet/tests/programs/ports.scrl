// Ports: a child process as a stream. Everything here uses /bin/sh and cat,
// which every supported platform has, and every line is sequenced by a read
// or a close, so the output is fixed.

import scarlet/binary
import scarlet/io
import scarlet/map
import scarlet/net/error
import scarlet/net/socket
import scarlet/os/port
import scarlet/process
import scarlet/string

fn check(name String, ok Bool) Nil {
	if ok {
		println('PASS ${name}')
	} else {
		println('FAIL ${name}')
	}
}

// Read until the child closes its stdout, accumulating.
fn drain(p port.Port, acc Binary) Binary {
	match port.read(p, 4096) {
		Ok(socket.Data(b)) -> drain(p, binary.append(acc, b))
		Ok(socket.Closed) -> acc
		Err(_) -> acc
	}
}

fn map_of(k String, v String) map.Map(String, String) {
	map.set(map.new(), k, v)
}

pub fn main() {
	// --- round trip through cat ----------------------------------------------------
	// cat echoes stdin to stdout and exits on end of input, so closing the port
	// is what ends it, and close reports a clean exit.

	match port.spawn('cat', []) {
		Ok(p) -> {
			check('os pid is reported', p.os_pid > 0)
			check('write succeeds', port.write(p, <<'hello '>>) == Ok(Nil))
			check('write_parts succeeds', port.write_parts(p, [<<'port'>>, <<'s\n'>>]) == Ok(Nil))
			check('cat echoes what was written', port.read_exact(p, 12) == Ok(<<'hello ports\n'>>))
			check('nothing more within the timeout', match port.read_within(p, 10, 30) {
				Err(_) -> True
				Ok(_) -> False
			})
			check('close reports a clean exit', port.close(p) == Ok(port.Exited(0)))
			check('closing again is NotConnected', port.close(p) == Err(error.NotConnected))
		}
		Err(e) -> println('FAIL spawn cat: ${string.inspect(e)}')
	}

	// --- exit codes and output ------------------------------------------------------

	match port.spawn('/bin/sh', ['-c', 'echo out; exit 3']) {
		Ok(p) -> {
			check('output is readable', drain(p, <<>>) == <<'out\n'>>)
			check('read after exit is Closed', port.read(p, 10) == Ok(socket.Closed))
			check('close reports the exit code', port.close(p) == Ok(port.Exited(3)))
		}
		Err(e) -> println('FAIL spawn sh: ${string.inspect(e)}')
	}

	// --- environment ----------------------------------------------------------------

	env = map_of('PORT_TEST_GREETING', 'hi from the parent')
	match port.spawn_env('/bin/sh', ['-c', 'echo "\$PORT_TEST_GREETING"'], env) {
		Ok(p) -> {
			check('env reaches the child', drain(p, <<>>) == <<'hi from the parent\n'>>)
			_ = port.close(p)
		}
		Err(e) -> println('FAIL spawn with env: ${string.inspect(e)}')
	}

	// --- a child that ignores end of input is terminated ------------------------------
	// sleep never reads stdin, so closing the pipes does nothing; close waits out
	// the grace period and terminates it, and says so.

	match port.spawn('sleep', ['30']) {
		Ok(p) ->
			check('a lingering child is terminated on close', port.close(p) == Ok(port.Signaled(15)))
		Err(e) -> println('FAIL spawn sleep: ${string.inspect(e)}')
	}

	// --- a program that does not exist ------------------------------------------------

	check('a missing program is NotFound', match port.spawn('/definitely/not/a/program', []) {
		Err(io.NotFound(path)) -> path == '/definitely/not/a/program'
		Err(_) -> False
		Ok(_) -> False
	})

	// --- a port dies with its owner ----------------------------------------------------
	// The child process spawns a port and returns without closing it. The runtime
	// closes the pipes and collects the child in the background; what is pinned
	// here is that the program still exits, promptly, with the child gone.

	done = process.subject()
	_ = process.spawn(fn() match port.spawn('cat', []) {
		Ok(_) -> process.send(done, True)
		Err(_) -> process.send(done, False)
	})
	check('a port spawned by a process that then ends is cleaned up', process.receive(done))
	println('done')
}

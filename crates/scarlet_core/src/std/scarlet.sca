pub type Int

pub type Float

pub type String

pub type Array(a)

pub type Binary

pub type Bool {
	True
	False
}

pub type Nil {
	Nil
}

pub type Option(a) {
	Some(value a)
	None
}

pub type Result(a, e) {
	Ok(value a)
	Err(error e)
}

pub type Order {
	Lt
	Eq
	Gt
}

// Prints `x` with nothing after it, so the next print carries on the same
// line.
@vm(print)
pub fn print(x a) Nil

// Prints `x` and then a newline.
@vm(println)
pub fn println(x a) Nil

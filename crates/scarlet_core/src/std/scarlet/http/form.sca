/**
 * Encodes and decodes `application/x-www-form-urlencoded`, the format that
 * HTML forms POST and query strings carry (WHATWG URL §5). `decode` keeps a
 * bad percent escape as literal bytes, as every form reader does. But it
 * refuses a name or value that isn't UTF-8, instead of replacing or dropping
 * it. `pct_encode` is strict: it escapes everything outside RFC 3986's
 * unreserved set.
 */

import scarlet/array
import scarlet/binary
import scarlet/option
import scarlet/result

fn hex_val(c Int) Int {
	if c >= 48 && c <= 57 {
		c - 48
	} else if c >= 97 && c <= 102 {
		c - 87
	} else if c >= 65 && c <= 70 {
		c - 55
	} else {
		0 - 1
	}
}

fn hex_digit(n Int) Int {
	if n < 10 {
		48 + n
	} else {
		55 + n
	}
}

fn pct_decode_from(b Binary, at Int, acc Binary) Binary {
	size = binary::byte_size(b)
	if at >= size {
		acc
	} else {
		c = binary::byte_at(b, at)
		if c == 43 {
			// '+' is a space in form encoding.
			pct_decode_from(b, at + 1, binary::append(acc, <<32:8>>))
		} else if c == 37 && at + 2 < size {
			hi = hex_val(binary::byte_at(b, at + 1))
			lo = hex_val(binary::byte_at(b, at + 2))
			if hi < 0 || lo < 0 {
				pct_decode_from(b, at + 1, binary::append(acc, <<c:8>>))
			} else {
				pct_decode_from(b, at + 3, binary::append(acc, <<{ hi * 16 + lo }:8>>))
			}
		} else {
			pct_decode_from(b, at + 1, binary::append(acc, <<c:8>>))
		}
	}
}

/** Decodes the percent escapes in `b` and turns each `+` into a space. */
pub fn pct_decode(b Binary) Binary {
	pct_decode_from(b, 0, <<>>)
}

/** Escapes `s` for any position in a URL. RFC 3986 unreserved bytes pass
 * through and the rest become `%XX`. It never fails, because a String is
 * always valid UTF-8. */
pub fn pct_encode(s String) String {
	binary::from_string(s) |> pct_encode_from(0, <<>>) |> binary::to_string or ''
}

fn pct_encode_from(b Binary, at Int, acc Binary) Binary {
	if at >= binary::byte_size(b) {
		acc
	} else {
		c = binary::byte_at(b, at)
		unreserved = { c >= 48 && c <= 57 } ||
			{ c >= 65 && c <= 90 } ||
			{ c >= 97 && c <= 122 } ||
			c == 45 ||
			c == 46 ||
			c == 95 ||
			c == 126
		next = if unreserved {
			binary::append(acc, <<c:8>>)
		} else {
			binary::append(acc, <<37:8, hex_digit(c / 16):8, hex_digit(c % 16):8>>)
		}
		pct_encode_from(b, at + 1, next)
	}
}

/** Decodes `a=1&b=2`, from a query string or a form body, into pairs in
 * order. A segment with no `=` is a name with an empty value, and an empty
 * segment is skipped, as WHATWG URL §5.1 says. It returns `Err(Nil)` when a
 * decoded name or value isn't UTF-8, so nothing is replaced or dropped. */
pub fn decode(b Binary) Result(Array((String, String)), Nil) {
	decode_from(b, 0, 0, [])
}

// `from` is where the current segment starts, and `at` is the byte being read.
fn decode_from(
	b Binary,
	from Int,
	at Int,
	acc Array((String, String)),
) Result(Array((String, String)), Nil) {
	size = binary::byte_size(b)
	if at < size && binary::byte_at(b, at) != 38 {
		decode_from(b, from, at + 1, acc)
	} else {
		pairs <- result::then(if at == from {
			Ok(acc)
		} else {
			decode_pair(b, from, at) |> result::map(fn(p) [..acc, p])
		})
		if at >= size {
			Ok(pairs)
		} else {
			decode_from(b, at + 1, at + 1, pairs)
		}
	}
}

fn decode_pair(b Binary, from Int, to Int) Result((String, String), Nil) {
	seg <- result::then(binary::slice_bytes(b, from, to - from))
	(raw_name, raw_value) = match binary::index_of(seg, <<'='>>, 0) {
		Some(eq) -> {
			(name, rest) = binary::split_at_bytes(seg, eq)
			(name, binary::drop_bytes(rest, 1))
		}
		None -> (seg, <<>>)
	}
	name <- result::then(raw_name |> pct_decode |> binary::to_string)
	value <- result::then(raw_value |> pct_decode |> binary::to_string)
	Ok((name, value))
}

/** Returns the first value for `key` in a `decode` result. */
pub fn get(pairs Array((String, String)), key String) Option(String) {
	array::find(pairs, fn(p) {
		(k, _) = p
		k == key
	})
	|> option::map(fn(p) {
		(_, v) = p
		v
	})
}

/**
 * Encodes and decodes `application/x-www-form-urlencoded`, the format that
 * HTML forms POST and query strings carry (WHATWG URL §5). `decode` is
 * forgiving: it keeps a bad percent escape as literal bytes, as every form
 * reader does. `pct_encode` is strict: it escapes everything outside RFC
 * 3986's unreserved set.
 */

import scarlet/array
import scarlet/binary
import scarlet/option

fn hex_val(c Int) Int {
	if c >= 48 && c <= 57 {
		c - 48
	} else if c >= 97 && c <= 102 {
		c - 87
	} else if c >= 65 && c <= 70 {
		c - 55
	} else {
		0 - 1
	}
}

fn hex_digit(n Int) Int {
	if n < 10 {
		48 + n
	} else {
		55 + n
	}
}

fn pct_decode_from(b Binary, at Int, acc Binary) Binary {
	size = binary::byte_size(b)
	if at >= size {
		acc
	} else {
		c = binary::byte_at(b, at)
		if c == 43 {
			// '+' is a space in form encoding.
			pct_decode_from(b, at + 1, binary::append(acc, <<32:8>>))
		} else if c == 37 && at + 2 < size {
			hi = hex_val(binary::byte_at(b, at + 1))
			lo = hex_val(binary::byte_at(b, at + 2))
			if hi < 0 || lo < 0 {
				pct_decode_from(b, at + 1, binary::append(acc, <<c:8>>))
			} else {
				pct_decode_from(b, at + 3, binary::append(acc, <<{ hi * 16 + lo }:8>>))
			}
		} else {
			pct_decode_from(b, at + 1, binary::append(acc, <<c:8>>))
		}
	}
}

/** Decodes the percent escapes in `b` and turns each `+` into a space. */
pub fn pct_decode(b Binary) Binary {
	pct_decode_from(b, 0, <<>>)
}

/** Escapes `s` for any position in a URL. RFC 3986 unreserved bytes pass
 * through and the rest become `%XX`. It never fails, because a String is
 * always valid UTF-8. */
pub fn pct_encode(s String) String {
	binary::from_string(s) |> pct_encode_from(0, <<>>) |> binary::to_string or ''
}

fn pct_encode_from(b Binary, at Int, acc Binary) Binary {
	if at >= binary::byte_size(b) {
		acc
	} else {
		c = binary::byte_at(b, at)
		unreserved = { c >= 48 && c <= 57 } ||
			{ c >= 65 && c <= 90 } ||
			{ c >= 97 && c <= 122 } ||
			c == 45 ||
			c == 46 ||
			c == 95 ||
			c == 126
		next = if unreserved {
			binary::append(acc, <<c:8>>)
		} else {
			binary::append(acc, <<37:8, hex_digit(c / 16):8, hex_digit(c % 16):8>>)
		}
		pct_encode_from(b, at + 1, next)
	}
}

/** Decodes `a=1&b=2`, from a query string or a form body, into pairs in
 * order. A segment with no `=` is skipped. */
pub fn decode(b Binary) Array((String, String)) {
	text = binary::to_string(b) or ''
	string_split(text)
	|> array::fold([], fn(acc, pair) match split_once(pair) {
		Some((k, v)) ->
			[
				..acc,
				(
					binary::from_string(k) |> pct_decode |> binary::to_string or '',
					binary::from_string(v) |> pct_decode |> binary::to_string or '',
				),
			]
		None -> acc
	})
}

// These split bytes on '&' and the first '=', so this module doesn't need
// scarlet/string.
fn string_split(text String) Array(String) {
	splits(binary::from_string(text), 0, 0, [])
}

fn splits(b Binary, from Int, at Int, acc Array(String)) Array(String) {
	size = binary::byte_size(b)
	if at >= size {
		[..acc, segment(b, from, at)]
	} else if binary::byte_at(b, at) == 38 {
		splits(b, at + 1, at + 1, [..acc, segment(b, from, at)])
	} else {
		splits(b, from, at + 1, acc)
	}
}

fn segment(b Binary, from Int, to Int) String {
	match binary::slice_bytes(b, from, to - from) {
		Ok(s) -> binary::to_string(s) or ''
		Err(Nil) -> ''
	}
}

fn split_once(pair String) Option((String, String)) {
	b = binary::from_string(pair)
	at <- option::then(binary::index_of(b, <<'='>>, 0))
	Some((segment(b, 0, at), segment(b, at + 1, binary::byte_size(b))))
}

/** Returns the first value for `key` in a `decode` result. */
pub fn get(pairs Array((String, String)), key String) Option(String) {
	array::find(pairs, fn(p) {
		(k, _) = p
		k == key
	})
	|> option::map(fn(p) {
		(_, v) = p
		v
	})
}

import scarlet/binary
import scarlet/int
import scarlet/result

// Parses absolute http and https URLs once into what a client needs: the
// transport, the host and port, and the request target. The scheme is a value,
// so `https` picks TLS in one `match` (see `scarlet/http/client.connect`).
//
// Relative references aren't parsed. The client doesn't follow redirects, so
// there's nothing to resolve them against.

// The transports the client can open. `ftp://` is refused when parsing.
pub type Scheme {
	Http
	Https
}

// An absolute http(s) URL. `host` is where to connect and, for `Https`, the
// name the certificate must match. An IPv6 host has no brackets. `port` is
// always set. `target` is the path and `?query`, never empty, with no fragment.
pub type Url {
	scheme Scheme
	host String
	port Int
	target Binary
}

// Why a string isn't a URL this client can use.
pub type UrlError {
	// There's no `://`, as in a relative reference.
	MissingScheme
	// The URL is absolute, but its scheme has no transport here.
	UnsupportedScheme(scheme Binary)
	// There's no host, as in `http:///path`. A host that isn't UTF-8 gives this
	// too.
	EmptyHost
	// The `:port` is empty, isn't a run of decimal digits, or is outside
	// 1..=65535.
	BadPort(text Binary)
	// The URL has user info, as in `http://user:pass@host/`. It's refused
	// instead of ignored, because dropping the credentials would send a request
	// the caller didn't mean (RFC 9110 §4.2.4).
	UserInfoUnsupported
	// A bracketed host has no closing bracket, as in `http://[::1/`.
	UnclosedIpv6
}

const SCHEME_SEP = <<'://'>>
const SLASH = <<'/'>>
const QUESTION = <<'?'>>
const HASH = <<'#'>>
const COLON = <<':'>>
const AT = <<'@'>>
const LBRACKET = <<'['>>
const RBRACKET = <<']'>>
const HTTP = <<'http'>>
const HTTPS = <<'https'>>
const ROOT = <<'/'>>
const EMPTY = <<>>

// The port a scheme uses when the URL doesn't say.
pub fn default_port(s Scheme) Int {
	match s {
		Http -> 80
		Https -> 443
	}
}

// Builds the `Host` value. That's the host, in brackets if it's IPv6, with
// `:port` only when it isn't the default (RFC 9110 §7.2).
pub fn authority(u Url) Binary {
	host = binary::from_string(u.host)
	bracketed = match binary::index_of(host, COLON, 0) {
		Some(_) -> LBRACKET |> binary::append(host) |> binary::append(RBRACKET)
		None -> host
	}
	if u.port == default_port(u.scheme) {
		bracketed
	} else {
		port = binary::from_int_ascii(u.port, binary::Dec)
		bracketed |> binary::append(COLON) |> binary::append(port)
	}
}

// Parses an absolute `http://` or `https://` URL.
pub fn parse(text String) Result(Url, UrlError) {
	b = binary::from_string(text)
	sep <- result::then(scheme_sep(b))
	(scheme_text, _) = binary::split_at_bytes(b, sep)
	scheme <- result::then(scheme_of(scheme_text))
	authority_start = sep + 3
	size = binary::byte_size(b)
	authority_end = first_of(b, authority_start, size)
	// This can't fail, because `authority_start <= authority_end <= size`.
	authority = match binary::slice_bytes(b, authority_start, authority_end - authority_start) {
		Ok(a) -> a
		Err(Nil) -> EMPTY
	}
	pair <- result::then(split_host_port(authority))
	port <- result::then(port_of(pair.port_text, scheme))
	host <- result::then(host_of(pair.host))
	Ok(Url(scheme: scheme, host: host, port: port, target: target_of(b, authority_end, size)))
}

// A scheme can't contain a slash, so the first `://` is always the scheme's.
fn scheme_sep(b Binary) Result(Int, UrlError) {
	match binary::index_of(b, SCHEME_SEP, 0) {
		Some(i) -> Ok(i)
		None -> Err(MissingScheme)
	}
}

fn scheme_of(s Binary) Result(Scheme, UrlError) {
	if binary::eq_ignore_ascii_case(s, HTTPS) {
		Ok(Https)
	} else if binary::eq_ignore_ascii_case(s, HTTP) {
		Ok(Http)
	} else {
		Err(UnsupportedScheme(s))
	}
}

// Finds where the authority ends, which is the earliest `/`, `?` or `#`, or
// `size` if there's none. Taking the earliest means `http://h?q=1` doesn't read
// `?q=1` as part of the host.
fn first_of(b Binary, from Int, size Int) Int {
	int::min(
		at_or(b, SLASH, from, size),
		int::min(at_or(b, QUESTION, from, size), at_or(b, HASH, from, size)),
	)
}

fn at_or(b Binary, needle Binary, from Int, fallback Int) Int {
	match binary::index_of(b, needle, from) {
		Some(i) -> i
		None -> fallback
	}
}

// The host and the raw `:port` text, not yet checked.
type HostPort {
	host Binary
	port_text Binary
}

fn split_host_port(authority Binary) Result(HostPort, UrlError) {
	match binary::index_of(authority, AT, 0) {
		Some(_) -> Err(UserInfoUnsupported)
		None -> if binary::byte_at(authority, 0) == 91 {
			split_bracketed(authority)
		} else {
			Ok(split_at_colon(authority, binary::index_of(authority, COLON, 0)))
		}
	}
}

// Splits `[v6]` or `[v6]:port`. The port colon is the one after the bracket,
// because an IPv6 literal is full of colons and searching from 0 would split
// the address.
fn split_bracketed(authority Binary) Result(HostPort, UrlError) {
	match binary::index_of(authority, RBRACKET, 0) {
		None -> Err(UnclosedIpv6)
		Some(close) -> {
			(up_to_close, _) = binary::split_at_bytes(authority, close)
			(_, inside) = binary::split_at_bytes(up_to_close, 1)
			rest = binary::drop_bytes(authority, close + 1)
			// After `]` comes nothing or `:port`. Anything else is a bad port, not an
			// empty host.
			if binary::byte_size(rest) == 0 {
				Ok(HostPort(host: inside, port_text: EMPTY))
			} else if binary::byte_at(rest, 0) == 58 {
				Ok(HostPort(host: inside, port_text: rest))
			} else {
				Err(BadPort(rest))
			}
		}
	}
}

fn split_at_colon(authority Binary, colon Option(Int)) HostPort {
	match colon {
		None -> HostPort(host: authority, port_text: EMPTY)
		Some(i) -> {
			(host, port_text) = binary::split_at_bytes(authority, i)
			HostPort(host: host, port_text: port_text)
		}
	}
}

// `port_text` keeps its colon, so a missing port can be told apart from an
// empty one like `http://h:/`, which is a BadPort.
fn port_of(port_text Binary, scheme Scheme) Result(Int, UrlError) {
	if binary::byte_size(port_text) == 0 {
		Ok(default_port(scheme))
	} else {
		digits = binary::drop_bytes(port_text, 1)
		// Check for digits only, in case `parse_int` accepts a sign.
		if binary::byte_size(digits) == 0 || !all_digits(digits, 0, binary::byte_size(digits)) {
			Err(BadPort(port_text))
		} else {
			match binary::parse_int(digits, binary::Dec) {
				Ok(n) -> if n >= 1 && n <= 65535 {
					Ok(n)
				} else {
					Err(BadPort(port_text))
				}
				Err(Nil) -> Err(BadPort(port_text))
			}
		}
	}
}

fn all_digits(b Binary, i Int, len Int) Bool {
	i >= len || is_digit(binary::byte_at(b, i)) && all_digits(b, i + 1, len)
}

fn is_digit(byte Int) Bool {
	byte >= 48 && byte <= 57
}

fn host_of(host Binary) Result(String, UrlError) {
	if binary::byte_size(host) == 0 {
		Err(EmptyHost)
	} else {
		match binary::to_string(host) {
			Ok(s) -> Ok(s)
			// A host that isn't UTF-8 isn't a name anything can resolve or
			// verify a certificate against.
			Err(Nil) -> Err(EmptyHost)
		}
	}
}

// The target runs from the end of the authority to the fragment. It's `/` when
// that's empty, and gets a leading `/` when it starts with `?`.
fn target_of(b Binary, from Int, size Int) Binary {
	end = at_or(b, HASH, from, size)
	// This can't fail, because `from <= end <= size`.
	raw = match binary::slice_bytes(b, from, end - from) {
		Ok(v) -> v
		Err(Nil) -> EMPTY
	}
	if binary::byte_size(raw) == 0 {
		ROOT
	} else if binary::byte_at(raw, 0) == 63 {
		binary::append(ROOT, raw)
	} else {
		raw
	}
}

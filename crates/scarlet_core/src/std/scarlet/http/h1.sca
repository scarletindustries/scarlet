import scarlet/http/headers
import scarlet/http/status

// This module does HTTP/1.1 without I/O. It parses request and response heads,
// decides body framing and writes response heads. It works on a Binary and
// offsets, never a socket, and hands back views into the caller's buffer.
// scarlet/http imports this module, never the other way round.
//
// The byte scanning runs natively in httparse, with one call per head. Every
// protocol decision, like keep-alive or 100-continue, stays in Scarlet.

// HTTP/1.0 or HTTP/1.1. HTTP/2 frames differently and never reaches here.
pub type Version {
	Http10
	Http11
}

// The `Connection` tokens a head carried. A peer can send both (RFC 9110
// §7.6.1), so `ConnBoth` is a real case, and `should_close` decides what it
// means. This mirrors the VM's `ConnTokens`, so change them together.
pub type ConnTokens {
	ConnNeither
	ConnClose
	ConnKeepAlive
	ConnBoth
}

// The `Connection` and `Expect` tokens, which the head parser finds in its one
// pass over the fields. Trailers never add to them (RFC 9110 §6.5.1).
pub opaque type HeadFlags {
	conn ConnTokens
	expect_100_continue Bool
}

// One parsed request head. `consumed` is where the next pipelined request
// starts.
pub type Parsed {
	Done(
		method Binary,
		target Binary,
		version Version,
		headers headers::Headers,
		flags HeadFlags,
		consumed Int,
	)
	NeedMore
	Bad(status Int)
}

// How a request body is framed (RFC 7230 §3.3.3). A Transfer-Encoding other
// than chunked is refused with 501 instead of being ignored, because ignoring
// one allows request smuggling.
pub type Framing {
	NoBody
	Length(n Int)
	Chunked
	Invalid(status Int)
}

// The result of decoding one chunked body. On ChunkedNeedMore, read more and
// call again with the same offset. `consumed` is just past the final CRLF.
pub type ChunkBody {
	ChunkedDone(body Binary, trailers headers::Headers, consumed Int)
	ChunkedNeedMore
	ChunkedBad(status Int)
}

// Why a response head was refused. It isn't a status code, because a client
// has no one to answer.
pub type BadResponse {
	// The status line isn't `HTTP/1.x SP <3 digits> [SP reason]`. This includes
	// a three-byte code that isn't three digits, and a line with no space.
	BadStatusLine
	// The version is well-formed but is neither HTTP/1.0 nor HTTP/1.1.
	BadVersion
	// A field is malformed: it has no colon, a space before the colon, or an
	// obs-fold. The rules are the same as for a request head.
	BadField
	// The head went over the 64 KiB cap, so it was refused instead of being
	// buffered forever.
	HeadTooLarge
	// Content-Length and Transfer-Encoding disagree, or the coding isn't
	// chunked. Only `response_framing` gives this.
	BadFraming
}

// One parsed response head, like `Parsed`. `reason` may be empty, and a
// client must not act on it (RFC 9112 §4). It's kept so a proxy can forward
// it.
pub type ParsedResponse {
	ResponseDone(
		version Version,
		code Int,
		reason Binary,
		headers headers::Headers,
		flags HeadFlags,
		consumed Int,
	)
	ResponseNeedMore
	ResponseBad(err BadResponse)
}

// How a response body is framed (RFC 9112 §6.3). Unlike a request, a response
// with no framing fields has a body that runs until close, so this is a
// different type from `Framing`.
pub type ResponseFraming {
	// No body may follow, whatever the fields said. This is for 1xx, 204 and
	// 304.
	BodyNone
	BodyLength(n Int)
	BodyChunked
	// There are no framing fields, so the body ends at close. A body that was
	// cut short looks whole, so prefer a framed reply.
	BodyUntilClose
	BodyInvalid(err BadResponse)
}

// Parses a request head from `buf` at `off`. On NeedMore, read more and retry.
// Up to four empty lines may come first. It refuses obs-fold, a space before a
// colon, a bare CR or LF and NUL with 400, anything that isn't HTTP/1.x with
// 505, and a head over 64 KiB with 431 or 414.
@vm(http__parse_head)
pub fn parse_request(buf Binary, off Int) Parsed

// Decides how a request body is framed (RFC 7230 §3.3.3). It refuses
// Transfer-Encoding with Content-Length (400), a coding other than chunked
// (501), and more than one Content-Length, or one that isn't plain digits, is
// too big or looks like "007" (400).
@vm(http__framing)
pub fn framing(hs headers::Headers) Framing

// Parses a response head from `buf` at `off`. On ResponseNeedMore, read more
// and retry. Fields follow the request rules. Unlike a request, no empty line
// may come first, because from a server that means the connection is out of
// step.
@vm(http__parse_response_head)
pub fn parse_response(buf Binary, off Int) ParsedResponse

// Decides how a response body is framed (RFC 9112 §6.3). 1xx, 204 and 304 have
// no body, and with no framing fields the body ends at close. A response to
// HEAD has no body either, but h1 never sees the request, so the client checks
// that.
pub fn response_framing(hs headers::Headers, code Int) ResponseFraming {
	if code >= 100 && code < 200 || code == 204 || code == 304 {
		BodyNone
	} else {
		match framing(hs) {
			Chunked -> BodyChunked
			Length(n) -> BodyLength(n)
			NoBody -> BodyUntilClose
			Invalid(_) -> BodyInvalid(BadFraming)
		}
	}
}

// Decodes a chunked body from `buf` at `off`, refusing more than `max` bytes
// with 413. Chunk extensions are ignored. A bad size line, or data not followed
// by CRLF, is refused with 400. Trailers follow the head rules, with 431 when
// they're too big.
@vm(http__chunk_decode)
pub fn chunk_decode(buf Binary, off Int, max Int) ChunkBody

// Writes the status line, the headers and the blank line as one Binary, so it
// can lead a vectored write.
@vm(http__serialize_head)
fn serialize_head_with(code Int, reason Binary, hs headers::Headers) Binary

pub fn serialize_head(code Int, hs headers::Headers) Binary {
	serialize_head_with(code, status::reason_phrase(code), hs)
}

// Whether to close after this message. It always closes on `close` (RFC 9112
// §9.3). Otherwise HTTP/1.0 closes unless it sent `keep-alive`, and HTTP/1.1
// stays open. There's one arm per token set, so a new state must be handled
// here.
pub fn should_close(version Version, f HeadFlags) Bool {
	match f.conn {
		ConnClose -> True
		ConnBoth -> True
		ConnKeepAlive -> False
		ConnNeither -> match version {
			Http11 -> False
			Http10 -> True
		}
	}
}

pub fn want_100_continue(f HeadFlags) Bool {
	f.expect_100_continue
}

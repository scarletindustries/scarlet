import scarlet/http/headers
import scarlet/http/status

// HTTP/1.1 without I/O: parse request and response heads, decide body
// framing, and write response heads. It works on a Binary and offsets, never a
// socket, and hands back views into the caller's buffer. scarlet/http imports
// this, never the other way.
//
// The byte scanning runs natively (httparse), one call per head. Every
// protocol decision, like keep-alive or 100-continue, stays in Scarlet.

// HTTP/1.0 or HTTP/1.1. HTTP/2 frames differently and never reaches here.
pub type Version {
	Http10
	Http11
}

// The `Connection` tokens a head carried. A peer can send both (RFC 9110
// §7.6.1), so `ConnBoth` is real; `should_close` decides what it means.
// Mirrors the VM's `ConnTokens`: change them together.
pub type ConnTokens {
	ConnNeither
	ConnClose
	ConnKeepAlive
	ConnBoth
}

// The `Connection` and `Expect` tokens, found in the head parser's one pass
// over the fields. Trailers never add to them (RFC 9110 §6.5.1).
pub opaque type HeadFlags {
	conn ConnTokens
	expect_100_continue Bool
}

// One parsed request head. `consumed` is where the next pipelined request
// starts.
pub type Parsed {
	Done(
		method Binary
		target Binary
		version Version
		headers headers.Headers
		flags HeadFlags
		consumed Int
	)
	NeedMore
	Bad(status Int)
}

// How a request body is framed (RFC 7230 §3.3.3). A Transfer-Encoding other
// than chunked is refused with 501, not ignored: ignoring one allows request
// smuggling.
pub type Framing {
	NoBody
	Length(n Int)
	Chunked
	Invalid(status Int)
}

// One chunked body decode. On ChunkedNeedMore, read more and call again with
// the same offset. `consumed` is just past the final CRLF.
pub type ChunkBody {
	ChunkedDone(body Binary, trailers headers.Headers, consumed Int)
	ChunkedNeedMore
	ChunkedBad(status Int)
}

// Why a response head was refused. Not a status code: a client has no one to
// answer.
pub type BadResponse {
	// The status line is not `HTTP/1.x SP <3 digits> [SP reason]`. Includes a
	// three-byte code that is not three digits, and a line with no space.
	BadStatusLine
	// The version is well-formed but is neither HTTP/1.0 nor HTTP/1.1.
	BadVersion
	// A malformed field: no colon, space before the colon, or obs-fold. The same
	// rules as a request head.
	BadField
	// The head exceeded the 64 KiB cap rather than being buffered forever.
	HeadTooLarge
	// Content-Length and Transfer-Encoding disagree, or a coding other than
	// chunked. Only `response_framing` gives this.
	BadFraming
}

// One parsed response head, like `Parsed`. `reason` may be empty, and a
// client must not act on it (RFC 9112 §4); it is kept so a proxy can forward it.
pub type ParsedResponse {
	ResponseDone(
		version Version
		code Int
		reason Binary
		headers headers.Headers
		flags HeadFlags
		consumed Int
	)
	ResponseNeedMore
	ResponseBad(err BadResponse)
}

// How a response body is framed (RFC 9112 §6.3). Unlike a request, no
// framing fields means the body runs until close, so this is not `Framing`.
pub type ResponseFraming {
	// No body may follow, whatever the fields said: 1xx, 204 and 304.
	BodyNone
	BodyLength(n Int)
	BodyChunked
	// No framing fields: the body ends at close. A cut-short body looks whole,
	// so prefer a framed reply.
	BodyUntilClose
	BodyInvalid(err BadResponse)
}

// Parse a request head from `buf` at `off`; on NeedMore, read more and retry.
// Up to four empty lines may come first. Refused: obs-fold, space before a
// colon, bare CR or LF, NUL (400); not HTTP/1.x (505); over 64 KiB (431, 414).
@vm(http__parse_head)
pub fn parse_request(buf Binary, off Int) Parsed

// Request body framing (RFC 7230 §3.3.3). Refused: Transfer-Encoding with
// Content-Length (400), a coding other than chunked (501), and more than one
// Content-Length, or one that is not plain digits, too big, or like "007" (400).
@vm(http__framing)
pub fn framing(hs headers.Headers) Framing

// Parse a response head from `buf` at `off`; on ResponseNeedMore, read more
// and retry. Fields follow the request rules. Unlike a request, no empty line
// may come first: from a server, that means the connection is out of step.
@vm(http__parse_response_head)
pub fn parse_response(buf Binary, off Int) ParsedResponse

// Response body framing (RFC 9112 §6.3): 1xx, 204 and 304 have no body, and
// no framing fields means the body ends at close. A response to HEAD has no
// body either, but h1 never sees the request, so the client checks that.
pub fn response_framing(hs headers.Headers, code Int) ResponseFraming {
	if code >= 100 && code < 200 || code == 204 || code == 304 {
		BodyNone
	} else {
		match framing(hs) {
			Chunked -> BodyChunked
			Length(n) -> BodyLength(n)
			NoBody -> BodyUntilClose
			Invalid(_) -> BodyInvalid(BadFraming)
		}
	}
}

// Decode a chunked body from `buf` at `off`, at most `max` bytes (413). Chunk
// extensions are ignored. A bad size line, or data not followed by CRLF, is
// refused (400). Trailers follow the head rules (431 when too big).
@vm(http__chunk_decode)
pub fn chunk_decode(buf Binary, off Int, max Int) ChunkBody

// The status line, the headers and the blank line, as one Binary, so it can
// lead a vectored write.
@vm(http__serialize_head)
fn serialize_head_with(code Int, reason Binary, hs headers.Headers) Binary

pub fn serialize_head(code Int, hs headers.Headers) Binary {
	serialize_head_with(code, status.reason_phrase(code), hs)
}

// Whether to close after this message: always on `close` (RFC 9112 §9.3),
// else HTTP/1.0 closes unless `keep-alive` and HTTP/1.1 stays open. One arm
// per token set, so a new state must be handled here.
pub fn should_close(version Version, f HeadFlags) Bool {
	match f.conn {
		ConnClose -> True
		ConnBoth -> True
		ConnKeepAlive -> False
		ConnNeither -> match version {
			Http11 -> False
			Http10 -> True
		}
	}
}

pub fn want_100_continue(f HeadFlags) Bool {
	f.expect_100_continue
}

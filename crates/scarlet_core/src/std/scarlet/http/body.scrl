import scarlet/binary
import scarlet/int
import scarlet/net/socket
import scarlet/net/error
import scarlet/http/headers
import scarlet/time

// Few pulls for a whole body, and a slow reader pins only one chunk.
const READ_SIZE = 65536
const CRLF = <<'\r\n'>>
const ZERO = <<'0'>>
// 0-size chunk + empty trailer block: the terminator for a trailer-free body.
const LAST_CHUNK = <<'0\r\n\r\n'>>

// A body is a pull thunk: each call gives the next chunk and the rest of the
// body, or Done with any trailers. `Pull` and `Body` refer to each other, so
// they must share a module.
pub type Pull {
	Chunk(data Binary, next Body)
	Done(trailers Array(headers.Header))
}

pub type Body = fn() Result(Pull, error.NetError)

pub fn empty() Body {
	fn() Ok(Done([]))
}

// `b` as one chunk, even when it is empty.
pub fn from_binary(b Binary) Body {
	fn() Ok(Chunk(b, empty()))
}

// Exactly `n` more bytes from `reader`, then Done; a close before that is
// UnexpectedEof. `n <= 0` reads nothing. Every read counts against the one
// `deadline`, so a peer sending a byte at a time runs out of time.
pub fn content_length(reader socket.Socket, n Int, deadline time.Instant) Body {
	fn() if n <= 0 {
		Ok(Done([]))
	} else {
		match socket.read_until(reader, int.min(n, READ_SIZE), deadline) {
			Ok(socket.Data(chunk)) ->
				Ok(Chunk(chunk, content_length(reader, n - binary.byte_size(chunk), deadline)))
			Ok(socket.Closed) -> Err(error.UnexpectedEof)
			Err(e) -> Err(e)
		}
	}
}

pub fn pull(b Body) Result(Pull, error.NetError) {
	b()
}

// What `take_buffered` found a body to be.
pub type Buffered {
	// No bytes at all.
	Empty
	// The whole body was one in-memory chunk (http.text and friends).
	Whole(data Binary)
	// A real stream: the chunks pulled while finding that out, plus the rest.
	Streaming(first Binary, second Binary, rest Body)
}

// Find out whether a body is one chunk in memory (to batch with other writes)
// or a real stream (to drain). It never writes, so an Err is always the body's.
pub fn take_buffered(b Body) Result(Buffered, error.NetError) {
	match pull(b) {
		Err(e) -> Err(e)
		Ok(Done(_)) -> Ok(Empty)
		Ok(Chunk(data, next)) -> match pull(next) {
			Err(e) -> Err(e)
			Ok(Done(_)) -> Ok(Whole(data))
			Ok(Chunk(second, rest)) -> Ok(Streaming(data, second, rest))
		}
	}
}

// Pull the first step early, so a body that fails at once is found before any
// bytes are written. The returned body replays that step. Never writes.
pub fn probe(b Body) Result(Body, error.NetError) {
	match pull(b) {
		Ok(step) -> Ok(fn() Ok(step))
		Err(e) -> Err(e)
	}
}

// Which side of a drain failed. After a source failure the socket still
// works; after a sink failure nothing more can be sent.
pub type DrainError {
	// The body failed. Bytes from earlier steps may already be on the wire.
	SourceFailed(err error.NetError)
	// A socket write failed; the connection is unusable.
	SinkFailed(err error.NetError)
}

// Write a whole body to `sock`, a chunk at a time. A slow reader slows the
// pulls, and memory stays at one chunk. Trailers are dropped: a raw body
// cannot carry them.
pub fn drain(body Body, sock socket.Socket) Result(Nil, DrainError) {
	drain_prefixed([], body, sock)
}

// Like `drain`, with `head` in the same write as the first chunk.
pub fn drain_with_head(head Binary, body Body, sock socket.Socket) Result(Nil, DrainError) {
	drain_prefixed([head], body, sock)
}

// `prefix` goes in the first write, and is `[]` after.
fn drain_prefixed(prefix Array(Binary), body Body, sock socket.Socket) Result(Nil, DrainError) {
	match pull(body) {
		Ok(Chunk(data, next)) -> match socket.write_parts(sock, [..prefix, data]) {
			Ok(Nil) -> drain_prefixed([], next, sock)
			Err(e) -> Err(SinkFailed(e))
		}
		Ok(Done(_)) -> match prefix {
			[] -> Ok(Nil)
			_ -> match socket.write_parts(sock, prefix) {
				Ok(Nil) -> Ok(Nil)
				Err(e) -> Err(SinkFailed(e))
			}
		}
		Err(e) -> Err(SourceFailed(e))
	}
}

// How a counted drain ended, against its budget.
pub type Drained {
	// The body ended having written exactly the budget.
	Complete
	// The body ended early: only `written` of the budgeted bytes went out.
	Short(written Int)
	// A chunk would have crossed the budget. It was NOT written — `written`
	// (all within budget) is everything that reached the wire.
	Overran(written Int)
}

// Like `drain`, but writes at most `limit` bytes. A chunk that would pass the
// limit is not written, so no byte past an advertised length goes out.
pub fn drain_counted(body Body, sock socket.Socket, limit Int) Result(Drained, DrainError) {
	drain_counted_from(body, sock, limit, 0)
}

fn drain_counted_from(
	body Body,
	sock socket.Socket,
	limit Int,
	written Int,
) Result(Drained, DrainError) {
	match pull(body) {
		Ok(Chunk(data, next)) -> {
			total = written + binary.byte_size(data)
			if total > limit {
				Ok(Overran(written))
			} else {
				match socket.write(sock, data) {
					Ok(Nil) -> drain_counted_from(next, sock, limit, total)
					Err(e) -> Err(SinkFailed(e))
				}
			}
		}
		Ok(Done(_)) -> if written == limit {
			Ok(Complete)
		} else {
			Ok(Short(written))
		}
		Err(e) -> Err(SourceFailed(e))
	}
}

// Write a body with chunked framing, so a body of unknown length can keep an
// HTTP/1.1 connection open. Empty chunks are skipped: a zero-size chunk would
// end the body.
pub fn drain_chunked(body Body, sock socket.Socket) Result(Nil, DrainError) {
	drain_chunked_prefixed([], body, sock)
}

// Like `drain_chunked`, with `head` in the same write as the first chunk.
pub fn drain_chunked_with_head(head Binary, body Body, sock socket.Socket) Result(Nil, DrainError) {
	drain_chunked_prefixed([head], body, sock)
}

// `prefix` goes in the first write, as in `drain_prefixed`.
fn drain_chunked_prefixed(
	prefix Array(Binary),
	body Body,
	sock socket.Socket,
) Result(Nil, DrainError) {
	match pull(body) {
		Ok(Chunk(data, next)) -> match binary.byte_size(data) {
			0 -> drain_chunked_prefixed(prefix, next, sock)
			size -> {
				header = binary.append(binary.from_int_ascii(size, binary.Hex), CRLF)
				match socket.write_parts(sock, [..prefix, header, data, CRLF]) {
					Ok(Nil) -> drain_chunked_prefixed([], next, sock)
					Err(e) -> Err(SinkFailed(e))
				}
			}
		}
		Ok(Done(trailers)) -> {
			terminator = match trailers {
				[] -> [LAST_CHUNK]
				_ -> [ZERO, CRLF, ..headers.render(trailers), CRLF]
			}
			match socket.write_parts(sock, [..prefix, ..terminator]) {
				Ok(Nil) -> Ok(Nil)
				Err(e) -> Err(SinkFailed(e))
			}
		}
		Err(e) -> Err(SourceFailed(e))
	}
}

// Read a whole body into one Binary, at most `max` bytes (MessageTooLarge).
// The size is checked before each append, so it never grows past `max`.
pub fn collect(body Body, max Int) Result(Binary, error.NetError) {
	collect_into(body, max, <<>>)
}

fn collect_into(body Body, max Int, acc Binary) Result(Binary, error.NetError) {
	match pull(body) {
		Ok(Chunk(data, next)) -> if binary.byte_size(acc) + binary.byte_size(data) > max {
			Err(error.MessageTooLarge(max))
		} else {
			collect_into(next, max, binary.append(acc, data))
		}
		Ok(Done(_)) -> Ok(acc)
		Err(e) -> Err(e)
	}
}

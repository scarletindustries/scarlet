import scarlet/binary

// An HTTP header field. Names compare case-insensitively (RFC 9110 §5.1), but
// the original casing is kept on the wire.
pub type Header {
	name Binary
	value Binary
}

// Headers are a list instead of a map, because order and duplicates matter, as
// with several `Set-Cookie` fields.
pub type Headers = Array(Header)

const colon_space = <<': '>>
const crlf = <<'\r\n'>>
const comma = <<','>>
// The bytes a field value must never contain.
const cr = <<'\r'>>
const lf = <<'\n'>>
const nul = <<'\0'>>
// ASCII SP and HTAB are the only OWS (optional whitespace) bytes RFC 9110
// defines.
const sp = 32
const htab = 9

// The value of the first field named `name`, ignoring case.
@vm(http__header_get)
pub fn get(h Headers, name Binary) Option(Binary)

// Whether any field matches `name`, ignoring case.
@vm(http__header_has)
pub fn has(h Headers, name Binary) Bool

// Sets `name` so that exactly one field has it. The first match is replaced in
// place and later ones are removed, or a new field is appended if none match.
// This matters because two Content-Length fields would allow request
// smuggling.
pub fn set(h Headers, name Binary, value Binary) Headers {
	match h {
		[] -> [Header(name: name, value: value)]
		[field, ..rest] -> if binary::eq_ignore_ascii_case(field.name, name) {
			[Header(name: field.name, value: value), ..delete(rest, name)]
		} else {
			[field, ..set(rest, name, value)]
		}
	}
}

// Removes every field named `name`, ignoring case. If there are none, `h`
// comes back as it is, with no copy.
pub fn delete(h Headers, name Binary) Headers {
	if has(h, name) {
		delete_walk(h, name)
	} else {
		h
	}
}

fn delete_walk(h Headers, name Binary) Headers {
	match h {
		[] -> []
		[field, ..rest] -> if binary::eq_ignore_ascii_case(field.name, name) {
			delete_walk(rest, name)
		} else {
			[field, ..delete_walk(rest, name)]
		}
	}
}

// Adds a field at the end, as for a second `Set-Cookie`.
pub fn append(h Headers, name Binary, value Binary) Headers {
	[..h, Header(name: name, value: value)]
}

// Why `field` refused to build a Header.
pub type InvalidHeader {
	BadName(name Binary)
	BadValue(value Binary)
}

// Builds a Header, but only if `name` is an RFC 9110 token and `value` has no
// CR, LF or NUL. This stops outside input from putting a line break on the
// wire.
pub fn field(name Binary, value Binary) Result(Header, InvalidHeader) {
	if !valid_name(name) {
		Err(BadName(name))
	} else if !valid_value(value) {
		Err(BadValue(value))
	} else {
		Ok(Header(name: name, value: value))
	}
}

// Whether every field is safe to write, meaning it has a token name and no CR,
// LF or NUL in its value. The server checks this before any response goes out.
@vm(http__headers_valid)
pub fn valid(h Headers) Bool

// A field name must be a non-empty RFC 9110 token (§5.6.2).
fn valid_name(name Binary) Bool {
	binary::byte_size(name) > 0 && token_bytes_from(name, 0, binary::byte_size(name))
}

fn token_bytes_from(name Binary, i Int, len Int) Bool {
	i >= len || is_token_byte(binary::byte_at(name, i)) && token_bytes_from(name, i + 1, len)
}

// Token bytes are ALPHA, DIGIT and !#$%&'*+-.^_`|~ (RFC 9110 §5.6.2). This is
// one flat test because `valid` checks every name byte of every response.
fn is_token_byte(b Int) Bool {
	b >= 97 && b <= 122 ||
		b >= 65 && b <= 90 ||
		b >= 48 && b <= 57 ||
		b == 33 ||
		b >= 35 && b <= 39 ||
		b == 42 ||
		b == 43 ||
		b == 45 ||
		b == 46 ||
		b >= 94 && b <= 96 ||
		b == 124 ||
		b == 126
}

// A value must have no CR or LF, which would end the line early and split the
// response, and no NUL (RFC 9110 §5.5). Each check is one native scan.
fn valid_value(value Binary) Bool {
	lacks(value, cr) && lacks(value, lf) && lacks(value, nul)
}

fn lacks(v Binary, byte Binary) Bool {
	match binary::index_of(v, byte, 0) {
		Some(_) -> False
		None -> True
	}
}

// Whether a field named `name` has `token` in its comma-separated list, like
// `Connection: keep-alive, Upgrade`. It checks every such field, ignoring case
// and the spaces around elements.
pub fn contains_token(h Headers, name Binary, token Binary) Bool {
	has(h, name) && token_walk(h, name, token)
}

fn token_walk(h Headers, name Binary, token Binary) Bool {
	match h {
		[] -> False
		[field, ..rest] -> {
			hit = binary::eq_ignore_ascii_case(field.name, name) && has_token(field.value, token)
			if hit {
				True
			} else {
				token_walk(rest, name, token)
			}
		}
	}
}

fn has_token(v Binary, token Binary) Bool {
	value_has_token(v, 0, binary::byte_size(v), token)
}

// Whether `v[lo..hi]` is `token`, ignoring case. An empty element never
// matches (RFC 9110).
fn element_is(v Binary, lo Int, hi Int, token Binary) Bool {
	if hi <= lo {
		False
	} else {
		match binary::slice_bytes(v, lo, hi - lo) {
			Ok(e) -> binary::eq_ignore_ascii_case(e, token)
			Err(Nil) -> False
		}
	}
}

fn value_has_token(v Binary, from Int, len Int, token Binary) Bool {
	to = match binary::index_of(v, comma, from) {
		Some(i) -> i
		None -> len
	}
	lo = skip_ows(v, from, to)
	hi = trim_ows(v, lo, to)
	if element_is(v, lo, hi, token) {
		True
	} else if to < len {
		value_has_token(v, to + 1, len, token)
	} else {
		False
	}
}

fn skip_ows(v Binary, i Int, hi Int) Int {
	if i < hi && is_ows(binary::byte_at(v, i)) {
		skip_ows(v, i + 1, hi)
	} else {
		i
	}
}

fn trim_ows(v Binary, lo Int, i Int) Int {
	if i > lo && is_ows(binary::byte_at(v, i - 1)) {
		trim_ows(v, lo, i - 1)
	} else {
		i
	}
}

fn is_ows(b Int) Bool {
	b == sp || b == htab
}

// Renders the header block as parts for socket.write_parts, with name, ": ",
// value and CRLF for each field. The caller adds the blank line that ends the
// block.
pub fn render(h Headers) Array(Binary) {
	match h {
		[] -> []
		[field, ..rest] -> [field.name, colon_space, field.value, crlf, ..render(rest)]
	}
}

import scarlet/binary
import scarlet/option

// JSON, parsed with SIMD and read in place. `parse` gives a `Doc`, a cursor
// over the parser's tape, so reading six fields of a big payload copies six
// strings. `to_json` builds the whole tree, for the few cases that need one.
// For decoding into your own types, use `scarlet/json/decode`.
//
// Strict RFC 8259: no comments, trailing commas, `NaN` or trailing bytes.
// Duplicate keys are kept (`field` finds the first). An integer past 64 bits
// doesn't parse, and an unpaired surrogate escape like `\ud800` is an error.

// Opaque: a hand-built one would point at a node that does not exist.
pub opaque type Doc {
	arena Binary
	tape Binary
	idx Int
}

// `offset` is the byte the parser stopped at.
pub type ParseError {
	offset Int
	message String
}

// A number with no fraction or exponent is an `IntKind`, so big ids survive.
pub type Kind {
	NullKind
	BoolKind
	IntKind
	FloatKind
	StringKind
	ArrayKind
	ObjectKind
}

// A JSON tree, for building documents to send. Reading uses `Doc` instead.
// `Boolean`, `Integer` and `Real`, since `Bool`, `Int` and `Float` are taken.
pub type Json {
	Null
	Boolean(value Bool)
	Integer(value Int)
	Real(value Float)
	Str(value String)
	List(items Array(Json))
	Object(members Array((String, Json)))
	// Written as these digits, for a number that must not round through a
	// `Float`. `encode` writes `null` if `digits` is not a JSON number.
	Number(digits String)
}

@vm(json__parse_binary)
fn parse_binary_raw(src Binary) Result(Doc, ParseError)

@vm(json__kind)
fn kind_raw(d Doc) Int

@vm(json__len)
fn len_raw(d Doc) Int

// The first member named `name`. `None` means absent: a member set to `null`
// is `Some` of a `NullKind` doc. `json/decode`'s `Field` keeps the two apart.
@vm(json__field)
pub fn field(d Doc, name String) Option(Doc)

@vm(json__index)
pub fn index(d Doc, i Int) Option(Doc)

// In document order, duplicates included. Empty for a non-object.
@vm(json__entries)
pub fn entries(d Doc) Array((String, Doc))

// Already unescaped.
@vm(json__string)
pub fn string(d Doc) Option(String)

// `None` for a float.
@vm(json__int)
pub fn int(d Doc) Option(Int)

// The integer at `d` in decimal, for passing a number through as text.
@vm(json__int_text)
pub fn int_text(d Doc) Option(String)

// Integers included.
@vm(json__float)
pub fn float(d Doc) Option(Float)

@vm(json__bool)
pub fn bool(d Doc) Option(Bool)

@vm(json__encode)
pub fn encode(j Json) String

// Parse UTF-8 bytes, such as what came in over a socket.
pub fn parse_binary(src Binary) Result(Doc, ParseError) {
	parse_binary_raw(src)
}

pub fn parse(src String) Result(Doc, ParseError) {
	parse_binary_raw(binary.from_string(src))
}

// `kind_raw` is -1 for a tape that does not decode. That must read as the kind
// that grants least: `ObjectKind` would let `decode.optional_field` treat a
// corrupt document as an object missing a member.
pub fn kind(d Doc) Kind {
	match kind_raw(d) {
		0 -> NullKind
		1 -> BoolKind
		2 -> IntKind
		3 -> FloatKind
		4 -> StringKind
		5 -> ArrayKind
		6 -> ObjectKind
		_ -> NullKind
	}
}

// A missing member has no `Doc`, so this is only ever about a present `null`.
pub fn is_null(d Doc) Bool {
	kind_raw(d) == 0
}

// Elements of an array or members of an object. Zero for a scalar.
pub fn size(d Doc) Int {
	n = len_raw(d)
	if n < 0 { 0 } else { n }
}

// Empty for a non-array. One walk: calling `index` per element is O(n²) in a
// count the sender chooses.
@vm(json__elements)
pub fn elements(d Doc) Array(Doc)

// The whole document as a tree: an allocation per node, read or not. For
// passing a document through. To get your own types, decode off the `Doc`.
pub fn to_json(d Doc) Json {
	match kind(d) {
		NullKind -> Null
		BoolKind -> Boolean(option.unwrap(bool(d), False))
		// Never `0` as a default: a `reencode` would zero every id it touched.
		IntKind -> match int(d) {
			Some(i) -> Integer(i)
			None -> match int_text(d) {
				Some(digits) -> Number(digits)
				None -> Null
			}
		}
		FloatKind -> Real(option.unwrap(float(d), 0.0))
		StringKind -> Str(option.unwrap(string(d), ''))
		ArrayKind -> List(array_map_to_json(elements(d)))
		ObjectKind -> Object(entries_to_json(entries(d)))
	}
}

fn array_map_to_json(ds Array(Doc)) Array(Json) {
	match ds {
		[] -> []
		[head, ..tail] -> [to_json(head), ..array_map_to_json(tail)]
	}
}

fn entries_to_json(es Array((String, Doc))) Array((String, Json)) {
	match es {
		[] -> []
		[head, ..tail] -> {
			(k, v) = head
			[(k, to_json(v)), ..entries_to_json(tail)]
		}
	}
}

// Keeps key order and duplicate keys, drops whitespace.
pub fn reencode(d Doc) String {
	encode(to_json(d))
}

pub fn parse_error_message(e ParseError) String {
	ParseError(offset, message) = e
	'${message} (at byte ${offset})'
}

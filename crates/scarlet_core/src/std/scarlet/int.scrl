@vm(int__to_string)
pub fn to_string(n Int) String

// The raw form answers with `Option`, matching how the VM already builds
// `Option` values (the same split `binary.parse_int` uses below); `from_string`
// turns that into `Result` per the stdlib convention.
@vm(int__from_string)
fn from_string_raw(s String) Option(Int)

// The read side of `to_string`: an optional leading `+`/`-`, then one or more
// ASCII digits, and nothing else. `Err(Nil)` on empty input (with or without
// a bare sign), leading/trailing whitespace, or a non-digit anywhere —
// including a truncated tail such as `'20O'`. Leading zeros are accepted:
// `'007'` is `7`. An Int has no bounds, so no number of digits is too many,
// and every string `to_string` makes reads back to the same Int.
pub fn from_string(s String) Result(Int, Nil) {
	match from_string_raw(s) {
		Some(n) -> Ok(n)
		None -> Err(Nil)
	}
}

pub fn max(a Int, b Int) Int {
	if a > b { a } else { b }
}

pub fn min(a Int, b Int) Int {
	if a < b { a } else { b }
}

pub const min_value = 0 - 9223372036854775807 - 1

pub const max_value = 9223372036854775807

// Total: `abs` of Int min (whose negation does not fit in an Int) saturates
// to Int max rather than wrapping back to a negative value.
pub fn abs(n Int) Int {
	if n == min_value {
		max_value
	} else if n < 0 {
		0 - n
	} else {
		n
	}
}

// With inverted bounds (lo > hi), hi deterministically wins; for lo <= hi
// this is the usual clamp.
pub fn clamp(n Int, lo Int, hi Int) Int {
	min(max(n, lo), hi)
}

// `a / b`, except that a zero divisor is `Err(Nil)` rather than the operator's
// 0. Truncates toward zero, like `/`.
pub fn divide(a Int, b Int) Result(Int, Nil) {
	if b == 0 { Err(Nil) } else { Ok(a / b) }
}

// `a % b`, except that a zero divisor is `Err(Nil)` rather than the operator's
// `a`. The remainder takes the sign of `a`, like `%`.
pub fn remainder(a Int, b Int) Result(Int, Nil) {
	if b == 0 { Err(Nil) } else { Ok(a % b) }
}

// --- Bitwise ---------------------------------------------------------------
//
// Int is a 64-bit signed two's-complement integer — `min_value` and
// `max_value` above are its exact bounds — so these operate on 64 bits and
// there is no width to pick. All six are total: every input has a defined
// answer and nothing traps.

@vm(int__bitwise_and)
pub fn bitwise_and(a Int, b Int) Int

@vm(int__bitwise_or)
pub fn bitwise_or(a Int, b Int) Int

@vm(int__bitwise_xor)
pub fn bitwise_xor(a Int, b Int) Int

// The two's-complement complement, so it flips the sign bit along with the
// other 63: `bitwise_not(0) == -1` and `bitwise_not(n) == 0 - n - 1`. Int is
// signed with no unsigned counterpart, so complementing a small non-negative
// number gives a negative one — to keep a result inside a byte or a 32-bit
// field, mask it: `bitwise_and(bitwise_not(n), 255)`.
@vm(int__bitwise_not)
pub fn bitwise_not(n Int) Int

// Bits shifted off the top are discarded.
//
// A count of 64 or more shifts every bit out and gives 0. The count is NOT
// masked to 6 bits the way C and most hardware shift instructions do, so
// `bitwise_shift_left(1, 64)` is 0, not 1.
//
// A negative count shifts the other way by the same magnitude, so
// `bitwise_shift_left(x, 0 - n) == bitwise_shift_right(x, n)` for every `n`
// except `min_value`.
//
// `min_value` is the one count with no negation to appeal to: `0 - min_value`
// wraps back to `min_value`, so both sides saturate their count to `max_value`
// and land past the width in opposite directions. The left side shifts right
// and keeps the sign; the right side shifts left and drops it. For a negative
// `x` that is -1 against 0. Each side answers the call written correctly — it
// is the identity between them that stops there.
@vm(int__bitwise_shift_left)
pub fn bitwise_shift_left(x Int, n Int) Int

// Arithmetic (sign-propagating), not logical: the sign bit is copied into the
// vacated top bits, so `bitwise_shift_right(-8, 1) == -4` and a negative value
// never becomes positive.
//
// For logical behaviour, shift first and clear the copied sign bits after.
// For any `n` of 1 or more:
//
//	bitwise_and(bitwise_shift_right(x, n), bitwise_shift_right(max_value, n - 1))
//
// The second shift builds a mask of exactly the 64 - n bits a logical shift
// keeps. On `min_value` with `n` of 3 the idiom gives 1152921504606846976,
// against the -1152921504606846976 the bare arithmetic shift gives; on -1 with
// `n` of 32 it gives 4294967295, against -1. At `n == 0` the mask is `0 - 2`
// and clears bit 0, so start at 1.
//
// Masking the INPUT instead does not work, whatever the mask: no positive Int
// preserves bit 63, because the only mask that would is 2^64 - 1, which is -1
// and masks nothing. A mask of 255 on `min_value` shifted right by 3 gives 0
// where the logical shift gives 1152921504606846976 — it discards the top bits
// silently.
//
// Counts follow `bitwise_shift_left`: 64 or more shifts every bit out and
// leaves the sign — 0 for a non-negative `x`, -1 for a negative one — and a
// negative count shifts left instead.
@vm(int__bitwise_shift_right)
pub fn bitwise_shift_right(x Int, n Int) Int

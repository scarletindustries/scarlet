import scarlet/net/address
import scarlet/net/error
import scarlet/binary
import scarlet/time

pub type Connection

pub type Socket {
	conn Connection
	peer address.SocketAddress
}

// What a read got: some bytes (never empty), or the peer closed. A close is
// its own case, not an empty binary, so forgetting it is a compile error.
pub type Read {
	Data(bytes Binary)
	Closed
}

// Up to `max` bytes, parking until some arrive or the peer closes.
@vm(socket__read)
pub fn read(c Socket, max Int) Result(Read, error.NetError)

// Exactly `count` bytes, or `Err(UnexpectedEof)` if the peer closes first.
pub fn read_exact(c Socket, count Int) Result(Binary, error.NetError) {
	read_exact_loop(c, count, <<>>)
}

// `<= 0`, not `== 0`: `read` reads at least one byte, so a negative
// `remaining` would drain the socket.
fn read_exact_loop(c Socket, remaining Int, acc Binary) Result(Binary, error.NetError) {
	if remaining <= 0 {
		Ok(acc)
	} else {
		match read(c, remaining) {
			Ok(Data(b)) ->
				read_exact_loop(c, remaining - binary.byte_size(b), binary.append(acc, b))
			Ok(Closed) -> Err(error.UnexpectedEof)
			Err(e) -> Err(e)
		}
	}
}

// As `read`, but `Err(TimedOut)` after `timeout_ms` with no data.
pub fn read_within(c Socket, max Int, timeout_ms Int) Result(Read, error.NetError) {
	read_until(c, max, time.add_ms(time.monotonic(), timeout_ms))
}

// As `read_within`, with a `deadline` from `time.monotonic()`.
pub fn read_until(c Socket, max Int, deadline time.Instant) Result(Read, error.NetError) {
	read_until_ms(c, max, time.to_deadline_ms(deadline))
}

@vm(socket__read_until)
fn read_until_ms(c Socket, max Int, deadline_ms Int) Result(Read, error.NetError)

@vm(socket__write)
pub fn write(c Socket, data Binary) Result(Nil, error.NetError)

// One vectored write of every part, without joining them first.
@vm(socket__write_parts)
pub fn write_parts(c Socket, parts Array(Binary)) Result(Nil, error.NetError)

@vm(socket__close)
pub fn close(c Socket) Result(Nil, error.NetError)

// A network error. Most variants are an OS errno, named as in Rust's
// `std::io::ErrorKind`. `Errno` carries any errno without its own variant.
pub type NetError {
	// ETIMEDOUT, or a deadline passed.
	TimedOut
	// ECONNREFUSED
	ConnectionRefused
	// ECONNRESET
	ConnectionReset
	// ECONNABORTED
	ConnectionAborted
	// ENOTCONN
	NotConnected
	// EPIPE
	BrokenPipe
	// EADDRINUSE
	AddrInUse
	// EADDRNOTAVAIL
	AddrNotAvailable
	// ENETDOWN
	NetworkDown
	// ENETUNREACH
	NetworkUnreachable
	// EHOSTUNREACH
	HostUnreachable
	// EACCES, such as binding a privileged port.
	PermissionDenied
	// The peer closed before enough bytes arrived.
	UnexpectedEof
	// A message was bigger than the `limit` bytes the reader will buffer.
	MessageTooLarge(limit Int)
	// A write was given a binary that is not whole bytes.
	UnalignedBinary
	// The port was outside 0..=65535.
	InvalidPort
	Errno(code Int)
}

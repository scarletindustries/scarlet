import scarlet/net
import scarlet/net/address
import scarlet/net/error
import scarlet/net/socket
import scarlet/binary
import scarlet/result
import scarlet/time

// A TLS client connection. A separate type from a cleartext socket, so
// writing to the unencrypted one by mistake is a type error.
pub type TlsConnection

// `server_name` is only what `handshake` was given, and anyone can build a
// `TlsSocket`, so it proves nothing. A connection pool must key on the name it
// passed to `handshake` itself.
pub type TlsSocket {
	conn TlsConnection
	peer address.SocketAddress
	server_name String
}

// A caller may retry `Transport`, never a certificate error. On purpose, there
// is no way to skip verification: to trust a private CA, add it to the
// machine's trust store.
pub type TlsError {
	// The chain did not end at a trusted root.
	CertificateUnknownIssuer
	// The certificate is outside its validity window.
	CertificateExpired
	CertificateNotYetValid
	// The issuer published the certificate as revoked.
	CertificateRevoked
	// The chain verified, but not for the name asked for.
	HostnameMismatch
	// Malformed, a refused signature algorithm, or any other failed check.
	BadCertificate
	// The peer does not speak TLS, or only a version or cipher suite this
	// refuses. It is what connecting to a plain `http` port looks like.
	ProtocolError
	// A fatal alert, or a handshake failure that is not about the certificate.
	HandshakeFailed
	// `server_name` is neither a DNS name nor an IP address. An IP address is
	// checked against the certificate's IP SANs.
	InvalidServerName
	Transport(cause error.NetError)
}

// Connects and finishes the handshake, verifying the certificate against
// `host`. Sessions are cached in memory, never on disk. No deadline: a peer
// that never speaks TLS parks it for good, so prefer `connect_within`.
pub fn connect(host String, port Int) Result(TlsSocket, TlsError) {
	sock <- result.then(result.map_err(net.connect(host, port), Transport))
	handshake(sock, host)
}

// As `connect`, but `Err(Transport(TimedOut))` after `timeout_ms`, for all
// three steps together.
pub fn connect_within(host String, port Int, timeout_ms Int) Result(TlsSocket, TlsError) {
	connect_until(host, port, time.add_ms(time.monotonic(), timeout_ms))
}

// As `connect_within`, with a `deadline` from `time.monotonic()`, shared by
// all three steps.
pub fn connect_until(host String, port Int, deadline time.Instant) Result(TlsSocket, TlsError) {
	sock <- result.then(result.map_err(net.connect_until(host, port, deadline), Transport))
	handshake_until(sock, host, deadline)
}

// A TLS handshake over a connected socket, such as a STARTTLS upgrade. It
// consumes `sock`: every cleartext call on it errs with `NotConnected` after.
// No deadline: prefer `handshake_within`.
@vm(tls__handshake)
pub fn handshake(sock socket.Socket, server_name String) Result(TlsSocket, TlsError)

// As `handshake`, but `Err(Transport(TimedOut))` after `timeout_ms`. A timeout
// closes the connection, so there is nothing to retry on.
pub fn handshake_within(
	sock socket.Socket,
	server_name String,
	timeout_ms Int,
) Result(TlsSocket, TlsError) {
	handshake_until(sock, server_name, time.add_ms(time.monotonic(), timeout_ms))
}

// As `handshake_within`, with a `deadline` from `time.monotonic()`.
pub fn handshake_until(
	sock socket.Socket,
	server_name String,
	deadline time.Instant,
) Result(TlsSocket, TlsError) {
	handshake_until_ms(sock, server_name, time.to_deadline_ms(deadline))
}

@vm(tls__handshake_until)
fn handshake_until_ms(
	sock socket.Socket,
	server_name String,
	deadline_ms Int,
) Result(TlsSocket, TlsError)

// Up to `max` bytes of plaintext, parking until some arrive. `Closed` does not
// prove the peer meant to stop: a cut connection looks the same. Use a length
// or a terminator, as `read_exact` does, when that matters.
@vm(tls__read)
pub fn read(c TlsSocket, max Int) Result(socket.Read, TlsError)

// Exactly `count` bytes, or `Err(Transport(UnexpectedEof))` if the peer closes
// first.
pub fn read_exact(c TlsSocket, count Int) Result(Binary, TlsError) {
	read_exact_loop(c, count, <<>>)
}

// `<= 0`, not `== 0`: `read` reads at least one byte, so a negative
// `remaining` would drain the connection.
fn read_exact_loop(c TlsSocket, remaining Int, acc Binary) Result(Binary, TlsError) {
	if remaining <= 0 {
		Ok(acc)
	} else {
		match read(c, remaining) {
			Ok(socket.Data(b)) ->
				read_exact_loop(c, remaining - binary.byte_size(b), binary.append(acc, b))
			Ok(socket.Closed) -> Err(Transport(error.UnexpectedEof))
			Err(e) -> Err(e)
		}
	}
}

// As `read`, but `Err(Transport(TimedOut))` after `timeout_ms` with no
// plaintext.
pub fn read_within(c TlsSocket, max Int, timeout_ms Int) Result(socket.Read, TlsError) {
	read_until(c, max, time.add_ms(time.monotonic(), timeout_ms))
}

// As `read_within`, with a `deadline` from `time.monotonic()`.
pub fn read_until(c TlsSocket, max Int, deadline time.Instant) Result(socket.Read, TlsError) {
	read_until_ms(c, max, time.to_deadline_ms(deadline))
}

@vm(tls__read_until)
fn read_until_ms(c TlsSocket, max Int, deadline_ms Int) Result(socket.Read, TlsError)

// Returns once the ciphertext reaches the kernel, so a caller that writes and
// then waits for a reply cannot deadlock on bytes still in the TLS session.
@vm(tls__write)
pub fn write(c TlsSocket, data Binary) Result(Nil, TlsError)

// Sends `close_notify` and closes. It closes either way: `Err` only means the
// peer was not told, and may see a truncation.
@vm(tls__close)
pub fn close(c TlsSocket) Result(Nil, TlsError)

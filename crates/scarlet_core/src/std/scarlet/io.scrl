import scarlet/binary
import scarlet/result

// A file error. Most variants are an OS errno, named as in Rust's
// `std::io::ErrorKind`. `Errno` carries any errno without its own variant.
pub type IoError {
	// ENOENT
	NotFound(path String)
	// EACCES
	PermissionDenied(path String)
	// EEXIST
	AlreadyExists(path String)
	// ENOTDIR
	NotADirectory(path String)
	// EISDIR
	IsADirectory(path String)
	// EROFS
	ReadOnlyFilesystem(path String)
	// ELOOP: too many symbolic links.
	FilesystemLoop(path String)
	// The contents do not suit the call, such as text that is not UTF-8.
	InvalidData(path String)
	// ENOSPC
	StorageFull
	// EDQUOT
	QuotaExceeded
	// EFBIG
	FileTooLarge(path String)
	// A write was given a binary that is not whole bytes.
	UnalignedBinary
	Errno(code Int)
}

@vm(io__read_file)
pub fn read_file(path String) Result(Binary, IoError)

@vm(io__write_file)
pub fn write_file(path String, data Binary) Result(Nil, IoError)

pub fn read_text(path String) Result(String, IoError) {
	b <- result.then(read_file(path))
	result.replace_err(binary.to_string(b), InvalidData(path))
}

pub fn write_text(path String, s String) Result(Nil, IoError) {
	write_file(path, binary.from_string(s))
}

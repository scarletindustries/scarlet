/**
 * A port is a child OS process that the program talks to over its stdio.
 * Native code runs there, outside the runtime, so it can't stall or corrupt
 * it.
 *
 * A port reads and writes like a Socket: `read` reads the child's stdout and
 * `write` writes its stdin. Its stderr is inherited. A port closes when the
 * process that spawned it ends. Closing closes both pipes, then sends SIGTERM
 * after a second and SIGKILL five seconds later, so no child outlives its port.
 */
import scarlet/binary
import scarlet/io
import scarlet/map
import scarlet/net/error
import scarlet/net/socket
import scarlet/time

// A running child process. `os_pid` is only for logs, because the runtime owns
// the child.
pub opaque type Port {
	conn socket::Connection
	os_pid Int
}

pub type ExitStatus {
	Exited(code Int)
	// This includes the runtime's own SIGTERM (15) or SIGKILL (9) on a close.
	Signaled(signal Int)
}

// Starts `program` with `args` and the inherited environment. A name is looked
// up on the PATH, as a shell does. If the program can't start, you get the
// OS's `IoError` and nothing is left running.
pub fn spawn(program String, args Array(String)) Result(Port, io::IoError) {
	spawn_env(program, args, map::new())
}

// Like `spawn`, but adds `env` over the inherited environment.
pub fn spawn_env(
	program String,
	args Array(String),
	env map::Map(String, String),
) Result(Port, io::IoError) {
	spawn_with(program, args, map::to_list(env))
}

@vm(port__spawn)
fn spawn_with(
	program String,
	args Array(String),
	env Array((String, String)),
) Result(Port, io::IoError)

// Reads up to `max` bytes of the child's stdout. `Ok(Closed)` almost always
// means it exited, and `close` tells you how.
@vm(port__read)
pub fn read(p Port, max Int) Result(socket::Read, error::NetError)

// Reads exactly `count` bytes, or returns `Err(UnexpectedEof)` if the child
// closes its stdout first.
pub fn read_exact(p Port, count Int) Result(Binary, error::NetError) {
	read_exact_loop(p, count, <<>>)
}

fn read_exact_loop(p Port, remaining Int, acc Binary) Result(Binary, error::NetError) {
	if remaining <= 0 {
		Ok(acc)
	} else {
		match read(p, remaining) {
			Ok(socket::Data(b)) ->
				read_exact_loop(p, remaining - binary::byte_size(b), binary::append(acc, b))
			Ok(socket::Closed) -> Err(error::UnexpectedEof)
			Err(e) -> Err(e)
		}
	}
}

// Like `read`, but returns `Err(TimedOut)` if there's nothing to read within
// `timeout_ms`.
pub fn read_within(p Port, max Int, timeout_ms Int) Result(socket::Read, error::NetError) {
	read_until(p, max, time::add_ms(time::monotonic(), timeout_ms))
}

// Like `read_within`, but takes a `deadline` from `time::monotonic()`.
pub fn read_until(p Port, max Int, deadline time::Instant) Result(socket::Read, error::NetError) {
	read_until_ms(p, max, time::to_deadline_ms(deadline))
}

@vm(port__read_until)
fn read_until_ms(p Port, max Int, deadline_ms Int) Result(socket::Read, error::NetError)

// Writes to the child's stdin, parking while the pipe is full. Writing to a
// child that has exited gives `BrokenPipe`.
@vm(port__write)
pub fn write(p Port, data Binary) Result(Nil, error::NetError)

// Writes every part in one vectored write, without joining them first.
@vm(port__write_parts)
pub fn write_parts(p Port, parts Array(Binary)) Result(Nil, error::NetError)

// Closes the port and parks until the child has ended, signalling it as the
// module doc says. Parked reads and writes fail at once. Closing twice gives
// `NotConnected`.
@vm(port__close)
pub fn close(p Port) Result(ExitStatus, error::NetError)

/**
 * Ports: child processes the program starts, talks to over their stdio, and
 * takes down. A port is how a Scarlet program uses native code — a tokenizer,
 * a metrics exporter, a worker written in another language — without ever
 * running it inside the runtime: the child is a separate OS process, so it can
 * neither stall a scheduler nor corrupt the program, and if it dies the program
 * finds out the same way it finds out about a closed connection.
 *
 * A port reads and writes exactly like a Socket — read/read_within/write/
 * write_parts, with the same Read and NetError types — because to the runtime
 * it is one: the child's stdout is what read reads and its stdin is what write
 * writes. Framing is the program's concern, as on a socket. The child's stderr
 * is inherited, so its diagnostics appear alongside the program's own.
 *
 * A port belongs to the process that spawned it and is closed when that
 * process ends, exactly like a connection. Closing a port — explicitly with
 * close, or by the owner ending — closes both pipes, which a well-behaved
 * child sees as end of input and exits on; one that is still running a second
 * later is sent SIGTERM, and one still running five seconds after that is
 * killed. Nothing a child does can leave it running after its port is gone.
 */
import scarlet/binary
import scarlet/io
import scarlet/map
import scarlet/net/error
import scarlet/net/socket
import scarlet/time

// A running child. `os_pid` is the child's operating-system process id, for
// logs and diagnostics; the runtime owns the child, so there is nothing to do
// with the number beyond reporting it.
pub opaque type Port {
	conn socket.Connection
	os_pid Int
}

// How a closed port's child ended.
pub type ExitStatus {
	// It exited, with this exit code.
	Exited(code Int)
	// It was ended by this signal — including by the runtime's own SIGTERM
	// (15) or SIGKILL (9) if it outstayed a close.
	Signaled(signal Int)
}

// Start `program` with `args`, inheriting the environment. `program` is
// resolved the way a shell would resolve it: a name is looked up on the PATH,
// a path is used as written. Parks the calling process until the child has
// been started; a program that cannot be started is reported as the IoError
// the operating system gave — NotFound(program), PermissionDenied(program),
// or an Errno — and nothing is left running.
pub fn spawn(program String, args Array(String)) Result(Port, io.IoError) {
	spawn_env(program, args, map.new())
}

// As `spawn`, with `env` added to the inherited environment; a variable named
// in `env` overrides the inherited value.
pub fn spawn_env(program String, args Array(String), env map.Map(String, String)) Result(Port, io.IoError) {
	spawn_with(program, args, map.to_list(env))
}

@vm(port__spawn)
fn spawn_with(program String, args Array(String), env Array((String, String))) Result(Port, io.IoError)

// Read whatever the child has written, up to `max` bytes, parking until at
// least one byte arrives. `Ok(Closed)` means the child closed its stdout —
// almost always because it exited; `close` then reports how.
@vm(port__read)
pub fn read(p Port, max Int) Result(socket.Read, error.NetError)

// Read exactly `count` bytes, parking until they have all arrived. Errs with
// UnexpectedEof if the child closes its stdout first. A `count` of zero or
// less asks for nothing and returns Ok(<<>>) without touching the port.
pub fn read_exact(p Port, count Int) Result(Binary, error.NetError) {
	read_exact_loop(p, count, <<>>)
}

fn read_exact_loop(p Port, remaining Int, acc Binary) Result(Binary, error.NetError) {
	if remaining <= 0 {
		Ok(acc)
	} else {
		match read(p, remaining) {
			Ok(socket.Data(b)) ->
				read_exact_loop(p, remaining - binary.byte_size(b), binary.append(acc, b))
			Ok(socket.Closed) -> Err(error.UnexpectedEof)
			Err(e) -> Err(e)
		}
	}
}

// As `read`, but gives up with Err(TimedOut) once `timeout_ms` milliseconds
// have passed with nothing to read. The deadline is captured once, up front.
pub fn read_within(p Port, max Int, timeout_ms Int) Result(socket.Read, error.NetError) {
	read_until(p, max, time.add_ms(time.monotonic(), timeout_ms))
}

// As `read`, but errs with TimedOut once the absolute Instant `deadline`
// (from `time.monotonic()`) is reached.
pub fn read_until(p Port, max Int, deadline time.Instant) Result(socket.Read, error.NetError) {
	read_until_ms(p, max, time.to_deadline_ms(deadline))
}

@vm(port__read_until)
fn read_until_ms(p Port, max Int, deadline_ms Int) Result(socket.Read, error.NetError)

// Write `data` to the child's stdin, parking while its pipe is full. A child
// that has exited is reported as BrokenPipe.
@vm(port__write)
pub fn write(p Port, data Binary) Result(Nil, error.NetError)

// Write every binary in `parts` to the child's stdin as one vectored write.
@vm(port__write_parts)
pub fn write_parts(p Port, parts Array(Binary)) Result(Nil, error.NetError)

// Close the port and collect the child, parking until it has ended: its pipes
// are closed at once, and it is signalled on the schedule described above if
// it does not exit on its own. Returns how it ended. Any read or write parked
// on the port fails immediately. Closing a port twice errs with NotConnected,
// as closing a socket twice does. A process that must not wait — a supervisor
// with other work — can spawn a process to do the closing.
@vm(port__close)
pub fn close(p Port) Result(ExitStatus, error.NetError)

/**
 * Decodes CBOR (RFC 8949), but only the subset that COSE keys and WebAuthn
 * carry: integers, byte and text strings, arrays and maps.
 *
 * Floats, tags and indefinite lengths give `Unsupported` instead of a guess,
 * and a map that repeats a key is refused. Map keys stay `Value`s, because
 * COSE labels are integers (`alg` is 3, the EC coordinates are -2 and -3).
 */

import scarlet/array
import scarlet/binary
import scarlet/int
import scarlet/result
import scarlet/option

pub type Value {
	Uint(value Int)
	/** A negative integer, held as its actual negative value. */
	Nint(value Int)
	Bytes(value Binary)
	Text(value String)
	List(items Array(Value))
	Map(entries Array((Value, Value)))
}

/** Why `decode` stopped. `at` is the byte offset of the item at fault. */
pub type Error {
	/** The input ends inside the item. */
	Truncated(at Int)
	/** Not well-formed CBOR (RFC 8949 §3): a reserved additional-info value,
	 * or an indefinite length or break where none can be. */
	Malformed(at Int)
	/** Well-formed, but outside this subset: a tag, a float or simple value,
	 * or an indefinite-length string, array or map. */
	Unsupported(at Int)
	/** A text string that is not UTF-8. */
	NotUtf8(at Int)
	/** A map key equal to an earlier key of the same map. */
	DuplicateKey(at Int)
	/** `decode` read one whole item, and more bytes follow it. */
	TrailingData(at Int)
}

/** Decodes exactly one item, with nothing after it. Use `decode_prefix` when
 * more may follow. */
pub fn decode(b Binary) Result(Value, Error) {
	(value, end) <- result::then(decode_prefix(b, 0))
	if end == binary::byte_size(b) {
		Ok(value)
	} else {
		Err(TrailingData(end))
	}
}

/** Decodes the item at `at` and returns it with the offset just past it. */
pub fn decode_prefix(b Binary, at Int) Result((Value, Int), Error) {
	if at >= binary::byte_size(b) {
		Err(Truncated(at))
	} else {
		ib = binary::byte_at(b, at)
		major = int::bitwise_shift_right(ib, 5)
		info = int::bitwise_and(ib, 31)
		(arg, body) <- result::then(argument(b, at, major, info))
		read_item(b, major, arg, body, at)
	}
}

// The argument is `info` itself for 0-23, or the next 1, 2, 4 or 8 bytes for
// 24-27. `start` is the item's first byte.
fn argument(b Binary, start Int, major Int, info Int) Result((Int, Int), Error) {
	if info < 24 {
		Ok((info, start + 1))
	} else if info == 24 {
		be(b, start, 1)
	} else if info == 25 {
		be(b, start, 2)
	} else if info == 26 {
		be(b, start, 4)
	} else if info == 27 {
		be(b, start, 8)
	} else if info == 31 && major >= 2 && major <= 5 {
		Err(Unsupported(start))
	} else {
		// 28-30 are reserved. 31 means nothing on an integer or a tag, and as a
		// break (major 7) it can only end an indefinite-length item, which this
		// never opens.
		Err(Malformed(start))
	}
}

fn be(b Binary, start Int, n Int) Result((Int, Int), Error) {
	if start + 1 + n > binary::byte_size(b) {
		Err(Truncated(start))
	} else {
		Ok((be_from(b, start + 1, n, 0), start + 1 + n))
	}
}

fn be_from(b Binary, at Int, left Int, acc Int) Int {
	if left <= 0 {
		acc
	} else {
		be_from(b, at + 1, left - 1, acc * 256 + binary::byte_at(b, at))
	}
}

fn read_item(b Binary, major Int, arg Int, body Int, start Int) Result((Value, Int), Error) {
	if major == 0 {
		Ok((Uint(arg), body))
	} else if major == 1 {
		Ok((Nint(0 - 1 - arg), body))
	} else if major == 2 {
		result::map(content(b, body, arg, start), fn(s) (Bytes(s), body + arg))
	} else if major == 3 {
		slice <- result::then(content(b, body, arg, start))
		match binary::to_string(slice) {
			Ok(s) -> Ok((Text(s), body + arg))
			Err(Nil) -> Err(NotUtf8(start))
		}
	} else if major == 4 {
		read_list(b, body, arg, [])
	} else if major == 5 {
		read_map(b, body, arg, [])
	} else {
		// Major types 6 (tags) and 7 (floats and simple values) aren't part of
		// this subset.
		Err(Unsupported(start))
	}
}

// The `n` content bytes at `at` of the string that starts at `start`.
fn content(b Binary, at Int, n Int, start Int) Result(Binary, Error) {
	match binary::slice_bytes(b, at, n) {
		Ok(s) -> Ok(s)
		Err(Nil) -> Err(Truncated(start))
	}
}

fn read_list(b Binary, at Int, left Int, acc Array(Value)) Result((Value, Int), Error) {
	if left <= 0 {
		Ok((List(acc), at))
	} else {
		(value, next) <- result::then(decode_prefix(b, at))
		read_list(b, next, left - 1, [..acc, value])
	}
}

// A repeated key is refused, not resolved: two readers that keep different
// copies would disagree about what the map says.
fn read_map(b Binary, at Int, left Int, acc Array((Value, Value))) Result((Value, Int), Error) {
	if left <= 0 {
		Ok((Map(acc), at))
	} else {
		(k, after_key) <- result::then(decode_prefix(b, at))
		if array::any(acc, fn(e) {
			(seen, _) = e
			seen == k
		}) {
			Err(DuplicateKey(at))
		} else {
			(v, after_val) <- result::then(decode_prefix(b, after_key))
			read_map(b, after_val, left - 1, [..acc, (k, v)])
		}
	}
}

/** Looks up the value for an integer label, as COSE keys use. It matches both
 * `Uint` and `Nint` keys. */
pub fn map_get(v Value, label Int) Option(Value) {
	match v {
		Map(entries) -> option::map(
			array::find(entries, fn(e) {
				(k, _) = e
				as_int(k) == Some(label)
			}),
			fn(e) {
				(_, val) = e
				val
			},
		)
		Uint(_) | Nint(_) | Bytes(_) | Text(_) | List(_) -> None
	}
}

pub fn as_int(v Value) Option(Int) {
	match v {
		Uint(n) | Nint(n) -> Some(n)
		Bytes(_) | Text(_) | List(_) | Map(_) -> None
	}
}

/** Looks up the value for a text label, as the WebAuthn attestation object
 * uses. */
pub fn text_map_get(v Value, label String) Option(Value) {
	match v {
		Map(entries) -> option::map(
			array::find(entries, fn(e) {
				(k, _) = e
				k == Text(label)
			}),
			fn(e) {
				(_, val) = e
				val
			},
		)
		Uint(_) | Nint(_) | Bytes(_) | Text(_) | List(_) -> None
	}
}

pub fn as_bytes(v Value) Option(Binary) {
	match v {
		Bytes(b) -> Some(b)
		Uint(_) | Nint(_) | Text(_) | List(_) | Map(_) -> None
	}
}

pub fn as_text(v Value) Option(String) {
	match v {
		Text(s) -> Some(s)
		Uint(_) | Nint(_) | Bytes(_) | List(_) | Map(_) -> None
	}
}

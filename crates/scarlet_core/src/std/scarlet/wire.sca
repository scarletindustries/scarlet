/**
 * Values as bytes. `encode` turns any value into a Binary, and `decode` reads
 * one back as the type the call site uses.
 *
 * The compiler puts a descriptor of that type into the program, so `decode`
 * never guesses: `Ok(x)` is exactly the type asked for, and bad bytes are a
 * `DecodeError`. Bytes follow a type's shape, not its name. Handles and
 * closures only decode in the run that made them.
 *
 * The byte format is in docs/wire-format.md.
 */

@vm(wire__encode)
pub fn encode(value a) Binary

// The type must be known where `decode` is called.
@vm(wire__decode)
pub fn decode(bytes Binary) Result(a, DecodeError)

pub type DecodeError {
	Truncated
	// Not from `wire.encode`, or from a format version this runtime can't read.
	NotWire
	// Written from a type of another shape. Both fingerprints.
	SchemaMismatch(expected Int, found Int)
	// Bytes that don't hold a value of the type. `offset` is where it went wrong.
	Malformed(offset Int, what String)
	// A whole value followed by more bytes: a caller framing messages lost sync.
	TrailingBytes(count Int)
	// A handle or closure from another run. `expected` is this run's identity,
	// `found` the one in the bytes.
	OtherRun(expected Binary, found Binary)
}

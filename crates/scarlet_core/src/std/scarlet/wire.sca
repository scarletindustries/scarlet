/**
 * Values as bytes. `encode` turns any value into a Binary, and `decode` reads
 * one back as the type the call site uses.
 *
 * The compiler puts a descriptor of that type into the program, so `decode`
 * never guesses: `Ok(x)` is exactly the type asked for, and bad bytes are a
 * `DecodeError`. Bytes follow a type's shape, not its name. Handles and
 * closures only decode in the run that made them.
 *
 * The byte format is in docs/wire-format.md.
 */

@vm(wire__encode)
pub fn encode(value a) Binary

// The type must be known where `decode` is called.
@vm(wire__decode)
pub fn decode(bytes Binary) Result(a, DecodeError)

pub type DecodeError {
	Truncated
	// Not from `wire.encode`, or from a format version this runtime can't read.
	NotWire
	// The bytes were written from a type of a different shape. It carries both
	// types' fingerprints.
	SchemaMismatch(expected Int, found Int)
	// The bytes don't hold a value of the type. `offset` is where it went
	// wrong, and `why` says what was wrong there.
	Malformed(offset Int, why Malformation)
	// A whole value was followed by more bytes. This usually means a caller
	// that frames messages has lost sync.
	TrailingBytes(count Int)
	// The bytes hold a handle or closure from another run. `expected` is this
	// run's identity and `found` is the one in the bytes.
	OtherRun(expected Binary, found Binary)
}

// What was wrong at the offset of a `Malformed`.
pub type Malformation {
	// A count is larger than the bytes left could hold.
	CountTooLarge
	// A handle's kind is one the type doesn't allow.
	WrongHandleKind
	// A handle's id is too big for its kind.
	IdTooLarge
	// A closure's function index names no function.
	NoSuchFunction
	// A closure's function takes a different number of arguments than its
	// type says.
	ArityMismatch
	// A closure's capture count isn't its function's.
	CaptureCountMismatch
	// A capture's tag isn't in the capture table.
	UnknownCaptureTag
	// A variant tag names no variant of the type.
	UnknownVariant
	// A `Bool` byte is neither 0 nor 1.
	NotABool
	// The type has no values, so no bytes can hold one.
	Uninhabited
}

/**
 * Two clocks, not to be mixed up.
 *
 * `monotonic()` only moves forward, so it is the one for durations and
 * deadlines. Its `Instant` is opaque, so nothing else can pass for a deadline.
 *
 * `epoch_ms()` is the wall clock: the date, for timestamps that leave the
 * program. It can jump either way, so never measure a duration with it.
 */

pub opaque type Instant {
	ms Int
}

@vm(time__monotonic)
fn monotonic_ms() Int

pub fn monotonic() Instant {
	Instant(monotonic_ms())
}

pub fn add_ms(t Instant, ms Int) Instant {
	match t {
		Instant(n) -> Instant(n + ms)
	}
}

// The deadline `ms` milliseconds from now.
pub fn deadline_in_ms(ms Int) Instant {
	Instant(monotonic_ms() + ms)
}

// Milliseconds from `earlier` to `later`, negative if `later` is before it.
pub fn since_ms(later Instant, earlier Instant) Int {
	match (later, earlier) {
		(Instant(a), Instant(b)) -> a - b
	}
}

// Raw monotonic milliseconds, for the VM's built-ins. Prefer `since_ms`.
pub fn to_deadline_ms(t Instant) Int {
	match t {
		Instant(n) -> n
	}
}

// Milliseconds since 1970-01-01T00:00:00Z, negative before it. It can jump, so
// use `monotonic()` for durations.
@vm(time__epoch_ms)
pub fn epoch_ms() Int

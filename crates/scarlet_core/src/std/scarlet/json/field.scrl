// The three states of a JSON object member, which a partial update treats
// differently:
//
//   absent   the sender didn't mention it: leave it as it is
//   null     the sender cleared it: remove the value
//   present  the sender set it: use the new value
//
// `Option` would merge the first two and wipe data. `Field` is opaque so it
// can't be merged by accident: use `update`, or `fold` for one branch each.

@exhaustive
pub opaque type Field(a) {
	Absent
	Null
	Present(value a)
}

pub fn absent() Field(a) {
	Absent
}

pub fn null() Field(a) {
	Null
}

pub fn present(value a) Field(a) {
	Present(value)
}

// One branch per state, so merging two is something you write on purpose.
pub fn fold(f Field(a), on_absent fn() b, on_null fn() b, on_present fn(a) b) b {
	match f {
		Absent -> on_absent()
		Null -> on_null()
		Present(x) -> on_present(x)
	}
}

// A partial update of `current`: absent keeps it, null clears it, present
// replaces it.
pub fn update(f Field(a), current Option(a)) Option(a) {
	match f {
		Absent -> current
		Null -> None
		Present(x) -> Some(x)
	}
}

// `Err(Nil)` for absent and for null.
pub fn require(f Field(a)) Result(a, Nil) {
	match f {
		Absent -> Err(Nil)
		Null -> Err(Nil)
		Present(x) -> Ok(x)
	}
}

pub fn map(f Field(a), g fn(a) b) Field(b) {
	match f {
		Absent -> Absent
		Null -> Null
		Present(x) -> Present(g(x))
	}
}

pub fn is_absent(f Field(a)) Bool {
	match f {
		Absent -> True
		Null -> False
		Present(_) -> False
	}
}

pub fn is_null(f Field(a)) Bool {
	match f {
		Absent -> False
		Null -> True
		Present(_) -> False
	}
}

pub fn is_present(f Field(a)) Bool {
	match f {
		Absent -> False
		Null -> False
		Present(_) -> True
	}
}

import scarlet/binary
// These are aliased because `int` and `field` are also functions here.
import scarlet/int as integer
import scarlet/json
import scarlet/json/field as presence

// Turns a parsed document into your own types. A `Decoder(a)` reads a `Doc`
// and gives an `a`, or every failure with the path where it happened.
//
//     fn user() Decoder(User) {
//         id <- decode.take('id', decode.int_string())
//         nick <- decode.take_optional('nickname', decode.string_value())
//         decode.succeed(User(id: id, nickname: nick))
//     }
//
// Every member is checked even after one fails. `then` is the exception. What
// comes next depends on the value, so it stops at the first failure.

pub type Segment {
	Key(name String)
	At(index Int)
}

// What the document held where a failure happened.
pub type Found {
	FoundKind(kind json::Kind)
	FoundAbsent
	// The right kind with the wrong content, like a quoted integer that isn't
	// one.
	FoundText(text String)
}

// `expected` is a `String` because a caller's own decoder may want anything,
// such as "a positive integer".
pub type Failure {
	path Array(Segment)
	expected String
	found Found
}

// A stand-in value after a failure, so the members after it still get checked.
// It never reaches the caller, because a run that uses one returns `Err`.
// `fail` has no value to offer, so it answers `Halt`.
type Recovery(a) {
	Resume(value a)
	Halt
}

// A path is only built on failure. `resume` is a thunk so a success never
// builds the rest of a `take` chain once per member.
pub opaque type Decoder(a) {
	step fn(json::Doc) Result(a, Array(Failure))
	resume fn() Recovery(a)
}

pub fn run(dec Decoder(a), doc json::Doc) Result(a, Array(Failure)) {
	run_at(dec, doc)
}

fn run_at(dec Decoder(a), doc json::Doc) Result(a, Array(Failure)) {
	Decoder(step, _) = dec
	step(doc)
}

fn prefix_path(fs Array(Failure), seg Segment) Array(Failure) {
	match fs {
		[] -> []
		[Failure(path, expected, found), ..tail] ->
			[Failure([seg, ..path], expected, found), ..prefix_path(tail, seg)]
	}
}

fn recovery(dec Decoder(a)) Recovery(a) {
	Decoder(_, resume) = dec
	resume()
}

// Formats a path like `.field.list[3].name`, or `<root>` for the top level.
pub fn path_to_string(path Array(Segment)) String {
	match path {
		[] -> '<root>'
		[head, ..tail] -> '${segment_to_string(head)}${path_to_string_rest(tail)}'
	}
}

fn path_to_string_rest(path Array(Segment)) String {
	match path {
		[] -> ''
		[head, ..tail] -> '${segment_to_string(head)}${path_to_string_rest(tail)}'
	}
}

fn segment_to_string(s Segment) String {
	match s {
		Key(k) -> '.${k}'
		At(i) -> '[${i}]'
	}
}

// Formats a failure as one line saying where it happened, what was wanted and
// what was there.
pub fn failure_to_string(f Failure) String {
	Failure(path, expected, found) = f
	'${path_to_string(path)}: expected ${expected}, found ${found_to_string(found)}'
}

pub fn failures_to_string(fs Array(Failure)) String {
	match fs {
		[] -> ''
		[head, ..tail] -> match tail {
			[] -> failure_to_string(head)
			_ -> '${failure_to_string(head)}\n${failures_to_string(tail)}'
		}
	}
}

pub fn found_to_string(f Found) String {
	match f {
		FoundKind(k) -> kind_to_string(k)
		FoundAbsent -> 'no such member'
		FoundText(t) -> t
	}
}

fn kind_to_string(k json::Kind) String {
	match k {
		json::NullKind -> 'null'
		json::BoolKind -> 'a boolean'
		json::IntKind -> 'an integer'
		json::FloatKind -> 'a float'
		json::StringKind -> 'a string'
		json::ArrayKind -> 'an array'
		json::ObjectKind -> 'an object'
	}
}

fn one_failure(expected String, d json::Doc) Array(Failure) {
	[Failure([], expected, FoundKind(json::kind(d)))]
}

pub fn succeed(value a) Decoder(a) {
	Decoder(step: fn(_doc) Ok(value), resume: fn() Resume(value))
}

// Always fails, naming what it wanted. It needs no `a`, and stops the members
// after it from being checked.
pub fn fail(expected String) Decoder(a) {
	Decoder(step: fn(doc) Err(one_failure(expected, doc)), resume: fn() Halt)
}

// This is the one place a stand-in value is written down instead of derived.
fn scalar(expected String, resume_with a, read fn(json::Doc) Option(a)) Decoder(a) {
	Decoder(
		step: fn(doc) match read(doc) {
			Some(v) -> Ok(v)
			None -> Err(one_failure(expected, doc))
		},
		resume: fn() Resume(resume_with),
	)
}

pub fn string_value() Decoder(String) {
	scalar('a string', '', json::string)
}

// A float fails here, even one with no fraction.
pub fn int() Decoder(Int) {
	scalar('an integer', 0, json::int)
}

pub fn float() Decoder(Float) {
	scalar('a number', 0.0, json::float)
}

pub fn bool() Decoder(Bool) {
	scalar('a boolean', False, json::bool)
}

// Decodes an integer sent as a JSON string. Protocols do this for 64-bit ids,
// like Discord snowflakes, that a double would round. A leading `-` is fine,
// but `+` isn't.
pub fn int_string() Decoder(Int) {
	Decoder(
		step: fn(doc) match json::string(doc) {
			None -> Err(one_failure('a quoted integer', doc))
			Some(s) -> match parse_signed(s) {
				Ok(n) -> Ok(n)
				Err(Nil) -> Err([Failure([], 'a quoted integer', FoundText('the string "${s}"'))])
			}
		},
		resume: fn() Resume(0),
	)
}

// `int.from_string` takes a leading `+`, but JSON numbers never have one. 43
// is `+`.
fn parse_signed(s String) Result(Int, Nil) {
	if binary::byte_at(binary::from_string(s), 0) == 43 {
		Err(Nil)
	} else {
		integer::from_string(s)
	}
}

// Decodes `null` as `value`.
pub fn null_as(value a) Decoder(a) {
	Decoder(
		step: fn(doc) if json::is_null(doc) {
			Ok(value)
		} else {
			Err(one_failure('null', doc))
		},
		resume: fn() Resume(value),
	)
}

pub fn map(dec Decoder(a), f fn(a) b) Decoder(b) {
	Decoder(step, resume) = dec
	Decoder(
		step: fn(doc) match step(doc) {
			Ok(v) -> Ok(f(v))
			Err(e) -> Err(e)
		},
		resume: fn() match resume() {
			Resume(v) -> Resume(f(v))
			Halt -> Halt
		},
	)
}

// Stops at the first failure, because the next decoder depends on the value
// and past a failure it would be a guess. Use `take` for members that don't
// depend on it.
pub fn then(dec Decoder(a), f fn(a) Decoder(b)) Decoder(b) {
	Decoder(step, resume) = dec
	Decoder(
		step: fn(doc) match step(doc) {
			Err(e) -> Err(e)
			Ok(v) -> run_at(f(v), doc)
		},
		resume: fn() match resume() {
			Resume(v) -> recovery(f(v))
			Halt -> Halt
		},
	)
}

// Hands `dec`'s value to the rest, and checks the rest even if `dec` failed by
// using its stand-in value. The result is always `Err` if `dec` failed. It
// stops at `fail`.
pub fn also(dec Decoder(a), k fn(a) Decoder(b)) Decoder(b) {
	Decoder(step, resume) = dec
	Decoder(
		step: fn(doc) match step(doc) {
			Ok(v) -> run_at(k(v), doc)
			Err(e) -> match resume() {
				Halt -> Err(e)
				Resume(v) -> match run_at(k(v), doc) {
					Ok(_) -> Err(e)
					Err(rest) -> Err([..e, ..rest])
				}
			}
		},
		resume: fn() match resume() {
			Resume(v) -> recovery(k(v))
			Halt -> Halt
		},
	)
}

// Decodes the member `name` with `inner` and hands it to `k`, using `also`
// over `field`.
pub fn take(name String, inner Decoder(a), k fn(a) Decoder(b)) Decoder(b) {
	field(name, inner) |> also(k)
}

// Like `take`, but uses `optional_field`, so `k` gets a `Field`.
pub fn take_optional(
	name String,
	inner Decoder(a),
	k fn(presence::Field(a)) Decoder(b),
) Decoder(b) {
	optional_field(name, inner) |> also(k)
}

// Combines two decoders with `f`. It keeps both sets of failures, with no
// stand-in value needed.
pub fn map2(d1 Decoder(a), d2 Decoder(b), f fn(a, b) c) Decoder(c) {
	Decoder(s1, r1) = d1
	Decoder(s2, r2) = d2
	Decoder(
		step: fn(doc) match (s1(doc), s2(doc)) {
			(Ok(a), Ok(b)) -> Ok(f(a, b))
			(Err(e1), Err(e2)) -> Err([..e1, ..e2])
			(Err(e1), Ok(_)) -> Err(e1)
			(Ok(_), Err(e2)) -> Err(e2)
		},
		resume: fn() match (r1(), r2()) {
			(Resume(a), Resume(b)) -> Resume(f(a, b))
			(Halt, _) | (Resume(_), Halt) -> Halt
		},
	)
}

// Accepts only values that satisfy `ok`. This is better than doing it with
// `then`, which stops checking the members after it.
pub fn guard(dec Decoder(a), ok fn(a) Bool, expected String) Decoder(a) {
	Decoder(step, resume) = dec
	Decoder(
		step: fn(doc) match step(doc) {
			Err(e) -> Err(e)
			Ok(v) -> if ok(v) {
				Ok(v)
			} else {
				Err(one_failure(expected, doc))
			}
		},
		resume: resume,
	)
}

// Decodes a required member. A `null` member goes to `inner`, which fails
// unless it takes null.
pub fn field(name String, inner Decoder(a)) Decoder(a) {
	Decoder(step, resume) = inner
	Decoder(
		step: fn(doc) match member(doc, name) {
			Err(e) -> Err(e)
			Ok(Some(child)) -> match step(child) {
				Ok(v) -> Ok(v)
				Err(e) -> Err(prefix_path(e, Key(name)))
			}
			Ok(None) -> Err([Failure([Key(name)], 'a member named "${name}"', FoundAbsent)])
		},
		resume: resume,
	)
}

// `json::field` is `None` both for a missing member and for a non-object. This
// splits them, so a decoder of only optional fields can't accept an array.
fn member(doc json::Doc, name String) Result(Option(json::Doc), Array(Failure)) {
	match json::field(doc, name) {
		Some(child) -> Ok(Some(child))
		None -> {
			kind = json::kind(doc)
			match kind {
				json::ObjectKind -> Ok(None)
				json::NullKind
				| json::BoolKind
				| json::IntKind
				| json::FloatKind
				| json::StringKind
				| json::ArrayKind ->
					Err([Failure([Key(name)], 'a member named "${name}"', FoundKind(kind))])
			}
		}
	}
}

// Decodes a member that may be absent, null or present, as a `Field(a)`.
// Absent means "unchanged" and null means "cleared", a difference `Option`
// would lose. A non-object still fails.
pub fn optional_field(name String, inner Decoder(a)) Decoder(presence::Field(a)) {
	Decoder(step, _) = inner
	Decoder(
		step: fn(doc) match member(doc, name) {
			Err(e) -> Err(e)
			Ok(None) -> Ok(presence::absent())
			Ok(Some(child)) -> if json::is_null(child) {
				Ok(presence::null())
			} else {
				match step(child) {
					Ok(v) -> Ok(presence::present(v))
					Err(e) -> Err(prefix_path(e, Key(name)))
				}
			}
		},
		resume: fn() Resume(presence::absent()),
	)
}

pub fn list(inner Decoder(a)) Decoder(Array(a)) {
	Decoder(step, _) = inner
	Decoder(
		step: fn(doc) match json::kind(doc) {
			json::ArrayKind -> collect_list(step, json::elements(doc), 0, [], [])
			json::NullKind
			| json::BoolKind
			| json::IntKind
			| json::FloatKind
			| json::StringKind
			| json::ObjectKind -> Err(one_failure('an array', doc))
		},
		resume: fn() Resume([]),
	)
}

fn collect_list(
	step fn(json::Doc) Result(a, Array(Failure)),
	items Array(json::Doc),
	i Int,
	oks Array(a),
	errs Array(Failure),
) Result(Array(a), Array(Failure)) {
	match items {
		[] -> match errs {
			[] -> Ok(oks)
			_ -> Err(errs)
		}
		[head, ..tail] -> match step(head) {
			Ok(v) -> collect_list(step, tail, i + 1, [..oks, v], errs)
			Err(e) -> collect_list(step, tail, i + 1, oks, [..errs, ..prefix_path(e, At(i))])
		}
	}
}

// Decodes an object's members into a list instead of a `Map`, to keep member
// order and duplicate keys.
pub fn dict(inner Decoder(a)) Decoder(Array((String, a))) {
	Decoder(step, _) = inner
	Decoder(
		step: fn(doc) match json::kind(doc) {
			json::ObjectKind -> collect_dict(step, json::entries(doc), [], [])
			json::NullKind
			| json::BoolKind
			| json::IntKind
			| json::FloatKind
			| json::StringKind
			| json::ArrayKind -> Err(one_failure('an object', doc))
		},
		resume: fn() Resume([]),
	)
}

fn collect_dict(
	step fn(json::Doc) Result(a, Array(Failure)),
	items Array((String, json::Doc)),
	oks Array((String, a)),
	errs Array(Failure),
) Result(Array((String, a)), Array(Failure)) {
	match items {
		[] -> match errs {
			[] -> Ok(oks)
			_ -> Err(errs)
		}
		[(k, v), ..tail] -> match step(v) {
			Ok(decoded) -> collect_dict(step, tail, [..oks, (k, decoded)], errs)
			Err(e) -> collect_dict(step, tail, oks, [..errs, ..prefix_path(e, Key(k))])
		}
	}
}

// Tries each decoder in turn and gives the first success, or every failure.
// `first` is its own parameter so there's always at least one.
pub fn one_of(first Decoder(a), rest Array(Decoder(a))) Decoder(a) {
	Decoder(
		step: fn(doc) match run_at(first, doc) {
			Ok(v) -> Ok(v)
			Err(e) -> try_each(rest, doc, e)
		},
		resume: fn() recovery(first),
	)
}

fn try_each(
	decoders Array(Decoder(a)),
	doc json::Doc,
	errs Array(Failure),
) Result(a, Array(Failure)) {
	match decoders {
		[] -> Err(errs)
		[head, ..tail] -> match run_at(head, doc) {
			Ok(v) -> Ok(v)
			Err(e) -> try_each(tail, doc, [..errs, ..e])
		}
	}
}

// Decodes a union told apart by the string member `tag`. `pick` returns
// `Err(Nil)` for an unknown tag.
pub fn tagged(tag String, pick fn(String) Result(Decoder(a), Nil)) Decoder(a) {
	field(tag, string_value())
	|> then(fn(t) match pick(t) {
		Ok(dec) -> dec
		Err(Nil) -> unknown_tag(tag, 'the tag "${t}"')
	})
}

pub fn tagged_int(tag String, pick fn(Int) Result(Decoder(a), Nil)) Decoder(a) {
	field(tag, int())
	|> then(fn(t) match pick(t) {
		Ok(dec) -> dec
		Err(Nil) -> unknown_tag(tag, 'the tag ${t}')
	})
}

fn unknown_tag(tag String, found String) Decoder(a) {
	Decoder(
		step: fn(_doc) Err([Failure([Key(tag)], 'a known tag', FoundText(found))]),
		resume: fn() Halt,
	)
}

// Decodes at a path of member names.
pub fn at(path_names Array(String), inner Decoder(a)) Decoder(a) {
	match path_names {
		[] -> inner
		[head, ..tail] -> field(head, at(tail, inner))
	}
}

// Decodes a member, giving `default` when it's absent or null. Don't use it for
// partial updates, because `field.update` keeps the current value where this
// would overwrite it.
pub fn with_default(name String, inner Decoder(a), default a) Decoder(a) {
	optional_field(name, inner) |> map(fn(f) presence::fold(f, fn() default, fn() default, fn(x) x))
}

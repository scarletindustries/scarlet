/**
 * VM introspection, for debugging and tests. Not a stable API.
 */

// The number of stack frames in the calling process.
@vm(internal__stack_depth)
pub fn stack_depth() Int

// How many cells this process has allocated over its whole life.
@vm(internal__cells_made)
pub fn cells_made() Int

// The number of mailboxes open across the program. That is every subject
// still held, plus every supervised worker's address.
@vm(internal__live_subjects)
pub fn live_subjects() Int

// The number of threads, busy or idle, in the pool that runs file, DNS and
// subprocess calls. The pool grows on demand up to SCARLET_BLOCKING_THREADS
// (512).
@vm(internal__blocking_threads)
pub fn blocking_threads() Int

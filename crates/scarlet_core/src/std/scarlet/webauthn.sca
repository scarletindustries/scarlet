/**
 * WebAuthn (W3C Level 3) checks for a relying party. `verify_registration`
 * reads a `navigator.credentials.create` response and gives the credential
 * to store. `verify_authentication` checks a `navigator.credentials.get`
 * response against it.
 *
 * The attestation statement isn't verified. The key comes from the
 * authenticator data, and every later sign-in is checked against it. Only
 * ES256 and EdDSA keys are supported. `signCount` is returned to you but not
 * enforced.
 */

import scarlet/base64
import scarlet/binary
import scarlet/cbor
import scarlet/crypto
import scarlet/int
import scarlet/json
import scarlet/option
import scarlet/result

/** What registration gives and authentication needs. */
pub type Credential {
	id Binary
	public_key Binary
	algorithm Algorithm
	sign_count Int
}

pub type Algorithm {
	/** COSE -7. `public_key` is SEC1 uncompressed. */
	Es256
	/** COSE -8. `public_key` is the 32-byte point. */
	EdDsa
}

/** Why a ceremony was refused. */
pub type Error {
	BadClientData(reason ClientDataError)
	/** clientDataJSON's `type` is not the ceremony's. */
	WrongType
	ChallengeMismatch
	OriginMismatch
	BadAttestation(reason AttestationError)
	BadAuthData(reason AuthDataError)
	RpIdMismatch
	UserNotPresent
	/** The credential public key is not one this checks signatures with. */
	BadKey(reason KeyError)
	BadSignature
}

/** Why clientDataJSON could not be read. */
pub type ClientDataError {
	/** It is not a whole number of bytes, so it has no SHA-256. */
	NotWholeBytes
	NotJson(error json::ParseError)
	/** A field the ceremony needs is missing or not a string. */
	MissingField(name String)
	/** `challenge` is not base64url. */
	ChallengeNotBase64url
}

/** Why the attestation object could not be read. */
pub type AttestationError {
	NotCbor(error cbor::Error)
	/** It has no `authData` byte string. */
	MissingAuthData
}

/** Why authenticatorData could not be read. */
pub type AuthDataError {
	/** It is shorter than its flags say. */
	Truncated
	/** Registration needs the attested credential, and the AT flag is off. */
	NoCredential
	/** The credential public key is not CBOR this decodes. */
	KeyNotCbor(error cbor::Error)
	/** The extensions (the ED flag) are not CBOR this decodes. */
	ExtensionsNotCbor(error cbor::Error)
	/** Bytes follow everything the flags announce. */
	TrailingData
}

/** Why a COSE key was refused. */
pub type KeyError {
	/** It names no `alg` (label 3). */
	MissingAlgorithm
	/** An `alg` other than ES256 (-7) and EdDSA (-8). */
	UnsupportedAlgorithm(alg Int)
	/** `kty` (label 1) is missing or wrong for the algorithm. */
	WrongKeyType
	/** `crv` (label -1) is missing or not the algorithm's curve. */
	WrongCurve
	/** A coordinate (label -2 or -3) is missing, not bytes, or not 32 bytes. */
	BadCoordinate(label Int)
}

// clientDataJSON

type ClientData {
	kind String
	challenge String
	origin String
	/** SHA-256 of the raw bytes, which an assertion signature covers. */
	hash Binary
}

fn parse_client_data(bytes Binary) Result(ClientData, ClientDataError) {
	hash <- result::then(crypto::sha256(bytes) |> result::replace_err(NotWholeBytes))
	doc <- result::then(json::parse_binary(bytes) |> result::map_err(NotJson))
	kind <- result::then(field(doc, 'type'))
	challenge <- result::then(field(doc, 'challenge'))
	origin <- result::then(field(doc, 'origin'))
	Ok(ClientData(kind: kind, challenge: challenge, origin: origin, hash: hash))
}

fn field(doc json::Doc, name String) Result(String, ClientDataError) {
	match json::field(doc, name) |> option::then(json::string) {
		Some(s) -> Ok(s)
		None -> Err(MissingField(name))
	}
}

// The challenge is unpadded base64url. It is compared in constant time.
fn check_client(cd ClientData, kind String, challenge Binary, origin String) Result(Nil, Error) {
	if cd.kind != kind {
		Err(WrongType)
	} else {
		match cd.challenge |> binary::from_string |> base64::url_decode {
			Err(Nil) -> Err(BadClientData(ChallengeNotBase64url))
			Ok(got) -> if !crypto::const_eq(got, challenge) {
				Err(ChallengeMismatch)
			} else if cd.origin != origin {
				Err(OriginMismatch)
			} else {
				Ok(Nil)
			}
		}
	}
}

// authenticatorData

/** The fixed head of authenticatorData, plus the attested credential when
 * the AT flag is set. */
type AuthData {
	rp_id_hash Binary
	user_present Bool
	sign_count Int
	attested Option((Binary, cbor::Value))
}

const FLAG_UP = 1
const FLAG_AT = 64
const FLAG_ED = 128

// rpIdHash[32], flags[1], signCount[4], then the attested credential if AT is
// set, then the extensions map if ED is set, and nothing after.
fn parse_auth_data(auth Binary) Result(AuthData, AuthDataError) {
	if binary::byte_size(auth) < 37 {
		Err(Truncated)
	} else {
		rp_id_hash <- result::then(take(auth, 0, 32))
		flags = binary::byte_at(auth, 32)
		sign_count = { binary::byte_at(auth, 33) * 16777216 } +
			{ binary::byte_at(auth, 34) * 65536 } +
			{ binary::byte_at(auth, 35) * 256 } +
			binary::byte_at(auth, 36)

		cred <- result::then(if has_flag(flags, FLAG_AT) {
			attested_credential(auth) |> result::map(Some)
		} else Ok(None))

		(attested, after_cred) = match cred {
			Some((c, end)) -> (Some(c), end)
			None -> (None, 37)
		}

		end <- result::then(if has_flag(flags, FLAG_ED) {
			ext <- result::then(
				cbor::decode_prefix(auth, after_cred) |> result::map_err(ExtensionsNotCbor),
			)
			(_, next) = ext
			Ok(next)
		} else {
			Ok(after_cred)
		})

		if end != binary::byte_size(auth) {
			Err(TrailingData)
		} else {
			Ok(
				AuthData(
					rp_id_hash: rp_id_hash,
					user_present: has_flag(flags, FLAG_UP),
					sign_count: sign_count,
					attested: attested,
				),
			)
		}
	}
}

fn has_flag(flags Int, flag Int) Bool {
	int::bitwise_and(flags, flag) == flag
}

// aaguid[16] at 37, credentialIdLength[2] at 53, the id at 55, then the COSE
// key. Returns the id and key with the offset just past the key.
fn attested_credential(auth Binary) Result(((Binary, cbor::Value), Int), AuthDataError) {
	if binary::byte_size(auth) < 55 {
		Err(Truncated)
	} else {
		id_len = { binary::byte_at(auth, 53) * 256 } + binary::byte_at(auth, 54)
		id <- result::then(take(auth, 55, id_len))
		decoded = cbor::decode_prefix(auth, 55 + id_len)
		(key, end) <- result::then(result::map_err(decoded, KeyNotCbor))
		Ok(((id, key), end))
	}
}

fn take(b Binary, at Int, n Int) Result(Binary, AuthDataError) {
	match binary::slice_bytes(b, at, n) {
		Ok(s) -> Ok(s)
		Err(Nil) -> Err(Truncated)
	}
}

fn check_auth_data(ad AuthData, rp_id String) Result(Nil, Error) {
	if !rp_id_matches(ad.rp_id_hash, rp_id) {
		Err(RpIdMismatch)
	} else if !ad.user_present {
		Err(UserNotPresent)
	} else {
		Ok(Nil)
	}
}

fn rp_id_matches(rp_id_hash Binary, rp_id String) Bool {
	match crypto::sha256(binary::from_string(rp_id)) {
		Ok(expected) -> crypto::const_eq(rp_id_hash, expected)
		// A String is always whole bytes, so this can't happen. It refuses.
		Err(Nil) -> False
	}
}

// COSE keys

// An ES256 key is turned into SEC1 uncompressed form (0x04, x, y). An EdDSA
// key is used as it is.
fn cose_key(key cbor::Value) Result((Algorithm, Binary), KeyError) {
	alg <- result::then(match cose_int(key, 3) {
		Some(a) -> Ok(a)
		None -> Err(MissingAlgorithm)
	})
	if alg == 0 - 7 {
		// kty EC2 (2), crv P-256 (1).
		if cose_int(key, 1) != Some(2) {
			Err(WrongKeyType)
		} else if cose_int(key, 0 - 1) != Some(1) {
			Err(WrongCurve)
		} else {
			x <- result::then(coordinate(key, 0 - 2))
			y <- result::then(coordinate(key, 0 - 3))
			Ok((Es256, binary::concat([<<4:8>>, x, y])))
		}
	} else if alg == 0 - 8 {
		// kty OKP (1), crv Ed25519 (6).
		if cose_int(key, 1) != Some(1) {
			Err(WrongKeyType)
		} else if cose_int(key, 0 - 1) != Some(6) {
			Err(WrongCurve)
		} else {
			x <- result::then(coordinate(key, 0 - 2))
			Ok((EdDsa, x))
		}
	} else {
		Err(UnsupportedAlgorithm(alg))
	}
}

fn cose_int(key cbor::Value, label Int) Option(Int) {
	cbor::map_get(key, label) |> option::then(cbor::as_int)
}

// Both curves here have 32-byte coordinates.
fn coordinate(key cbor::Value, label Int) Result(Binary, KeyError) {
	match cbor::map_get(key, label) |> option::then(cbor::as_bytes) {
		Some(b) -> if binary::byte_size(b) == 32 {
			Ok(b)
		} else {
			Err(BadCoordinate(label))
		}
		None -> Err(BadCoordinate(label))
	}
}

// Registration

/** Checks a `navigator.credentials.create` response, as raw bytes from the
 * browser, and returns the credential to store. `challenge` is what the
 * server issued. */
pub fn verify_registration(
	attestation_object Binary,
	client_data_json Binary,
	challenge Binary,
	rp_id String,
	origin String,
) Result(Credential, Error) {
	cd <- result::then(parse_client_data(client_data_json) |> result::map_err(BadClientData))
	Nil <- result::then(check_client(cd, 'webauthn.create', challenge, origin))
	att <- result::then(
		cbor::decode(attestation_object) |> result::map_err(fn(e) BadAttestation(NotCbor(e))),
	)
	auth_bytes <- result::then(
		match cbor::text_map_get(att, 'authData') |> option::then(cbor::as_bytes) {
			Some(b) -> Ok(b)
			None -> Err(BadAttestation(MissingAuthData))
		},
	)
	ad <- result::then(parse_auth_data(auth_bytes) |> result::map_err(BadAuthData))
	Nil <- result::then(check_auth_data(ad, rp_id))
	match ad.attested {
		None -> Err(BadAuthData(NoCredential))
		Some((cred_id, key)) -> {
			(alg, pk) <- result::then(cose_key(key) |> result::map_err(BadKey))
			Ok(Credential(id: cred_id, public_key: pk, algorithm: alg, sign_count: ad.sign_count))
		}
	}
}

// Authentication

/** Checks a `navigator.credentials.get` response, as raw bytes from the
 * browser, against the credential `verify_registration` gave. It returns the
 * new `signCount`, which a caller that checks for cloned keys compares with
 * the stored one. */
pub fn verify_authentication(
	authenticator_data Binary,
	client_data_json Binary,
	signature Binary,
	challenge Binary,
	rp_id String,
	origin String,
	cred Credential,
) Result(Int, Error) {
	cd <- result::then(parse_client_data(client_data_json) |> result::map_err(BadClientData))
	Nil <- result::then(check_client(cd, 'webauthn.get', challenge, origin))
	ad <- result::then(parse_auth_data(authenticator_data) |> result::map_err(BadAuthData))
	Nil <- result::then(check_auth_data(ad, rp_id))
	// The signature is over authenticatorData || sha256(clientDataJSON).
	message = binary::append(authenticator_data, cd.hash)
	verified = match cred.algorithm {
		Es256 -> crypto::p256_verify(cred.public_key, message, signature)
		EdDsa -> crypto::ed25519_verify(cred.public_key, message, signature)
	}
	if verified {
		Ok(ad.sign_count)
	} else {
		Err(BadSignature)
	}
}

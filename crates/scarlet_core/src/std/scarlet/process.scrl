/**
 * Processes, message passing, and the supervision tree.
 *
 * `spawn(f)` starts a cheap process running `f`. Processes share nothing: a
 * message is a copy, and a `Subject` is a typed mailbox only its owner can
 * receive on. A crash ends only its own process, but `spawn` links the two,
 * so a failure nobody planned for spreads until a supervisor handles it.
 * A supervisor restarts a worker at the same address. See
 * examples/supervision.scrl.
 */
import scarlet/array
import scarlet/time

// Names one process, and is never reused, so it can be a map key.
pub type Pid

// Starts `f` in a new process linked to this one: if either crashes or is
// killed, so is the other. `f` returns Nil because a process's result goes
// nowhere, so an error in it must be handled inside `f`.
@vm(process__spawn)
pub fn spawn(f fn() Nil) Pid

// As `spawn`, with no link, for a task whose failure the caller watches with
// `monitor`.
@vm(process__spawn_unlinked)
pub fn spawn_unlinked(f fn() Nil) Pid

@vm(process__self)
pub fn self() Pid

// Ends `pid` soon, not at once: monitor it to know when it has gone. What is
// linked to it dies too. Killing a process that has ended does nothing.
@vm(process__kill)
pub fn kill(pid Pid) Nil

// Parks only the calling process. `ms <= 0` returns at once.
@vm(process__sleep)
pub fn sleep(ms Int) Nil

// `NoProcess`: it had already ended when the monitor was placed, so how it
// ended is not known.
pub type ExitReason {
	Normal
	NoProcess
	// `kill` was called on it, or on something linked to it.
	Killed
	// Its own code hit a runtime error. Also printed to stderr, unless it was
	// the main process.
	Crashed(crash Crash)
}

// The runtime errors that end a process.
pub type Crash {
	IndexOutOfBounds(index Int, length Int)
	SliceOutOfBounds(from Int, to Int, length Int)
	// A `receive` on a subject another process owns.
	ForeignReceive
	// A compiler bug: the runtime met a value of the wrong type.
	TypeMismatch(op String, expected String, got String)
	// A declaration the tree refused, such as into a supervisor this process
	// did not create.
	Supervision(why String)
}

pub type Down {
	pid Pid
	reason ExitReason
}

pub opaque type Monitor {
	target Pid
	id Int
}

// Sends `wrap(down)` to `notify` when `pid` ends, or at once with `NoProcess`
// if it already has, so the notice arrives among the caller's other messages.
// Released when it fires, on `demonitor`, or when the caller ends.
pub fn monitor(pid Pid, notify Subject(msg), wrap fn(Down) msg) Monitor {
	on_down(pid, fn(down) send(notify, wrap(down)))
}

@vm(process__monitor)
fn on_down(pid Pid, notice fn(Down) Nil) Monitor

// A notice already on its way may still arrive.
@vm(process__demonitor)
pub fn demonitor(m Monitor) Nil

// A typed mailbox. Only the process that made it can receive on it; any
// process holding it can send.
pub type Subject(msg)

// A new subject owned by the calling process. It is freed when the owner
// drops it or ends, and sends after that are dropped.
@vm(process__subject)
pub fn subject() Subject(msg)

// Never blocks. The receiver gets a copy, and a message to a finished process
// is dropped.
@vm(process__send)
pub fn send(s Subject(msg), m msg) Nil

// `send`, to the front of the queue, so an `Ask` stop request does not wait
// its turn.
@vm(process__send_urgent)
fn send_urgent(s Subject(msg), m msg) Nil

// The oldest message on `s`, parking until one arrives. Only the owner may
// call it.
@vm(process__receive)
pub fn receive(s Subject(msg)) msg

// As `receive`, but `Err(Nil)` after `timeout_ms` milliseconds.
pub fn receive_within(s Subject(msg), timeout_ms Int) Result(msg, Nil) {
	receive_until(s, time.add_ms(time.monotonic(), timeout_ms))
}

// As `receive`, but `Err(Nil)` once `deadline` (from `time.monotonic()`)
// passes.
pub fn receive_until(s Subject(msg), deadline time.Instant) Result(msg, Nil) {
	receive_until_ms(s, time.to_deadline_ms(deadline))
}

@vm(process__receive_until)
fn receive_until_ms(s Subject(msg), deadline_ms Int) Result(msg, Nil)

pub opaque type Timer {
	waiting Pid
}

// Sends `m` to `s` after `delay_ms`, without parking the caller. The wait is
// an unlinked process, so it keeps the program running until it fires:
// cancel a timer you no longer need.
pub fn send_after(s Subject(msg), delay_ms Int, m msg) Timer {
	Timer(waiting: spawn_unlinked(fn() {
		sleep(delay_ms)
		send(s, m)
	}))
}

// A message already on its way may still arrive.
pub fn cancel_timer(t Timer) Nil {
	kill(t.waiting)
}

// Supervision. A worker's address is a Subject that stays valid across its
// restarts. See examples/supervision.scrl.

// How a supervisor restarts its workers. More than `restarts` restarts within
// `within_ms` and it gives up, stopping all its children.
pub type Strategy {
	// Restart only the one that died.
	OneForOne(restarts Int, within_ms Int)
	// Stop the others and restart them all: their states only make sense
	// together.
	OneForAll(restarts Int, within_ms Int)
	// Restart the one that died and every worker declared after it.
	RestForOne(restarts Int, within_ms Int)
}

// When a worker is restarted.
pub type Policy {
	// After any exit, even a normal return: a server.
	Permanent
	// After a crash or a kill, but not a normal return.
	Transient
	// Never. It is in the tree only to be stopped with its siblings.
	Temporary
}

// How a supervisor stops a worker it needs gone.
pub type Shutdown(msg) {
	Kill
	// Send it `message`, ahead of its queue, and kill it if it is still
	// running `grace_ms` later. The worker stops by returning.
	Ask(message msg, grace_ms Int)
}

pub type Members {
	// A member ends when its process ends: connections, requests, jobs.
	Disposable
	// A member that crashes or is killed restarts at the same address and key,
	// within the factory's own budget.
	Restarted(restarts Int, within_ms Int)
}

pub opaque type Supervisor {
	supervised Supervised
}

// Workers of one shape, made on demand and found again by key. `msg` is what
// a member receives, and `key` identifies one.
pub opaque type Factory(msg, key) {
	supervised Supervised
}

// A place in the tree: a worker, a supervisor, a factory or a plain process.
// Compares by identity. Every function on it is total: a place that is gone
// says so.
pub opaque type Supervised {
	id Int
}

// Declares a top-level supervisor, runs `body` with it (the rest of the block,
// under backpassing), then parks for good: the tree is now the program.
pub fn root(strategy Strategy, body fn(Supervisor) a) b {
	_ = body(supervisor(strategy))
	receive(subject())
}

// A top-level supervisor as a value, for a library that sets up a subtree
// (`net.serve`). It outlives the caller if the caller returns normally.
// Applications should use `root`.
pub fn supervisor(strategy Strategy) Supervisor {
	Supervisor(supervised: Supervised(id: declare_supervisor(strategy, Nil)))
}

// A supervisor inside `parent`, with its own strategy and budget, restarted
// by `parent` if it gives up.
pub fn supervisor_in(parent Supervisor, strategy Strategy) Supervisor {
	Supervisor(supervised: Supervised(id: declare_supervisor(strategy, parent.supervised.id)))
}

fn declare_supervisor(strategy Strategy, parent p) Int {
	match strategy {
		OneForOne(restarts, within_ms) -> supervisor_entry(0, restarts, within_ms, parent)
		OneForAll(restarts, within_ms) -> supervisor_entry(1, restarts, within_ms, parent)
		RestForOne(restarts, within_ms) -> supervisor_entry(2, restarts, within_ms, parent)
	}
}

@vm(process__supervisor)
fn supervisor_entry(strategy Int, restarts Int, within_ms Int, parent p) Int

// Declares a worker in `sup` and runs `start` in a new process with the
// worker's address, which it returns.
pub fn worker(
	sup Supervisor,
	policy Policy,
	stop Shutdown(msg),
	start fn(Subject(msg)) Nil,
) Subject(msg) {
	code = policy_code(policy)
	match stop {
		Kill -> worker_slot(sup.supervised.id, code, Nil, start)
		Ask(message, grace_ms) -> worker_slot(
			sup.supervised.id,
			code,
			fn(addr, pid) {
				send_urgent(addr, message)
				sleep(grace_ms)
				kill(pid)
			},
			start,
		)
	}
}

// `worker` with `Permanent` and `Kill`: the common server.
pub fn permanent(sup Supervisor, start fn(Subject(msg)) Nil) Subject(msg) {
	worker(sup, Permanent, Kill, start)
}

// `worker` with `Transient` and `Kill`: retried if it fails.
pub fn transient(sup Supervisor, start fn(Subject(msg)) Nil) Subject(msg) {
	worker(sup, Transient, Kill, start)
}

// `worker` with `Temporary` and `Kill`: in the tree, never restarted.
pub fn temporary(sup Supervisor, start fn(Subject(msg)) Nil) Subject(msg) {
	worker(sup, Temporary, Kill, start)
}

fn policy_code(policy Policy) Int {
	match policy {
		Permanent -> 0
		Transient -> 1
		Temporary -> 2
	}
}

// `stopper` is a `fn(Subject(msg), Pid) Nil`, or Nil to kill outright.
@vm(process__worker)
fn worker_slot(sup Int, policy Int, stopper s, start fn(Subject(msg)) Nil) Subject(msg)

// Declares a factory in `sup`. `template` runs in a new process for each
// member, with the member's address and key.
pub fn factory(
	sup Supervisor,
	members Members,
	template fn(Subject(msg), key) Nil,
) Factory(msg, key) {
	id = match members {
		Disposable -> factory_entry(sup.supervised.id, -1, 0, template)
		Restarted(restarts, within_ms) ->
			factory_entry(sup.supervised.id, restarts, within_ms, template)
	}
	Factory(supervised: Supervised(id: id))
}

@vm(process__factory)
fn factory_entry(sup Int, restarts Int, within_ms Int, template fn(Subject(msg), key) Nil) Int

// The member for `k`, started if there is none. There is at most one per
// key, however many processes ask at once.
pub fn lookup_or_start(f Factory(msg, key), k key) Subject(msg) {
	lookup_or_start_in(f.supervised.id, k)
}

@vm(process__lookup_or_start)
fn lookup_or_start_in(factory Int, k key) Subject(msg)

pub fn lookup(f Factory(msg, key), k key) Option(Subject(msg)) {
	lookup_in(f.supervised.id, k)
}

@vm(process__lookup)
fn lookup_in(factory Int, k key) Option(Subject(msg))

// Starts a member for `a` under no key, as a server does for each
// connection, so `count` of the factory counts it.
pub fn start_in(f Factory(msg, arg), a arg) Subject(msg) {
	start_member(f.supervised.id, a)
}

@vm(process__start_in)
fn start_member(factory Int, a arg) Subject(msg)

// One worker per scheduler thread, restarted on the same thread. Only for
// `net`: a socket belongs to the thread that accepted it.
pub fn worker_per_scheduler(sup Supervisor, policy Policy, start fn(Subject(msg)) Nil) Nil {
	worker_slots_per_scheduler(sup.supervised.id, policy_code(policy), start)
}

@vm(process__worker_on_each)
fn worker_slots_per_scheduler(sup Int, policy Int, start fn(Subject(msg)) Nil) Nil

// The place behind an address: its worker, or the owner of a plain subject.
pub fn supervised(addr Subject(msg)) Supervised {
	Supervised(id: supervised_id(addr))
}

@vm(process__supervised)
fn supervised_id(addr Subject(msg)) Int

// What `s` is declared under. A process's parent is the one that spawned it,
// and the main process is its own parent.
pub fn parent(s Supervised) Supervised {
	Supervised(id: parent_id(s.id))
}

@vm(process__parent)
fn parent_id(id Int) Int

// What is declared under `s`, in declaration order (a factory's members in
// no order). A snapshot.
pub fn children(s Supervised) Array(Supervised) {
	array.map(children_ids(s.id), fn(id) Supervised(id: id))
}

@vm(process__children)
fn children_ids(id Int) Array(Int)

// `array.length(children(s))`, without building the array.
pub fn count(s Supervised) Int {
	count_of(s.id)
}

@vm(process__count)
fn count_of(id Int) Int

pub type Kind {
	// Spawned, or the main process.
	Process
	Worker(policy Policy)
	SupervisorOf(strategy Strategy)
	FactoryOf(members Members)
}

pub type Status {
	Running
	// Its process has ended and has not been restarted yet.
	Restarting
	Gone
}

pub type Info {
	kind Kind
	status Status
	// The process there now. None for a supervisor, a factory, or a worker
	// between runs.
	pid Option(Pid)
	restarts Int
}

pub type Ended {
	// The process there exited. `Killed` also means the place was torn down
	// from above.
	Exited(reason ExitReason)
	// A supervisor or factory there ran out of restarts, and its children
	// were stopped.
	GaveUp(restarts Int, within_ms Int)
}

// One watch notice: what happened at `supervised`, and its status after.
pub type Exit {
	supervised Supervised
	ended Ended
	status Status
}

pub opaque type Watch {
	OnPlace(supervised Supervised, id Int)
	OnProcess(monitor Monitor)
}

// Sends `wrap(exit)` to `notify` each time something happens at `s`: every
// exit of its worker, restarts included (unlike `monitor`), a give-up, and
// its removal.
pub fn watch(s Supervised, notify Subject(msg), wrap fn(Exit) msg) Watch {
	match info(s) {
		Info(kind: Process, pid: Some(pid), ..) ->
			OnProcess(
				monitor(
					pid,
					notify,
					fn(down) wrap(Exit(supervised: s, ended: Exited(down.reason), status: Gone)),
				),
			)
		Info(kind: Process, pid: None, ..) -> {
			send(notify, wrap(Exit(supervised: s, ended: Exited(NoProcess), status: Gone)))
			OnPlace(s, 0)
		}
		Info(..) ->
			OnPlace(
				s,
				watch_place(s.id, fn(description) send(notify, wrap(decode_exit(description)))),
			)
	}
}

// A notice already on its way may still arrive.
pub fn unwatch(w Watch) Nil {
	match w {
		OnPlace(s, id) -> unwatch_place(s.id, id)
		OnProcess(m) -> demonitor(m)
	}
}

// The runtime's description of an event: (0 for an exit or 1 for a give-up,
// the reason, the give-up's budget, the status code, the place's id).
fn decode_exit(description (Int, ExitReason, Int, Int, Int, Int)) Exit {
	(kind, reason, restarts, within_ms, status, id) = description
	Exit(
		supervised: Supervised(id: id),
		ended: if kind == 1 {
			GaveUp(restarts, within_ms)
		} else {
			Exited(reason)
		},
		status: match status {
			0 -> Running
			1 -> Restarting
			_ -> Gone
		},
	)
}

@vm(process__watch)
fn watch_place(id Int, notice fn((Int, ExitReason, Int, Int, Int, Int)) Nil) Int

@vm(process__unwatch)
fn unwatch_place(id Int, watch Int) Nil

pub fn info(s Supervised) Info {
	(kind, detail, restarts, within_ms, status, restarted, pid) = info_of(s.id)
	kind = match kind {
		1 -> Worker(match detail {
			0 -> Permanent
			1 -> Transient
			_ -> Temporary
		})
		2 -> SupervisorOf(match detail {
			0 -> OneForOne(restarts, within_ms)
			1 -> OneForAll(restarts, within_ms)
			_ -> RestForOne(restarts, within_ms)
		})
		3 -> FactoryOf(if detail == 1 {
			Restarted(restarts, within_ms)
		} else {
			Disposable
		})
		_ -> Process
	}
	status = match status {
		0 -> Running
		1 -> Restarting
		_ -> Gone
	}
	Info(kind: kind, status: status, pid: pid, restarts: restarted)
}

@vm(process__info)
fn info_of(id Int) (Int, Int, Int, Int, Int, Int, Option(Pid))

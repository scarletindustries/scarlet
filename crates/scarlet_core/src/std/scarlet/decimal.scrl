// Exact decimal arithmetic on a scaled integer, for money-like values.
//
// A `Decimal` is `units * 10^(-scale)`: `new(1999, 2)` is 19.99. Addition
// aligns scales and multiplication adds them, so only `div` and `round` drop
// digits, at a scale and rounding mode you give. `units` is an `Int`, so
// neither it nor the scale has a limit.
//
// The type is opaque, so code can wrap it in its own opaque type for nominal
// safety: `pub opaque type Usd { Usd(amount Decimal) }`.

import scarlet/binary
import scarlet/float
import scarlet/int
import scarlet/option
import scarlet/string

pub opaque type Decimal {
	units Int
	scale Int
}

// How `div_with` and `round_with` drop digits. `div` and `round` use
// `HalfEven`, which sends ties to the even neighbour so repeated rounding
// doesn't drift; `HalfUp` sends them away from zero.
pub type Rounding {
	HalfEven
	HalfUp
	Down
	Up
	Floor
	Ceiling
}

// `units * 10^(-scale)`: `new(1999, 2)` is 19.99. A negative scale is
// multiplied out: `new(5, 0 - 3)` is 5000 at scale 0.
pub fn new(units Int, scale Int) Decimal {
	if scale < 0 {
		Decimal(units * pow10(0 - scale), 0)
	} else {
		Decimal(units, scale)
	}
}

pub fn from_int(n Int) Decimal {
	Decimal(n, 0)
}

// The raw scaled integer: `units(new(1999, 2))` is 1999. Together with
// `scale` this is the lossless way to serialize a Decimal.
pub fn units(d Decimal) Int {
	match d {
		Decimal(u, _) -> u
	}
}

pub fn scale(d Decimal) Int {
	match d {
		Decimal(_, s) -> s
	}
}

pub fn add(a Decimal, b Decimal) Decimal {
	s = int.max(scale(a), scale(b))
	Decimal(units(a) * pow10(s - scale(a)) + units(b) * pow10(s - scale(b)), s)
}

pub fn sub(a Decimal, b Decimal) Decimal {
	add(a, neg(b))
}

pub fn neg(d Decimal) Decimal {
	Decimal(0 - units(d), scale(d))
}

pub fn abs(d Decimal) Decimal {
	Decimal(int.abs(units(d)), scale(d))
}

// Exact product; the result scale is the sum of the operand scales.
// 19.99 * 3 is 59.97 at scale 2; 1.5 * 0.25 is 0.375 at scale 3.
pub fn mul(a Decimal, b Decimal) Decimal {
	Decimal(units(a) * units(b), scale(a) + scale(b))
}

// `a / b` at `places`, rounding half-to-even, or `Err(Nil)` when `b` is 0.
// A negative `places` rounds to a multiple of 10^|places| at scale 0:
// `div(from_int(1234), from_int(1), 0 - 2)` is 1200.
pub fn div(a Decimal, b Decimal, places Int) Result(Decimal, Nil) {
	div_with(a, b, places, HalfEven)
}

pub fn div_with(a Decimal, b Decimal, places Int, mode Rounding) Result(Decimal, Nil) {
	if is_zero(b) {
		Err(Nil)
	} else {
		e = places + scale(b) - scale(a)
		q = if e >= 0 {
			div_units(units(a) * pow10(e), units(b), mode)
		} else {
			div_units(units(a), units(b) * pow10(0 - e), mode)
		}
		Ok(at_places(q, places))
	}
}

// Change the scale, rounding half-to-even or padding with zeros:
// `round(new(2345, 3), 2)` is 2.34. A negative `places` rounds to a
// multiple of 10^|places| at scale 0: `round(new(1250, 0), 0 - 2)` is 1200.
pub fn round(d Decimal, places Int) Decimal {
	round_with(d, places, HalfEven)
}

pub fn round_with(d Decimal, places Int, mode Rounding) Decimal {
	k = scale(d) - places
	if k <= 0 {
		Decimal(units(d) * pow10(0 - k), places)
	} else {
		at_places(div_round(units(d), pow10(k), mode), places)
	}
}

// Numeric comparison across scales. `compare(new(15, 1), new(1500, 3))` is
// `Eq` — built-in `==` would say otherwise, because it compares the
// representation (units and scale), not the number.
pub fn compare(a Decimal, b Decimal) Order {
	s = int.max(scale(a), scale(b))
	ua = units(a) * pow10(s - scale(a))
	ub = units(b) * pow10(s - scale(b))
	if ua < ub {
		Lt
	} else if ua > ub {
		Gt
	} else {
		Eq
	}
}

pub fn eq(a Decimal, b Decimal) Bool {
	match compare(a, b) {
		Eq -> True
		_ -> False
	}
}

pub fn lt(a Decimal, b Decimal) Bool {
	match compare(a, b) {
		Lt -> True
		_ -> False
	}
}

pub fn lte(a Decimal, b Decimal) Bool {
	match compare(a, b) {
		Gt -> False
		_ -> True
	}
}

pub fn gt(a Decimal, b Decimal) Bool {
	match compare(a, b) {
		Gt -> True
		_ -> False
	}
}

pub fn gte(a Decimal, b Decimal) Bool {
	match compare(a, b) {
		Lt -> False
		_ -> True
	}
}

pub fn min(a Decimal, b Decimal) Decimal {
	if lte(a, b) { a } else { b }
}

pub fn max(a Decimal, b Decimal) Decimal {
	if gte(a, b) { a } else { b }
}

pub fn is_zero(d Decimal) Bool {
	units(d) == 0
}

pub fn is_negative(d Decimal) Bool {
	units(d) < 0
}

pub fn is_positive(d Decimal) Bool {
	units(d) > 0
}

// Drop trailing zeros: `normalize(new(1500, 3))` is 1.5 at scale 1. Useful
// before serializing when the stored scale carries no meaning.
pub fn normalize(d Decimal) Decimal {
	if scale(d) > 0 && units(d) % 10 == 0 {
		normalize(Decimal(units(d) / 10, scale(d) - 1))
	} else {
		d
	}
}

// An optional sign, digits, and an optional fraction: '42', '-19.99',
// '+0.05'. The scale is the number of fraction digits. Anything else, like
// '.5' or '1.', is `Err(Nil)`.
pub fn parse(s String) Result(Decimal, Nil) {
	b = binary.from_string(s)
	first = binary.byte_at(b, 0)
	parsed = if first == 45 {
		option.map(parse_unsigned(tail(b)), neg)
	} else if first == 43 {
		parse_unsigned(tail(b))
	} else {
		parse_unsigned(b)
	}
	match parsed {
		Some(d) -> Ok(d)
		None -> Err(Nil)
	}
}

pub fn to_string(d Decimal) String {
	if scale(d) == 0 {
		int.to_string(units(d))
	} else {
		sign = if units(d) < 0 { '-' } else { '' }
		mag = int.abs(units(d))
		p = pow10(scale(d))
		'${sign}${mag / p}.${pad_zeros(int.to_string(mag % p), scale(d))}'
	}
}

// The nearest Float, rounded once. One too large to be a Float is the
// largest Float, as in Float arithmetic.
pub fn to_float(d Decimal) Float {
	from_decimal(units(d), scale(d))
}

@vm(float__from_decimal)
fn from_decimal(units Int, scale Int) Float

// The exact value of `f`, rounded at `places` with ties away from zero, as
// `float.round` does. A Float is never NaN or infinite, so this cannot fail.
// Floats are approximate, so prefer `parse` or `new` when exactness matters.
pub fn from_float(f Float, places Int) Decimal {
	round_with(exact(f, 0), places, HalfUp)
}

// `f * 2^k` is whole after at most 1074 doublings, each exact. Then `f` is
// `n / 2^k`, which is `n * 5^k / 10^k`.
fn exact(f Float, k Int) Decimal {
	n = float.floor(f)
	if float.from_int(n) == f {
		Decimal(n * pow(5, k), k)
	} else {
		exact(f * 2.0, k + 1)
	}
}

// A rounded coefficient `q` placed at the target `places`: a negative
// `places` multiplies the magnitude back out to scale 0.
fn at_places(q Int, places Int) Decimal {
	if places < 0 {
		Decimal(q * pow10(0 - places), 0)
	} else {
		Decimal(q, places)
	}
}

fn pow10(n Int) Int {
	pow(10, n)
}

// `b^n` by squaring; 1 when `n <= 0`.
fn pow(b Int, n Int) Int {
	if n <= 0 {
		1
	} else if n % 2 == 0 {
		h = pow(b, n / 2)
		h * h
	} else {
		b * pow(b, n - 1)
	}
}

fn tail(b Binary) Binary {
	binary.drop_bytes(b, 1)
}

fn parse_unsigned(b Binary) Option(Decimal) {
	match binary.index_of(b, <<'.'>>, 0) {
		None -> match binary.parse_int(b, binary.Dec) {
			Ok(n) -> Some(Decimal(n, 0))
			Err(Nil) -> None
		}
		Some(i) -> {
			(whole, rest) = binary.split_at_bytes(b, i)
			parse_parts(whole, binary.drop_bytes(rest, 1))
		}
	}
}

fn parse_parts(whole Binary, frac Binary) Option(Decimal) {
	k = binary.byte_size(frac)
	match binary.parse_int(whole, binary.Dec) {
		Ok(w) -> match binary.parse_int(frac, binary.Dec) {
			Ok(f) -> Some(Decimal(w * pow10(k) + f, k))
			Err(Nil) -> None
		}
		Err(Nil) -> None
	}
}

fn pad_zeros(s String, width Int) String {
	if string.length(s) >= width {
		s
	} else {
		pad_zeros('0${s}', width)
	}
}

// `q + r/d` rounded to an integer per `mode`. `d` must be positive; `n` may
// be negative — truncating division means `r` carries the sign of `n` and
// "away from zero" is a step of `sign(n)`.
fn div_round(n Int, d Int, mode Rounding) Int {
	q = n / d
	r = int.abs(n % d)
	if r == 0 {
		q
	} else {
		match mode {
			Down -> q
			Up -> step_away(q, n)
			Floor -> if n < 0 {
				q - 1
			} else {
				q
			}
			Ceiling -> if n < 0 {
				q
			} else {
				q + 1
			}
			HalfUp -> if 2 * r >= d {
				step_away(q, n)
			} else {
				q
			}
			HalfEven -> if 2 * r > d {
				step_away(q, n)
			} else if 2 * r < d {
				q
			} else if q % 2 == 0 {
				q
			} else {
				step_away(q, n)
			}
		}
	}
}

fn div_units(n Int, d Int, mode Rounding) Int {
	if d < 0 {
		div_round(0 - n, 0 - d, mode)
	} else {
		div_round(n, d, mode)
	}
}

fn step_away(q Int, n Int) Int {
	if n < 0 {
		q - 1
	} else {
		q + 1
	}
}

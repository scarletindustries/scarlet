/**
 * VM introspection hooks; unstable, for debugging — not a stable API.
 */

// The number of stack frames in the calling process — see examples/tco.scrl.
@vm(internal__stack_depth)
pub fn stack_depth() Int

// Heap cells this process has allocated over its whole life, and cells a
// constructor overwrote in place instead of allocating, because nothing else
// held them any more.
@vm(internal__cells_made)
pub fn cells_made() Int

@vm(internal__cells_reused)
pub fn cells_reused() Int

// The number of mailboxes open across the whole program: every subject some
// process still holds, plus every supervised worker's address. A subject is
// reclaimed as soon as its owner lets go of it, so this stays flat through
// any number of request/reply exchanges — see tests/programs/messages.scrl.
@vm(internal__live_subjects)
pub fn live_subjects() Int

// Blocking-pool worker threads alive across the whole program: the OS threads
// that carry file, DNS and subprocess operations so a scheduler thread never
// blocks. The pool is elastic — it starts empty, grows on demand up to
// SCARLET_BLOCKING_THREADS (512), and lets idle workers above a warm floor
// exit — so this is a live number, not a constant. Reports threads that exist,
// busy plus parked; see tests/programs/effects.scrl.
@vm(internal__blocking_threads)
pub fn blocking_threads() Int

/**
 * The program's command-line arguments and environment. Scarlet's own
 * processes are in scarlet/process.
 */
import scarlet/map

// The path of the entrypoint that was run, then the arguments after it.
@vm(os__argv)
pub fn argv() Array(String)

// Every environment variable whose name and value are valid UTF-8. If a name
// is listed twice, the map holds its first value, as `getenv` does. The map is
// built once, on the first call.
@vm(os__env)
pub fn env() map::Map(String, String)

pub fn get_env(key String) Option(String) {
	map::get(env(), key)
}

import scarlet/net/address
import scarlet/net/socket
import scarlet/net/error
import scarlet/result
import scarlet/time
import scarlet/process
import scarlet/string

// A listening TCP socket. Only the VM makes one.
pub type Server

@vm(net__listen)
pub fn listen_addr(addr address::SocketAddress) Result(Server, error::NetError)

// Binds a listener to `host:port`, resolving `host` first with `resolve`.
pub fn listen(host String, port Int) Result(Server, error::NetError) {
	ip <- result::then(resolve(host))
	addr <- result::then(
		address::socket_address(ip, port) |> result::replace_err(error::InvalidPort),
	)
	listen_addr(addr)
}

// Accepts the next connection, parking until one arrives. `Ok(None)` means the
// `Server` was closed, and an accept loop stops there. An `Err` means the
// accept failed.
@vm(net__accept)
pub fn accept(s Server) Result(Option(socket::Socket), error::NetError)

// A running server. `net.close(service.server)` stops accepting, and open
// connections finish on their own. `process::count(service.connections)` is
// the number of open connections.
pub type Service {
	server Server
	supervised process::Supervised
	connections process::Supervised
}

// Why one connection failed: which client it was, and the network error that
// ended it.
pub type ConnectionError {
	peer address::SocketAddress
	error error::NetError
}

// Listens on `host:port` and runs `handler` for each connection in a process
// of its own, with an acceptor on every core. A handler that crashes ends only
// its own connection. When `handler` returns an `Err`, `on_error` gets it, so
// you choose what a failed connection means: log it, count it, or ignore it
// with `fn(_) Nil`. Use `serve_in` to put the server in your own tree.
pub fn serve(
	host String,
	port Int,
	handler fn(socket::Socket) Result(Nil, error::NetError),
	on_error fn(ConnectionError) Nil,
) Result(Service, error::NetError) {
	serve_in(process::supervisor(ACCEPTOR_BUDGET), host, port, handler, on_error)
}

// Like `serve`, but puts the server's subtree inside `sup`.
pub fn serve_in(
	sup process::Supervisor,
	host String,
	port Int,
	handler fn(socket::Socket) Result(Nil, error::NetError),
	on_error fn(ConnectionError) Nil,
) Result(Service, error::NetError) {
	server <- result::then(listen(host, port))
	Ok(serve_on_in(sup, server, handler, on_error))
}

// Serves a listener already bound with `listen`, for example on port 0 with
// the port read back by `local_addr`.
pub fn serve_on(
	server Server,
	handler fn(socket::Socket) Result(Nil, error::NetError),
	on_error fn(ConnectionError) Nil,
) Service {
	serve_on_in(process::supervisor(ACCEPTOR_BUDGET), server, handler, on_error)
}

// Like `serve_on`, but inside `sup`. The connection factory is declared before
// the acceptors, so it's stopped after them. That way a stopping server stops
// accepting before it closes what it accepted.
pub fn serve_on_in(
	sup process::Supervisor,
	server Server,
	handler fn(socket::Socket) Result(Nil, error::NetError),
	on_error fn(ConnectionError) Nil,
) Service {
	me = process::supervisor_in(sup, ACCEPTOR_BUDGET)
	connections = process::factory(me, process::Disposable, fn(_inbox, sock) {
		// The acceptor owns the socket until now. Giving it to this process
		// means it closes when this process ends, however it ends.
		give(sock, process::self())
		handler(sock) or e -> on_error(ConnectionError(peer: sock.peer, error: e))
	})
	process::worker_per_scheduler(
		me,
		process::Transient,
		fn(_inbox) accept_loop(server, connections),
	)
	Service(server: server, supervised: me.supervised, connections: connections.supervised)
}

// A listener that cannot accept makes every acceptor fail at once. This budget
// runs out within a second or two, so the failure moves up the tree instead of
// being retried for ever.
const ACCEPTOR_BUDGET = process::OneForOne(restarts: 10, within_ms: 5000)

// Makes `to` the process whose end closes `sock`. `to` must be on the core
// that holds the socket.
@vm(net__give)
fn give(sock socket::Socket, to process::Pid) Nil

fn accept_loop(server Server, connections process::Factory(Nil, socket::Socket)) Nil {
	match accept(server) {
		Ok(Some(sock)) -> {
			_ = process::start_in(connections, sock)
			accept_loop(server, connections)
		}
		Ok(None) -> Nil
		Err(e) -> accept_failed(e, server, connections)
	}
}

// The network errors in the first arm are ones accept(2) reports for a
// connection that died in the queue, not for a dead listener, so the loop
// retries them. An unmapped errno is usually EMFILE, which dequeues nothing, so
// the loop waits 100 ms instead of spinning. The rest mean the listener itself
// is broken, so the loop stops.
fn accept_failed(
	e error::NetError,
	server Server,
	connections process::Factory(Nil, socket::Socket),
) Nil {
	match e {
		error::ConnectionAborted
		| error::ConnectionReset
		| error::NetworkDown
		| error::NetworkUnreachable
		| error::HostUnreachable -> accept_loop(server, connections)
		error::Errno(_) -> {
			process::sleep(100)
			accept_loop(server, connections)
		}
		error::TimedOut
		| error::ConnectionRefused
		| error::NotConnected
		| error::BrokenPipe
		| error::AddrInUse
		| error::AddrNotAvailable
		| error::PermissionDenied
		| error::UnexpectedEof
		| error::MessageTooLarge(_)
		| error::UnalignedBinary
		| error::InvalidPort -> {
			println('accept failed: ${string::inspect(e)}')
			process::kill(process::self())
		}
	}
}

// Resolves `host` to an IP address. An IP literal passes straight through, and
// a hostname is looked up with getaddrinfo, off the scheduler's threads.
@vm(net__resolve)
pub fn resolve(host String) Result(address::IpAddress, error::NetError)

// Like `resolve`, but returns `Err(TimedOut)` after `timeout_ms`, even if the
// lookup answers later. An IP literal is `Ok` on any budget. A lookup can't be
// cancelled, so a late one still runs to the end and its answer is thrown
// away.
pub fn resolve_within(host String, timeout_ms Int) Result(address::IpAddress, error::NetError) {
	resolve_until(host, time::add_ms(time::monotonic(), timeout_ms))
}

// Like `resolve_within`, but takes a `deadline` from `time::monotonic()`, for
// when one deadline covers several steps.
pub fn resolve_until(
	host String,
	deadline time::Instant,
) Result(address::IpAddress, error::NetError) {
	resolve_until_ms(host, time::to_monotonic_ms(deadline))
}

@vm(net__resolve_until)
fn resolve_until_ms(host String, deadline_ms Int) Result(address::IpAddress, error::NetError)

// Connects to `host:port`, resolving `host` first with `resolve`. It has no
// deadline of its own. To set one, use `connect_within`.
pub fn connect(host String, port Int) Result(socket::Socket, error::NetError) {
	ip <- result::then(resolve(host))
	addr <- result::then(
		address::socket_address(ip, port) |> result::replace_err(error::InvalidPort),
	)
	connect_addr(addr)
}

// Like `connect`, but waits at most `timeout_ms` for the resolve and the
// connect together.
pub fn connect_within(
	host String,
	port Int,
	timeout_ms Int,
) Result(socket::Socket, error::NetError) {
	connect_until(host, port, time::add_ms(time::monotonic(), timeout_ms))
}

// Like `connect_within`, but takes a `deadline` from `time::monotonic()`, for
// when one deadline covers several steps.
pub fn connect_until(
	host String,
	port Int,
	deadline time::Instant,
) Result(socket::Socket, error::NetError) {
	ip <- result::then(resolve_until(host, deadline))
	addr <- result::then(
		address::socket_address(ip, port) |> result::replace_err(error::InvalidPort),
	)
	connect_addr_until(addr, deadline)
}

@vm(net__connect)
pub fn connect_addr(addr address::SocketAddress) Result(socket::Socket, error::NetError)

// Like `connect_addr`, but returns `Err(TimedOut)` after `timeout_ms`. On
// Darwin the kernel gives up on its own after about 75 seconds, so a longer
// timeout does nothing there.
pub fn connect_addr_within(
	addr address::SocketAddress,
	timeout_ms Int,
) Result(socket::Socket, error::NetError) {
	connect_addr_until(addr, time::add_ms(time::monotonic(), timeout_ms))
}

// Like `connect_addr_within`, but takes a `deadline` from `time::monotonic()`.
pub fn connect_addr_until(
	addr address::SocketAddress,
	deadline time::Instant,
) Result(socket::Socket, error::NetError) {
	connect_addr_until_ms(addr, time::to_monotonic_ms(deadline))
}

@vm(net__connect_until)
fn connect_addr_until_ms(
	addr address::SocketAddress,
	deadline_ms Int,
) Result(socket::Socket, error::NetError)

// The address the listener is bound to, such as the port the kernel chose for
// port 0.
@vm(net__local_addr)
pub fn local_addr(s Server) Result(address::SocketAddress, error::NetError)

// Closes the listener. Every `accept` on it, parked now or called later,
// returns `Ok(None)`.
@vm(net__close)
pub fn close(s Server) Result(Nil, error::NetError)

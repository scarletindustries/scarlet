import scarlet/binary
import scarlet/option

// Parses JSON with SIMD and reads it in place. `parse` gives a `Doc`, which is
// a cursor over the parser's tape, so reading six fields of a big payload
// copies only six strings. `to_json` builds the whole tree for the few cases
// that need one. To decode into your own types, use `scarlet/json/decode`.
//
// Parsing follows RFC 8259 strictly, so it refuses comments, trailing commas,
// `NaN` and trailing bytes. Duplicate keys are kept, and `field` finds the
// first. An integer past 64 bits
// doesn't parse, and an unpaired surrogate escape like `\ud800` is an error.

// A `Doc` is opaque because a hand-built one could point at a node that
// doesn't exist.
pub opaque type Doc {
	arena Binary
	tape Binary
	idx Int
}

// `offset` is the byte the parser stopped at.
pub type ParseError {
	offset Int
	reason ParseReason
}

/** Why a document did not parse. */
pub type ParseReason {
	/** The input ended inside a value. */
	UnexpectedEnd
	/** A byte that cannot start or continue a value where it is. */
	UnexpectedByte
	/** Something follows the one top-level value. */
	TrailingData
	/** A string that never closes. */
	UnterminatedString
	/** A `\` escape JSON does not have. */
	BadEscape
	/** A `\u` escape that is not a code point, or half a surrogate pair. */
	BadUnicode
	/** A number JSON does not allow. */
	BadNumber
	/** The input is not UTF-8. */
	NotUtf8
	/** The input is not a whole number of bytes. */
	NotWholeBytes
	/** The document has too many values or too much text to index. */
	TooLarge
}

// A number with no fraction or exponent is an `IntKind`, so big ids survive.
pub type Kind {
	NullKind
	BoolKind
	IntKind
	FloatKind
	StringKind
	ArrayKind
	ObjectKind
}

// A JSON tree for building documents to send. Reading uses `Doc` instead. The
// variants are called `Boolean`, `Integer` and `Real` because `Bool`, `Int`
// and `Float` are taken.
pub type Json {
	Null
	Boolean(value Bool)
	Integer(value Int)
	Real(value Float)
	Str(value String)
	List(items Array(Json))
	Object(members Array((String, Json)))
	// A number written as exactly these digits, for one that must not round
	// through a `Float`. `encode` writes `null` if `digits` isn't a JSON
	// number.
	Number(digits String)
}

@vm(json__parse_binary)
fn parse_binary_raw(src Binary) Result(Doc, ParseError)

@vm(json__kind)
fn kind_raw(d Doc) Int

@vm(json__len)
fn len_raw(d Doc) Int

// Finds the first member named `name`. `None` means it's absent, and a member
// set to `null` is `Some` of a `NullKind` doc. `json/decode`'s `Field` keeps
// the two apart.
@vm(json__field)
pub fn field(d Doc, name String) Option(Doc)

@vm(json__index)
pub fn index(d Doc, i Int) Option(Doc)

// Lists an object's members in document order, duplicates included. It's
// empty for anything that isn't an object.
@vm(json__entries)
pub fn entries(d Doc) Array((String, Doc))

// Returns the string, already unescaped.
@vm(json__string)
pub fn string(d Doc) Option(String)

// Returns `None` for a float.
@vm(json__int)
pub fn int(d Doc) Option(Int)

// The integer at `d` in decimal, for passing a number through as text.
@vm(json__int_text)
pub fn int_text(d Doc) Option(String)

// Returns integers as floats too.
@vm(json__float)
pub fn float(d Doc) Option(Float)

@vm(json__bool)
pub fn bool(d Doc) Option(Bool)

@vm(json__encode)
pub fn encode(j Json) String

// Parses UTF-8 bytes, such as ones that came in over a socket.
pub fn parse_binary(src Binary) Result(Doc, ParseError) {
	parse_binary_raw(src)
}

pub fn parse(src String) Result(Doc, ParseError) {
	src |> binary::from_string |> parse_binary_raw
}

// `kind_raw` is -1 for a tape that doesn't decode. That must read as the kind
// that grants the least, because `ObjectKind` would let
// `decode.optional_field` treat a corrupt document as an object missing a
// member.
pub fn kind(d Doc) Kind {
	match kind_raw(d) {
		0 -> NullKind
		1 -> BoolKind
		2 -> IntKind
		3 -> FloatKind
		4 -> StringKind
		5 -> ArrayKind
		6 -> ObjectKind
		_ -> NullKind
	}
}

// A missing member has no `Doc`, so this is only ever about a present `null`.
pub fn is_null(d Doc) Bool {
	kind_raw(d) == 0
}

// Counts the elements of an array or the members of an object. It's zero for
// a scalar.
pub fn size(d Doc) Int {
	n = len_raw(d)
	if n < 0 { 0 } else { n }
}

// Lists an array's elements in one walk, and is empty for anything else.
// Calling `index` per element instead would be O(n²) in a count the sender
// chooses.
@vm(json__elements)
pub fn elements(d Doc) Array(Doc)

// Builds the whole document as a tree, with an allocation per node whether you
// read it or not. It's for passing a document through. To get your own types,
// decode from the `Doc`.
pub fn to_json(d Doc) Json {
	match kind(d) {
		NullKind -> Null
		BoolKind -> Boolean(bool(d) |> option::unwrap(False))
		// Never default to `0` here, because `reencode` would then zero every
		// id it touched.
		IntKind -> match int(d) {
			Some(i) -> Integer(i)
			None -> match int_text(d) {
				Some(digits) -> Number(digits)
				None -> Null
			}
		}
		FloatKind -> Real(float(d) |> option::unwrap(0.0))
		StringKind -> Str(string(d) |> option::unwrap(''))
		ArrayKind -> List(array_map_to_json(elements(d)))
		ObjectKind -> Object(entries_to_json(entries(d)))
	}
}

fn array_map_to_json(ds Array(Doc)) Array(Json) {
	match ds {
		[] -> []
		[head, ..tail] -> [to_json(head), ..array_map_to_json(tail)]
	}
}

fn entries_to_json(es Array((String, Doc))) Array((String, Json)) {
	match es {
		[] -> []
		[head, ..tail] -> {
			(k, v) = head
			[(k, to_json(v)), ..entries_to_json(tail)]
		}
	}
}

// Writes the document back out. It keeps key order and duplicate keys, and
// drops whitespace.
pub fn reencode(d Doc) String {
	d |> to_json |> encode
}

pub fn parse_error_message(e ParseError) String {
	ParseError(offset, reason) = e
	text = match reason {
		UnexpectedEnd -> 'unexpected end of input'
		UnexpectedByte -> 'unexpected character'
		TrailingData -> 'trailing data after the value'
		UnterminatedString -> 'unterminated string'
		BadEscape -> 'invalid escape'
		BadUnicode -> 'invalid unicode escape'
		BadNumber -> 'invalid number'
		NotUtf8 -> 'input is not utf-8'
		NotWholeBytes -> 'input is not a whole number of bytes'
		TooLarge -> 'document is too large to index'
	}
	'${text} (at byte ${offset})'
}

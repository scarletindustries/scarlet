/**
 * UTF-8 strings. There is no indexing. Everything here counts Unicode scalar
 * values, so no character is cut in half, except `to_graphemes`, which gives
 * what a person would call characters.
 */

import scarlet/array
import scarlet/binary
import scarlet/int
import scarlet/result

// Any value as `println` prints it.
@vm(string__inspect)
pub fn inspect(x a) String

// Adjacent delimiters give empty pieces. An empty `on` splits into single
// scalar values.
@vm(string__split)
pub fn split(s String, on String) Array(String)

// Unicode scalar values, not bytes. O(n).
@vm(string__length)
pub fn length(s String) Int

// An empty needle is always found.
@vm(string__contains)
pub fn contains(s String, needle String) Bool

@vm(string__trim)
pub fn trim(s String) String

// Every occurrence of `pattern`, left to right. An empty `pattern` puts
// `replacement` between every two scalar values.
pub fn replace(s String, pattern String, replacement String) String {
	match split(s, pattern) {
		[] -> s
		[first, ..rest] -> array.fold(rest, first, fn(acc, piece) acc + replacement + piece)
	}
}

// The extended grapheme clusters of `s` (UAX #29): a base and its combining
// marks, or a whole ZWJ sequence, stay one piece.
@vm(string__to_graphemes)
pub fn to_graphemes(s String) Array(String)

// `Err(Nil)` if `code_point` is not a scalar value: negative, past U+10FFFF,
// or a surrogate (U+D800..U+DFFF, 55296..57343).
fn encode_scalar_value(code_point Int) Result(Binary, Nil) {
	if code_point < 0 || code_point > 1114111 {
		Err(Nil)
	} else if code_point >= 55296 && code_point <= 57343 {
		Err(Nil)
	} else if code_point <= 127 {
		Ok(<<code_point:8>>)
	} else if code_point <= 2047 {
		Ok(<<
			192 + int.bitwise_shift_right(code_point, 6):8,
			128 + int.bitwise_and(code_point, 63):8,
		>>)
	} else if code_point <= 65535 {
		Ok(<<
			224 + int.bitwise_shift_right(code_point, 12):8,
			128 + int.bitwise_and(int.bitwise_shift_right(code_point, 6), 63):8,
			128 + int.bitwise_and(code_point, 63):8,
		>>)
	} else {
		Ok(<<
			240 + int.bitwise_shift_right(code_point, 18):8,
			128 + int.bitwise_and(int.bitwise_shift_right(code_point, 12), 63):8,
			128 + int.bitwise_and(int.bitwise_shift_right(code_point, 6), 63):8,
			128 + int.bitwise_and(code_point, 63):8,
		>>)
	}
}

// `Err(Nil)` if any of them is not a Unicode scalar value.
pub fn from_code_points(code_points Array(Int)) Result(String, Nil) {
	result.then(
		array.fold(
			code_points,
			Ok(<<>>),
			fn(acc, cp) result.then(
				acc,
				fn(bytes) result.map(encode_scalar_value(cp), fn(next) binary.append(bytes, next)),
			),
		),
		fn(bytes) binary.to_string(bytes),
	)
}

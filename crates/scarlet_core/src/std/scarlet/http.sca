import scarlet/http/h1
import scarlet/http/body
import scarlet/http/headers
import scarlet/net
import scarlet/process
import scarlet/net/socket
import scarlet/net/error
import scarlet/binary
import scarlet/int
import scarlet/result
import scarlet/time

// The HTTP/1.1 server. This module has the Request and Response a handler
// sees, and the driver that reads requests off a socket and writes responses
// back. Parsing and framing live in scarlet/http/h1, and streaming bodies in
// scarlet/http/body.
//
// A request body is read whole, up to MAX_BODY, before the handler runs, and
// the connection is reused only after that. That way leftover body bytes can
// never be read as the next pipelined request, which is how request smuggling
// works. A body over the cap gets 413 before any of it is read.

pub type Method {
	Get
	Post
	Put
	Delete
	Patch
	Head
	Options
	Other(name Binary)
}

pub type Request {
	method Method
	// The target as it came on the wire (RFC 9112 §3.2). It's usually a path
	// and `?query`, but it may be `*` or an absolute URI. `path` and `query`
	// split the usual form.
	target Binary
	version h1::Version
	headers headers::Headers
	// `Connection` and `Expect`, read once from the header section as it
	// arrived, so a handler that rewrites `headers` can't change them.
	flags h1::HeadFlags
	// Fields that came after a chunked body. They're kept apart from `headers`
	// because RFC 9110 §6.5.1 says they must not decide Connection or Expect.
	trailers headers::Headers
	body body::Body
}

// How a response body is framed. `Fixed` promises exactly `len` bytes, so the
// driver writes Content-Length and checks the count. `Unsized` is chunked on
// HTTP/1.1, and ends with the connection on HTTP/1.0.
pub type ResponseBody {
	Fixed(len Int, b body::Body)
	Unsized(b body::Body)
}

pub type Response {
	status Int
	headers headers::Headers
	body ResponseBody
}

type ReqHead {
	method Binary
	target Binary
	version h1::Version
	headers headers::Headers
	flags h1::HeadFlags
}

// What writing one response decided. KeepAlive carries the bytes still
// queued for the next write. Close means everything owed is already flushed.
type Sent {
	KeepAlive(pending Array(Binary))
	Close
}

// The largest request body. A bigger Content-Length gets 413. Together with
// BODY_TIMEOUT_MS, this means a slow upload can't fill memory or hold the
// connection.
const MAX_BODY = 1048576
const READ_SIZE = 65536
// One deadline per request head, not per read, so a client sending a byte at
// a time can't keep resetting it. It also bounds an idle keep-alive
// connection.
const HEAD_TIMEOUT_MS = 30000
// Like HEAD_TIMEOUT_MS, one deadline covers the whole request body.
const BODY_TIMEOUT_MS = 30000
const EMPTY = <<>>
const QUESTION = <<'?'>>

const NAME_CONTENT_TYPE = <<'Content-Type'>>
const NAME_CONTENT_LENGTH = <<'Content-Length'>>
const NAME_CONNECTION = <<'Connection'>>
const VAL_TEXT_PLAIN = <<'text/plain; charset=utf-8'>>
const VAL_CLOSE = <<'close'>>
const VAL_KEEP_ALIVE = <<'keep-alive'>>
const ZERO = <<'0'>>
const NAME_TRANSFER_ENCODING = <<'Transfer-Encoding'>>
const VAL_CHUNKED = <<'chunked'>>

fn to_method(m Binary) Method {
	match m {
		<<'GET'>> -> Get
		<<'POST'>> -> Post
		<<'PUT'>> -> Put
		<<'DELETE'>> -> Delete
		<<'PATCH'>> -> Patch
		<<'HEAD'>> -> Head
		<<'OPTIONS'>> -> Options
		_ -> Other(m)
	}
}

// The target up to the first `?`, or all of it.
pub fn path(r Request) Binary {
	match binary::index_of(r.target, QUESTION, 0) {
		// `i` is inside `r.target`, so this can't fail.
		Some(i) -> match binary::slice_bytes(r.target, 0, i) {
			Ok(p) -> p
			Err(Nil) -> EMPTY
		}
		None -> r.target
	}
}

// The target after the first `?`, or empty.
pub fn query(r Request) Binary {
	match binary::index_of(r.target, QUESTION, 0) {
		Some(i) -> binary::drop_bytes(r.target, i + 1)
		None -> EMPTY
	}
}

// Makes a 200 with a body of unknown length. It's chunked on HTTP/1.1, and the
// connection closes after it on HTTP/1.0. If you know the length, use a `Fixed`
// body, as `text` does.
pub fn ok(b body::Body) Response {
	Response(status: 200, headers: [], body: Unsized(b))
}

pub fn not_found() Response {
	text_response(404, 'Not Found')
}

// Makes a 200 text/plain response with its length known.
pub fn text(s String) Response {
	text_response(200, s)
}

fn text_response(code Int, s String) Response {
	bin = binary::from_string(s)
	Response(
		status: code,
		headers: [headers::Header(name: NAME_CONTENT_TYPE, value: VAL_TEXT_PLAIN)],
		body: Fixed(binary::byte_size(bin), body::from_binary(bin)),
	)
}

// Sets a header, so that afterwards exactly one field is named `name`.
pub fn with_header(r Response, name Binary, value Binary) Response {
	Response(status: r.status, headers: headers::set(r.headers, name, value), body: r.body)
}

fn build_request(head ReqHead, trailers headers::Headers, b body::Body) Request {
	Request(
		method: to_method(head.method),
		target: head.target,
		version: head.version,
		headers: head.headers,
		flags: head.flags,
		trailers: trailers,
		body: b,
	)
}

// Listens on host:port and serves each connection in its own process, so a slow
// or crashing one affects only itself. When a connection fails, for example
// because the client hung up mid-response, `on_error` gets the error. The
// `Service` holds the listener and the connections' place in the process tree.
pub fn serve(
	host String,
	port Int,
	handler fn(Request) Response,
	on_error fn(net::ConnectionError) Nil,
) Result(net::Service, error::NetError) {
	net::serve(host, port, fn(sock) drive(sock, handler), on_error)
}

// Like `serve`, but inside your own supervisor, so it stops and restarts with
// it.
pub fn serve_in(
	sup process::Supervisor,
	host String,
	port Int,
	handler fn(Request) Response,
	on_error fn(net::ConnectionError) Nil,
) Result(net::Service, error::NetError) {
	net::serve_in(sup, host, port, fn(sock) drive(sock, handler), on_error)
}

// Serves on a listener you already bound, for example on port 0 so you can
// read the port back.
pub fn serve_on(
	server net::Server,
	handler fn(Request) Response,
	on_error fn(net::ConnectionError) Nil,
) net::Service {
	net::serve_on(server, fn(sock) drive(sock, handler), on_error)
}

// Serves one connection and closes it once on the way out, even after a
// failure. The first error is the one returned.
fn drive(sock socket::Socket, handler fn(Request) Response) Result(Nil, error::NetError) {
	served = serve_conn(sock, EMPTY, 0, head_deadline(), handler, [])
	closed = socket::close(sock)
	served |> result::then(fn(_) closed)
}

fn head_deadline() time::Instant {
	time::deadline_in_ms(HEAD_TIMEOUT_MS)
}

fn body_deadline() time::Instant {
	time::deadline_in_ms(BODY_TIMEOUT_MS)
}

// The keep-alive loop. `buf` from `off` holds bytes read but not yet parsed.
// `pending` holds responses not yet written. They go out as one write at the
// next read, so N pipelined requests cost one read and one write.
fn serve_conn(
	sock socket::Socket,
	buf Binary,
	off Int,
	deadline time::Instant,
	handler fn(Request) Response,
	pending Array(Binary),
) Result(Nil, error::NetError) {
	// There's no check for an empty window first, because parsing one gives
	// NeedMore and the check measured slower.
	match h1::parse_request(buf, off) {
		h1::NeedMore -> {
			Nil <- result::then(flush(sock, pending))
			match socket::read_until(sock, READ_SIZE, deadline) {
				Ok(socket::Data(more)) ->
					serve_conn(sock, carry(buf, off, more), 0, deadline, handler, [])
				Ok(socket::Closed) -> Ok(Nil)
				Err(e) -> Err(e)
			}
		}
		h1::Bad(status) -> reject(sock, pending, status)
		h1::Done(method, target, version, hdrs, flags, consumed) -> {
			head = ReqHead(
				method: method,
				target: target,
				version: version,
				headers: hdrs,
				flags: flags,
			)
			handle(sock, buf, consumed, head, handler, pending)
		}
	}
}

// Flushes earlier pipelined responses, then writes an error. The caller closes
// the connection.
fn reject(sock socket::Socket, pending Array(Binary), status Int) Result(Nil, error::NetError) {
	Nil <- result::then(flush(sock, pending))
	write_error(sock, status)
}

fn flush(sock socket::Socket, pending Array(Binary)) Result(Nil, error::NetError) {
	match pending {
		[] -> Ok(Nil)
		_ -> {
			Nil <- result::then(socket::write_parts(sock, pending))
			Ok(Nil)
		}
	}
}

// Joins the unread tail of `buf` and `more`. If there's no tail, `more` is used
// as it is, with no copy.
fn carry(buf Binary, off Int, more Binary) Binary {
	if binary::byte_size(buf) - off == 0 {
		more
	} else {
		binary::append(binary::drop_bytes(buf, off), more)
	}
}

fn handle(
	sock socket::Socket,
	buf Binary,
	consumed Int,
	head ReqHead,
	handler fn(Request) Response,
	pending Array(Binary),
) Result(Nil, error::NetError) {
	match h1::framing(head.headers) {
		h1::Invalid(status) -> reject(sock, pending, status)
		h1::NoBody ->
			respond_and_continue(
				sock,
				buf,
				consumed,
				build_request(head, [], body::empty()),
				handler,
				pending,
			)
		h1::Length(n) -> if n > MAX_BODY {
			reject(sock, pending, 413)
		} else {
			deadline = body_deadline()
			// Flush first, because the client may wait for those responses
			// before it sends the body.
			Nil <- result::then(flush(sock, pending))
			read_body(sock, buf, consumed, n, deadline, head, handler)
		}
		// Flush first, as for Content-Length.
		h1::Chunked -> {
			deadline = body_deadline()
			Nil <- result::then(flush(sock, pending))
			read_chunked_body(sock, buf, consumed, deadline, head, handler)
		}
	}
}

// Reads the whole Content-Length body, then runs the handler. Bytes already
// in `buf` are used first. What follows the body in `buf` is the next request.
fn read_body(
	sock socket::Socket,
	buf Binary,
	consumed Int,
	n Int,
	deadline time::Instant,
	head ReqHead,
	handler fn(Request) Response,
) Result(Nil, error::NetError) {
	Nil <- result::then(maybe_continue(sock, head.flags))
	avail = binary::byte_size(buf) - consumed
	buffered = int::min(avail, n)
	// This can't fail, because the window ends inside `buf`.
	head_bytes = match binary::slice_bytes(buf, consumed, buffered) {
		Ok(v) -> v
		Err(Nil) -> <<>>
	}
	need = n - buffered
	tail <- result::then(body::content_length(sock, need, deadline) |> body::collect(MAX_BODY))
	// `pending` was flushed before the body was read.
	req = build_request(head, [], body::from_binary(binary::append(head_bytes, tail)))
	if avail > n {
		respond_and_continue(sock, buf, consumed + n, req, handler, [])
	} else {
		respond_and_continue(sock, EMPTY, 0, req, handler, [])
	}
}

// Answers 100-continue once, then reads a chunked body.
fn read_chunked_body(
	sock socket::Socket,
	buf Binary,
	off Int,
	deadline time::Instant,
	head ReqHead,
	handler fn(Request) Response,
) Result(Nil, error::NetError) {
	Nil <- result::then(maybe_continue(sock, head.flags))
	chunked_loop(sock, buf, off, deadline, head, handler)
}

// Decodes what is buffered. On ChunkedNeedMore, it reads more and retries from
// the same offset. The decoder caps the size at MAX_BODY with 413, and
// `consumed` is the first byte after the body, where a pipelined request would
// start.
fn chunked_loop(
	sock socket::Socket,
	buf Binary,
	off Int,
	deadline time::Instant,
	head ReqHead,
	handler fn(Request) Response,
) Result(Nil, error::NetError) {
	match h1::chunk_decode(buf, off, MAX_BODY) {
		h1::ChunkedNeedMore -> match socket::read_until(sock, READ_SIZE, deadline) {
			Ok(socket::Data(more)) ->
				chunked_loop(sock, binary::append(buf, more), off, deadline, head, handler)
			// The peer closed mid-body, so there's no complete request to
			// answer.
			Ok(socket::Closed) -> Ok(Nil)
			Err(e) -> Err(e)
		}
		h1::ChunkedBad(status) -> write_error(sock, status)
		// `pending` was flushed before the body was read.
		h1::ChunkedDone(decoded, trailers, consumed) ->
			respond_and_continue(
				sock,
				buf,
				consumed,
				build_request(head, trailers, body::from_binary(decoded)),
				handler,
				[],
			)
	}
}

// A client that sent Expect: 100-continue waits for this before the body.
fn maybe_continue(sock socket::Socket, f h1::HeadFlags) Result(Nil, error::NetError) {
	if h1::want_100_continue(f) {
		socket::write(sock, h1::serialize_head(100, []))
	} else {
		Ok(Nil)
	}
}

// Runs the handler and writes the response. This is the only place the
// connection is reused, and only after the whole request body was read.
fn respond_and_continue(
	sock socket::Socket,
	leftover_buf Binary,
	leftover_off Int,
	req Request,
	handler fn(Request) Response,
	pending Array(Binary),
) Result(Nil, error::NetError) {
	resp = handler(req)
	close_after = h1::should_close(req.version, req.flags) || response_close(resp)
	match respond(sock, pending, req.method, req.version, close_after, resp) {
		Err(e) -> Err(e)
		Ok(Close) -> Ok(Nil)
		Ok(KeepAlive(still_pending)) ->
			serve_conn(sock, leftover_buf, leftover_off, head_deadline(), handler, still_pending)
	}
}

// Writes a response, framed by its body's constructor, and decides
// keep-alive. Buffered responses join `pending`, and streaming ones flush it,
// then write. A bad status, invalid headers or a negative length become a 500
// and a close.
fn respond(
	sock socket::Socket,
	pending Array(Binary),
	method Method,
	version h1::Version,
	close_after Bool,
	resp Response,
) Result(Sent, error::NetError) {
	if resp.status < 200 || resp.status > 999 {
		replace_with_500(sock, pending)
	} else if !headers::valid(resp.headers) {
		replace_with_500(sock, pending)
	} else if negative_fixed_length(resp.body) {
		replace_with_500(sock, pending)
	} else {
		hdrs = conn_headers(version, close_after, strip_framing(resp.headers))
		if suppress_body(method, resp.status) {
			head = h1::serialize_head(resp.status, head_only_headers(method, hdrs, resp.body))
			finish_buffered(sock, close_after, [..pending, head])
		} else {
			match resp.body {
				Fixed(len, b) ->
					buffer_body(
						sock,
						pending,
						close_after,
						resp.status,
						with_length(hdrs, len),
						len,
						b,
					)
				Unsized(b) -> match version {
					h1::Http11 -> {
						chunked = headers::set(hdrs, NAME_TRANSFER_ENCODING, VAL_CHUNKED)
						Nil <- result::then(flush(sock, pending))
						match body::probe(sanitize_trailers(b)) {
							// The body failed before the head was written, so a 500 can
							// still go out.
							Err(_) -> replace_with_500(sock, [])
							Ok(
								probed,
							) -> match body::drain_chunked_with_head(
								h1::serialize_head(resp.status, chunked),
								probed,
								sock,
							) {
								Ok(Nil) -> finish_buffered(sock, close_after, [])
								// The head is already out, so abort and let the
								// peer see the body cut short.
								Err(body::SourceFailed(e)) -> Err(e)
								Err(body::SinkFailed(e)) -> Err(e)
							}
						}
					}
					h1::Http10 -> {
						closing = headers::set(hdrs, NAME_CONNECTION, VAL_CLOSE)
						Nil <- result::then(flush(sock, pending))
						match body::probe(b) {
							// As above, the head isn't out yet.
							Err(_) -> replace_with_500(sock, [])
							Ok(
								probed,
							) -> match body::drain_with_head(
								h1::serialize_head(resp.status, closing),
								probed,
								sock,
							) {
								Ok(Nil) -> Ok(Close)
								// Abort. On HTTP/1.0 the peer can't tell this from a whole body.
								Err(body::SourceFailed(e)) -> Err(e)
								Err(body::SinkFailed(e)) -> Err(e)
							}
						}
					}
				}
			}
		}
	}
}

fn replace_with_500(sock socket::Socket, pending Array(Binary)) Result(Sent, error::NetError) {
	reject(sock, pending, 500) |> result::map(fn(_) Close)
}

// On keep-alive the parts wait for the next write. On close there is no
// next write, so they are flushed now.
fn finish_buffered(
	sock socket::Socket,
	close_after Bool,
	parts Array(Binary),
) Result(Sent, error::NetError) {
	if close_after {
		Nil <- result::then(flush(sock, parts))
		Ok(Close)
	} else {
		Ok(KeepAlive(parts))
	}
}

// The driver writes the framing headers itself, from the ResponseBody, so
// any the handler set are dropped.
fn strip_framing(hs headers::Headers) headers::Headers {
	hs |> headers::delete(NAME_CONTENT_LENGTH) |> headers::delete(NAME_TRANSFER_ENCODING)
}

// HTTP/1.0 closes by default, so keeping one alive must say `keep-alive`.
// HTTP/1.1 stays open by default, so closing must say `close` (RFC 9112 §9.6).
fn conn_headers(version h1::Version, close_after Bool, hs headers::Headers) headers::Headers {
	match version {
		h1::Http10 -> if close_after {
			hs
		} else {
			headers::set(hs, NAME_CONNECTION, VAL_KEEP_ALIVE)
		}
		h1::Http11 -> if close_after {
			headers::set(hs, NAME_CONNECTION, VAL_CLOSE)
		} else {
			hs
		}
	}
}

// A HEAD response still gives the length a GET would have (RFC 9110 §8.6).
// 204 and 304 give none.
fn head_only_headers(method Method, hs headers::Headers, b ResponseBody) headers::Headers {
	match (method, b) {
		(Head, Fixed(len, _)) -> with_length(hs, len)
		(Head, Unsized(_)) -> hs
		(Get | Post | Put | Delete | Patch | Options | Other(_), _) -> hs
	}
}

// A plain prepend is enough, because strip_framing already removed
// Content-Length and field order doesn't matter (RFC 9110 §5.3).
fn with_length(hs headers::Headers, len Int) headers::Headers {
	[
		headers::Header(name: NAME_CONTENT_LENGTH, value: binary::from_int_ascii(len, binary::Dec)),
		..hs,
	]
}

// This is checked before writing, because a HEAD response would put
// `Content-Length: -1` on the wire without ever counting the body.
fn negative_fixed_length(b ResponseBody) Bool {
	match b {
		Fixed(len, _) -> len < 0
		Unsized(_) -> False
	}
}

// Holds a Fixed body to exactly `len` bytes. A body already in memory joins
// `pending`, and a stream flushes and drains, cut off at `len`. A mismatch
// before the head is written gives a 500. After the head is written, the
// connection must close.
fn buffer_body(
	sock socket::Socket,
	pending Array(Binary),
	close_after Bool,
	status Int,
	hdrs headers::Headers,
	len Int,
	b body::Body,
) Result(Sent, error::NetError) {
	match body::take_buffered(b) {
		// The body has only been pulled so far and nothing is written, so a 500
		// can still go out.
		Err(_) -> replace_with_500(sock, pending)
		Ok(body::Empty) -> if len == 0 {
			finish_buffered(sock, close_after, [..pending, h1::serialize_head(status, hdrs)])
		} else {
			replace_with_500(sock, pending)
		}
		Ok(body::Whole(data)) -> if binary::byte_size(data) == len {
			finish_buffered(sock, close_after, [..pending, h1::serialize_head(status, hdrs), data])
		} else {
			replace_with_500(sock, pending)
		}
		Ok(body::Streaming(first, second, rest)) -> {
			got = binary::byte_size(first) + binary::byte_size(second)
			if got > len {
				replace_with_500(sock, pending)
			} else {
				Nil <- result::then(
					flush(sock, [..pending, h1::serialize_head(status, hdrs), first, second]),
				)
				match body::drain_counted(rest, sock, len - got) {
					// The head is already out, so abort and let the peer see
					// the body cut short.
					Err(body::SourceFailed(e)) -> Err(e)
					Err(body::SinkFailed(e)) -> Err(e)
					Ok(body::Complete) -> finish_buffered(sock, close_after, [])
					// Closing is the only way to keep the next response in frame.
					Ok(body::Short(_)) -> Ok(Close)
					Ok(body::Overran(_)) -> Ok(Close)
				}
			}
		}
	}
}

// Drops trailers that fail headers::valid, because if they were written they
// could split the response. Trailers are optional, so dropping them is always
// allowed.
fn sanitize_trailers(b body::Body) body::Body {
	fn() match body::pull(b) {
		Ok(body::Chunk(data, next)) -> Ok(body::Chunk(data, sanitize_trailers(next)))
		Ok(body::Done(trailers)) -> if headers::valid(trailers) {
			Ok(body::Done(trailers))
		} else {
			Ok(body::Done([]))
		}
		Err(e) -> Err(e)
	}
}

// RFC 9110 says HEAD, 204 and 304 responses have no body.
fn suppress_body(method Method, status Int) Bool {
	match method {
		Head -> True
		Get | Post | Put | Delete | Patch | Options | Other(_) -> status == 204 || status == 304
	}
}

// `Connection` is a token list, so `close` may be one of several.
fn response_close(resp Response) Bool {
	headers::contains_token(resp.headers, NAME_CONNECTION, VAL_CLOSE)
}

// A minimal error response, so the client sees the status before the close.
fn write_error(sock socket::Socket, status Int) Result(Nil, error::NetError) {
	hdrs = [
		headers::Header(name: NAME_CONTENT_LENGTH, value: ZERO),
		headers::Header(name: NAME_CONNECTION, value: VAL_CLOSE),
	]
	socket::write(sock, h1::serialize_head(status, hdrs))
}

/**
 * Immutable arrays. Every operation returns a new array, and any other holder
 * of its input still sees the input as it was.
 */

// An array of `n` elements that are all `x`, and `[]` when `n` is 0 or less.
pub fn repeat(x a, n Int) Array(a) {
	repeat_onto([], x, n)
}

fn repeat_onto(acc Array(a), x a, n Int) Array(a) {
	left = n - length(acc)
	if left <= 0 {
		acc
	} else {
		repeat_onto(push_copies(acc, x, left), x, n)
	}
}

// `xs` and then `n` times `x`, but no more than 1024 times, so that no call runs
// for long.
@vm(array__push_copies)
fn push_copies(xs Array(a), x a, n Int) Array(a)

pub fn map(xs Array(a), f fn(a) b) Array(b) {
	map_onto([], xs, f)
}

fn map_onto(acc Array(b), xs Array(a), f fn(a) b) Array(b) {
	match xs {
		[] -> acc
		[h, ..t] -> map_onto([..acc, f(h)], t, f)
	}
}

pub fn filter(xs Array(a), p fn(a) Bool) Array(a) {
	filter_onto([], xs, p)
}

fn filter_onto(acc Array(a), xs Array(a), p fn(a) Bool) Array(a) {
	match xs {
		[] -> acc
		[h, ..t] -> if p(h) {
			filter_onto([..acc, h], t, p)
		} else {
			filter_onto(acc, t, p)
		}
	}
}

// Folds from the first element to the last.
pub fn fold(xs Array(a), init b, f fn(b, a) b) b {
	match xs {
		[] -> init
		[h, ..t] -> fold(t, f(init, h), f)
	}
}

// Calls `f` on each element for its side effects. To get a value out, use
// `map` or `fold`.
pub fn each(xs Array(a), f fn(a) Nil) Nil {
	match xs {
		[] -> Nil
		[h, ..t] -> {
			f(h)
			each(t, f)
		}
	}
}

pub fn reverse(xs Array(a)) Array(a) {
	reverse_onto([], xs)
}

fn reverse_onto(acc Array(a), xs Array(a)) Array(a) {
	match xs {
		[] -> acc
		[h, ..t] -> reverse_onto([h, ..acc], t)
	}
}

// Takes O(1) time.
@vm(array__length)
pub fn length(xs Array(a)) Int

// `Ok` of the array with `x` at index `i`, or `Err(Nil)` when `i` is outside
// the array. When nothing else holds `xs` and nothing reads `xs` after a write,
// it is changed in place and nothing is copied. An `Err` arm of a `match` on the
// call runs only when nothing was written, so it may give `xs` back.
@vm(array__set)
pub fn set(xs Array(a), i Int, x a) Result(Array(a), Nil)

// The array with `x` at index `i`. An index outside the array changes
// nothing. When nothing else holds `xs` and nothing reads `xs` after the
// call, it is changed in place and nothing is copied.
@vm(array__put)
pub fn put(xs Array(a), i Int, x a) Array(a)

// The array with the elements at `i` and `j` changed over. An index outside
// the array changes nothing.
pub fn swap(xs Array(a), i Int, j Int) Array(a) {
	match xs[i] {
		None -> xs
		Some(x) -> match xs[j] {
			None -> xs
			Some(y) -> xs |> put(i, y) |> put(j, x)
		}
	}
}

pub fn contains(xs Array(a), target a) Bool {
	contains_from(xs, target, 0)
}

// This runs none of the program's code, so it need not give up the elements that
// it has passed, as the searches below do.
fn contains_from(xs Array(a), target a, i Int) Bool {
	match xs[i] {
		None -> False
		Some(x) -> if x == target {
			True
		} else {
			contains_from(xs, target, i + 1)
		}
	}
}

pub fn find(xs Array(a), p fn(a) Bool) Option(a) {
	match xs {
		[] -> None
		[h, ..t] -> if p(h) {
			Some(h)
		} else {
			find(t, p)
		}
	}
}

// Returns False for an empty array.
pub fn any(xs Array(a), p fn(a) Bool) Bool {
	match xs {
		[] -> False
		[h, ..t] -> if p(h) {
			True
		} else {
			any(t, p)
		}
	}
}

// Returns True for an empty array.
pub fn all(xs Array(a), p fn(a) Bool) Bool {
	match xs {
		[] -> True
		[h, ..t] -> if p(h) {
			all(t, p)
		} else {
			False
		}
	}
}

// Joins two arrays. The shorter one is added to the longer, so a join costs as
// much as the shorter one is long.
pub fn concat(xs Array(a), ys Array(a)) Array(a) {
	[..xs, ..ys]
}

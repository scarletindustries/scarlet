import scarlet/array
import scarlet/int

@vm(binary__from_string)
pub fn from_string(s String) Binary

@vm(binary__to_string)
pub fn to_string(b Binary) Result(String, Nil)

@vm(binary__bit_size)
pub fn bit_size(b Binary) Int

@vm(binary__byte_size)
pub fn byte_size(b Binary) Int

// `take_bits` bits from bit `at_bit`, sharing `b` without copying. A window
// past either end is `Err(Nil)`, never a short read. Each offset here names its
// unit, bits or bytes, because a mix-up would still give a valid binary.
@vm(binary__slice_bits)
pub fn slice_bits(b Binary, at_bit Int, take_bits Int) Result(Binary, Nil)

// `len` bytes from byte `at`, sharing `b` without copying. A window past
// either end is `Err(Nil)`. A last partial byte needs `slice_bits`.
pub fn slice_bytes(b Binary, at Int, len Int) Result(Binary, Nil) {
	slice_bits(b, at * 8, len * 8)
}

// Everything from byte `at` on: `<<>>` past the end, and all of `b` for a
// negative `at`.
pub fn drop_bytes(b Binary, at Int) Binary {
	total = bit_size(b)
	skip = if at <= 0 {
		0
	} else if at >= byte_size(b) {
		total
	} else {
		at * 8
	}
	if skip >= total {
		<<>>
	} else {
		match slice_bits(b, skip, total - skip) {
			Ok(v) -> v
			// Unreachable: the window is exactly the tail.
			Err(Nil) -> <<>>
		}
	}
}

// `b` cut at byte `at`, clamped to the binary, so
// `append(prefix, suffix) == b` for every `at`.
pub fn split_at_bytes(b Binary, at Int) (Binary, Binary) {
	total = bit_size(b)
	cut = if at <= 0 {
		0
	} else if at >= byte_size(b) {
		total
	} else {
		at * 8
	}
	prefix = if cut <= 0 {
		<<>>
	} else {
		match slice_bits(b, 0, cut) {
			Ok(v) -> v
			// Unreachable: the window is exactly the head.
			Err(Nil) -> <<>>
		}
	}
	(prefix, drop_bytes(b, at))
}

@vm(binary__append)
pub fn append(a Binary, b Binary) Binary

pub fn concat(parts Array(Binary)) Binary {
	array.fold(parts, <<>>, fn(acc, p) append(acc, p))
}

@vm(binary__index_of)
pub fn index_of(haystack Binary, needle Binary, from Int) Option(Int)

// The byte at `i`, or -1 out of range. Not an Option, so a scanner allocates
// nothing per byte.
@vm(binary__byte_at)
pub fn byte_at(b Binary, i Int) Int

pub type Radix {
	Dec
	Hex
}

@vm(binary__parse_int)
fn parse_int_raw(b Binary, radix Radix) Option(Int)

// ASCII digits only, with no sign. Any number of digits is fine, so a caller
// that needs a limit checks the Int it gets.
pub fn parse_int(b Binary, radix Radix) Result(Int, Nil) {
	match parse_int_raw(b, radix) {
		Some(n) -> Ok(n)
		None -> Err(Nil)
	}
}

@vm(binary__eq_ignore_ascii_case)
pub fn eq_ignore_ascii_case(a Binary, b Binary) Bool

@vm(binary__to_ascii_lower)
pub fn to_ascii_lower(b Binary) Binary

@vm(binary__from_int_ascii)
pub fn from_int_ascii(n Int, radix Radix) Binary

// Two uppercase hex digits of the low 8 bits of `n`: `hex_byte(13)` is
// `<<'0D'>>`. For `%XX` escapes, which RFC 3986 §2.1 prefers uppercase.
pub fn hex_byte(n Int) Binary {
	b = int.bitwise_and(n, 255)
	<<hex_digit(int.bitwise_shift_right(b, 4)):8, hex_digit(int.bitwise_and(b, 15)):8>>
}

fn hex_digit(n Int) Int {
	if n < 10 {
		48 + n
	} else {
		// 'A' is 65, and this range starts at 10.
		55 + n
	}
}

/**
 * The operating-system process the program runs as: its arguments and its
 * environment. (Scarlet's own lightweight processes live in scarlet/process.)
 */
import scarlet/map

// The program's command-line arguments. The first element is the path to the
// entrypoint that was run; the rest are the arguments passed after it, in order.
@vm(os__argv)
pub fn argv() Array(String)

// The environment as a `Map(String, String)`: every variable whose name and
// value are both valid UTF-8. A name the OS lists twice has its first value,
// as the OS's own `getenv` gives. Nothing in a program changes its
// environment, so the map is made once, the first time it is asked for, and
// every call after returns that same map.
@vm(os__env)
pub fn env() map.Map(String, String)

// Look up a single environment variable, returning `Some(value)` if it is set
// (and valid UTF-8) and `None` otherwise.
pub fn get_env(key String) Option(String) {
	map.get(env(), key)
}

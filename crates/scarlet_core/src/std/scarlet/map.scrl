import scarlet/array

// An immutable map. `set` and `delete` return a new map and leave the old one
// as it was; the two share structure, so neither is a copy.
pub type Map(k, v)

@vm(map__new)
pub fn new() Map(k, v)

@vm(map__set)
pub fn set(m Map(k, v), key k, value v) Map(k, v)

@vm(map__delete)
pub fn delete(m Map(k, v), key k) Map(k, v)

@vm(map__get)
pub fn get(m Map(k, v), key k) Option(v)

@vm(map__has)
pub fn has(m Map(k, v), key k) Bool

// In the map's own order: two equal maps list their keys the same way.
@vm(map__keys)
pub fn keys(m Map(k, v)) Array(k)

// In the same order as `keys`.
@vm(map__values)
pub fn values(m Map(k, v)) Array(v)

@vm(map__size)
pub fn size(m Map(k, v)) Int

// Every `(key, value)` pair, in the same order as `keys`.
@vm(map__to_list)
pub fn to_list(m Map(k, v)) Array((k, v))

// On a repeated key, the later entry wins.
pub fn from_list(entries Array((k, v))) Map(k, v) {
	array.fold(entries, new(), fn(acc, entry) match entry {
		(key, value) -> set(acc, key, value)
	})
}

// Calls `f` with the accumulator, key and value of each entry, in the same
// order as `keys`.
pub fn fold(m Map(k, v), init r, f fn(r, k, v) r) r {
	array.fold(to_list(m), init, fn(acc, entry) match entry {
		(key, value) -> f(acc, key, value)
	})
}

// Every entry of `a` and `b`. On a shared key, `b`'s value wins.
pub fn merge(a Map(k, v), b Map(k, v)) Map(k, v) {
	fold(b, a, fn(acc, key, value) set(acc, key, value))
}

pub fn filter(m Map(k, v), keep fn(k, v) Bool) Map(k, v) {
	fold(m, new(), fn(acc, key, value) if keep(key, value) {
		set(acc, key, value)
	} else {
		acc
	})
}

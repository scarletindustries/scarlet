pub fn map(r Result(a, e), f fn(a) b) Result(b, e) {
	match r {
		Ok(a) -> Ok(f(a))
		Err(e) -> Err(e)
	}
}

pub fn map_err(r Result(a, e), f fn(e) e2) Result(a, e2) {
	match r {
		Ok(a) -> Ok(a)
		Err(e) -> Err(f(e))
	}
}

// Gives a `Result(_, Nil)` a real error. Only for `Nil` errors, so that no
// error with data in it is dropped by accident; use `map_err` for those.
pub fn replace_err(r Result(a, Nil), err e) Result(a, e) {
	match r {
		Ok(a) -> Ok(a)
		Err(Nil) -> Err(err)
	}
}

pub fn then(r Result(a, e), f fn(a) Result(b, e)) Result(b, e) {
	match r {
		Ok(x) -> f(x)
		Err(e) -> Err(e)
	}
}

// Only for `Nil` errors, on purpose: dropping an error that carries data is
// usually a mistake.
pub fn unwrap(r Result(a, Nil), default a) a {
	match r {
		Ok(a) -> a
		Err(Nil) -> default
	}
}

// Like `unwrap`, but only calls `default` on an error.
pub fn unwrap_lazy(r Result(a, Nil), default fn() a) a {
	match r {
		Ok(a) -> a
		Err(Nil) -> default()
	}
}

pub fn is_ok(r Result(a, e)) Bool {
	match r {
		Ok(_) -> True
		Err(_) -> False
	}
}

pub fn is_err(r Result(a, e)) Bool {
	match r {
		Ok(_) -> False
		Err(_) -> True
	}
}

// Checks that arrays give the right answers. `[..{0..n}, ..[]]` builds a real
// Array rather than a lazy Range, and then every function that reads or builds
// an array runs over it. Only single numbers print, so the golden stays tiny.

import scarlet/array

fn idx_sum(a Array(Int), i Int, acc Int) Int {
	if i < 0 {
		acc
	} else {
		idx_sum(a, i - 1, acc + { a[i] or 0 })
	}
}

pub fn main() {
	n = 60
	xs = [..{ 0..n }, ..[]]

	// readers, which recurse with [h, ..t]
	total = array::fold(xs, 0, fn(a, b) a + b)
	len = array::length(xs)
	has_30 = array::contains(xs, 30)

	// builders, which rebuild with [h, ..rest]
	doubled = array::map(xs, fn(x) x * 2)
	small = array::filter(xs, fn(x) x < 30)
	rev = array::reverse(xs)

	doubled_total = array::fold(doubled, 0, fn(a, b) a + b)
	small_len = array::length(small)
	rev_head = rev[0] or -1

	// indexing
	idx_total = idx_sum(xs, len - 1, 0)

	println(total)
	println(len)
	println(has_30)
	println(doubled_total)
	println(small_len)
	println(rev_head)
	println(idx_total)
}

// A supervised application: a chat service with rooms.
//
// The process tree is declared as a sequence of bindings, and the runtime
// keeps it standing. Each binding below is a process that will be restarted
// if it fails; the value bound is its address, which stays valid across
// restarts, so the lines after it can capture it and never care. This is what
// the whole program looks like:
//
//	main
//	└─ app                       one-for-one, 5 restarts a minute
//	   ├─ stats                  permanent worker
//	   ├─ rooms                   factory: one member per room name, restarted
//	   │  ├─ 'lobby'
//	   │  └─ ...
//	   └─ http service            (declared by http.serve_in)
//	      ├─ connections          factory: one disposable member per connection
//	      └─ acceptor × cores     transient, one pinned to each core
//
// Run it, then:
//   curl -d 'hello' 'localhost:8080/say?room=lobby'
//   curl 'localhost:8080/history?room=lobby'
//   curl localhost:8080/stats
//   curl localhost:8080/tree
//   curl 'localhost:8080/crash?room=lobby'      # then /history again: the room is back, empty
//
// A room that crashes is restarted by the factory at the same address, so the
// handlers holding it notice nothing but the lost history. A handler that
// crashes closes its own connection. The stats worker crashing loses its
// counts and nothing else. Only something failing over and over reaches
// main, and then the program exits non-zero, which is what a supervisor
// outside the program (systemd, a container runtime) is for.

import scarlet/array
import scarlet/binary
import scarlet/http
import scarlet/http.{Request, Response}
import scarlet/http/body
import scarlet/process
import scarlet/process.{
	FactoryOf,
	OneForOne,
	Process,
	Restarted,
	Subject,
	Supervised,
	SupervisorOf,
	Worker,
}
import scarlet/string

// ---- a room: one process per room name -----------------------------------------------

type RoomMsg {
	Say(text String)
	History(reply Subject(Array(String)))
	// A deliberate bug, to demonstrate a restart.
	Crash
}

// A factory template takes the member's inbox and its key.
fn room(inbox Subject(RoomMsg), name String) Nil {
	room_loop(inbox, name, [])
}

fn room_loop(inbox Subject(RoomMsg), name String, history Array(String)) Nil {
	match process.receive(inbox) {
		Say(text) -> room_loop(inbox, name, array.concat(history, [text]))
		History(reply) -> {
			process.send(reply, history)
			room_loop(inbox, name, history)
		}
		Crash -> {
			// Killing this process ends it; the factory starts a fresh one at
			// the same address.
			process.kill(process.self())
		}
	}
}

// ---- stats: one process, restarted if it fails ------------------------------------------

type StatsMsg {
	Served
	Report(reply Subject(Int))
}

fn stats(inbox Subject(StatsMsg)) Nil {
	stats_loop(inbox, 0)
}

fn stats_loop(inbox Subject(StatsMsg), served Int) Nil {
	match process.receive(inbox) {
		Served -> stats_loop(inbox, served + 1)
		Report(reply) -> {
			process.send(reply, served)
			stats_loop(inbox, served)
		}
	}
}

// ---- requests -----------------------------------------------------------------------------

// A request/reply against a worker. If the worker is between incarnations
// the request is dropped with the dead one, and the timeout says so; the
// client decides what that means (here: an error response).
fn ask(target Subject(msg), make fn(Subject(reply)) msg) Result(reply, Nil) {
	inbox = process.subject()
	process.send(target, make(inbox))
	process.receive_within(inbox, 200)
}

// `?room=NAME`, defaulting to the lobby. lookup_or_start makes the room the
// first time a name is seen and finds it every time after.
fn room_named(rooms process.Factory(RoomMsg, String), req Request) Subject(RoomMsg) {
	name = match binary.to_string(http.query(req)) {
		Ok(q) -> match string.split(q, '=') {
			['room', n] -> string.trim(n)
			_ -> 'lobby'
		}
		Err(Nil) -> 'lobby'
	}
	process.lookup_or_start(rooms, if name == '' { 'lobby' } else { name })
}

fn request_text(req Request) String {
	match body.collect(req.body, 4096) {
		Ok(bytes) -> binary.to_string(bytes) or ''
		Err(_) -> ''
	}
}

fn lines(xs Array(String)) String {
	array.fold(xs, '', fn(out, x) out + x + '\n')
}

fn handle(
	req Request,
	rooms process.Factory(RoomMsg, String),
	counter Subject(StatsMsg),
	app Supervised,
) Response {
	process.send(counter, Served)
	match http.path(req) {
		<<'/say'>> -> {
			process.send(room_named(rooms, req), Say(request_text(req)))
			http.text('said\n')
		}
		<<'/history'>> -> match ask(room_named(rooms, req), fn(reply) History(reply)) {
			Ok(history) -> http.text(lines(history))
			Err(Nil) -> http.text('room is restarting, try again\n')
		}
		<<'/crash'>> -> {
			process.send(room_named(rooms, req), Crash)
			http.text('crashed it\n')
		}
		<<'/stats'>> -> match ask(counter, fn(reply) Report(reply)) {
			Ok(n) -> http.text('${n} requests served by this incarnation\n')
			Err(Nil) -> http.text('stats is restarting\n')
		}
		<<'/tree'>> -> http.text(render(app, ''))
		_ -> http.not_found()
	}
}

// The tree, as the runtime sees it right now.
fn render(node Supervised, indent String) String {
	info = process.info(node)
	line = match info.kind {
		Process -> '${indent}process\n'
		Worker(policy) ->
			'${indent}worker ${string.inspect(policy)}, restarted ${info.restarts} times\n'
		SupervisorOf(strategy) -> '${indent}supervisor ${string.inspect(strategy)}\n'
		FactoryOf(members) ->
			'${indent}factory ${string.inspect(members)}, ${process.count(node)} live\n'
	}
	array.fold(process.children(node), line, fn(out, child) out + render(child, indent + '  '))
}

// ---- main ------------------------------------------------------------------------------------

pub fn main() Nil {
	app <- process.root(OneForOne(restarts: 5, within_ms: 60_000))
	counter = process.permanent(app, stats)
	rooms = process.factory(app, Restarted(restarts: 20, within_ms: 60_000), room)
	match http.serve_in(app, '0.0.0.0', 8080, fn(req) handle(req, rooms, counter, app.supervised)) {
		Ok(_) -> println('chat on http://localhost:8080 — see the comment at the top of this file')
		Err(e) -> println('cannot serve: ${e}')
	}
	// `root` now parks this process; the tree above is the program.
}

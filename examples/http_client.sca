// An HTTP server and a hand-written client for it, in one program.

import scarlet/array
import scarlet/binary
import scarlet/http
import scarlet/http/body
import scarlet/http/h1
import scarlet/http/headers
import scarlet/int
import scarlet/net
import scarlet/net/address
import scarlet/net/error
import scarlet/net/socket
import scarlet/process
import scarlet/result
import scarlet/string
import scarlet/time

const MAX_BODY = 8192

// The server half.

fn route(req http::Request) http::Response {
	match (req.method, http::path(req)) {
		(_, <<'/'>>) -> http::text('root')
		// http::ok has no known length, so it goes out chunked.
		(_, <<'/stream'>>) -> http::ok(body::from_binary(<<'streamed'>>))
		(http::Post, <<'/echo'>>) -> match body::collect(req.body, MAX_BODY) {
			Ok(bytes) -> echo_reply(bytes)
			// The client sent a body the server couldn't read, so it gets a 400.
			Err(_) -> http::Response(..http::text('could not read the body'), status: 400)
		}
		(
			http::Get
			| http::Post
			| http::Put
			| http::Delete
			| http::Patch
			| http::Head
			| http::Options
			| http::Other(_),
			_,
		) -> http::not_found()
	}
}

fn echo_reply(bytes Binary) http::Response {
	match binary::to_string(bytes) {
		Ok(text) -> http::text('echo: ${text}')
		Err(Nil) -> http::text('echo: <not utf-8>')
	}
}

// The client half.

// Connection: close makes the end of the stream the end of the response.
fn read_to_close(conn socket::Socket, acc Binary) Result(Binary, error::NetError) {
	match socket::read(conn, 65536) {
		Ok(socket::Data(bytes)) -> read_to_close(conn, binary::append(acc, bytes))
		Ok(socket::Closed) -> Ok(acc)
		Err(e) -> Err(e)
	}
}

fn request(
	port Int,
	method String,
	target String,
	payload String,
) Result(String, error::NetError) {
	bytes = binary::from_string(payload)
	length = binary::byte_size(bytes)
	head = '${method} ${target} HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\nContent-Length: ${length}\r\n\r\n'
	conn <- result::then(net::connect('127.0.0.1', port))
	Nil <- result::then(socket::write(conn, head |> binary::from_string |> binary::append(bytes)))
	response <- result::then(read_to_close(conn, <<>>))
	Nil <- result::then(socket::close(conn))
	Ok(binary::to_string(response) or '<not utf-8>')
}

fn show(label String, response String) Nil {
	println(label)
	response |> string::split('\r\n') |> array::each(fn(line) println('  | ${line}'))
}

// A second server that writes responses by hand, one target per drain style.

// Small on purpose, so the body cannot arrive whole with the head.
const HEAD_READ = 128
const DEADLINE_MS = 5000

const NAME_LENGTH = <<'Content-Length'>>
const NAME_TE = <<'Transfer-Encoding'>>
const VAL_CHUNKED = <<'chunked'>>

fn fixed_head(n Int) Binary {
	length = headers::Header(name: NAME_LENGTH, value: binary::from_int_ascii(n, binary::Dec))
	h1::serialize_head(200, [length])
}

fn chunked_head() Binary {
	h1::serialize_head(200, [headers::Header(name: NAME_TE, value: VAL_CHUNKED)])
}

// A Body is a thunk that yields one chunk and the rest.
fn two_chunks() body::Body {
	fn() Ok(body::Chunk(<<'first '>>, body::from_binary(<<'second'>>)))
}

fn budget_body() body::Body {
	fn() Ok(body::Chunk(<<'five!'>>, body::from_binary(<<'more'>>)))
}

/** Why the hand-written server gave up on a connection. */
type ServeError {
	NetFailed(error error::NetError)
	DrainFailed(error body::DrainError)
}

fn describe_serve(e ServeError) String {
	match e {
		NetFailed(err) -> string::inspect(err)
		DrainFailed(body::SourceFailed(err)) -> 'source failed: ${string::inspect(err)}'
		DrainFailed(body::SinkFailed(err)) -> 'sink failed: ${string::inspect(err)}'
	}
}

fn net_failed(r Result(a, error::NetError)) Result(a, ServeError) {
	r |> result::map_err(NetFailed)
}

fn drain_failed(r Result(a, body::DrainError)) Result(a, ServeError) {
	r |> result::map_err(DrainFailed)
}

// Prints how a counted drain ended. Each outcome is a success, but they look
// different on the wire.
fn counted(what String, d body::Drained) Nil {
	match d {
		body::Complete -> println('${what}: Complete')
		body::Short(written) -> println('${what}: Short(${written})')
		body::Overran(written) -> println('${what}: Overran(${written})')
	}
}

fn read_head(
	sock socket::Socket,
	buf Binary,
	deadline time::Instant,
) Result((Binary, h1::Parsed), error::NetError) {
	parsed = h1::parse_request(buf, 0)
	match parsed {
		h1::NeedMore -> match socket::read_until(sock, HEAD_READ, deadline) {
			Ok(socket::Data(chunk)) -> read_head(sock, binary::append(buf, chunk), deadline)
			Ok(socket::Closed) -> Err(error::UnexpectedEof)
			Err(e) -> Err(e)
		}
		h1::Done(..) | h1::Bad(_) -> Ok((buf, parsed))
	}
}

// One deadline for the whole body, so a slow peer cannot reset the clock.
fn read_length(
	sock socket::Socket,
	buf Binary,
	consumed Int,
	n Int,
	deadline time::Instant,
) Result(Binary, error::NetError) {
	avail = binary::byte_size(buf) - consumed
	buffered = int::min(avail, n)
	head_bytes = binary::slice_bytes(buf, consumed, buffered) or <<>>
	rest = body::content_length(sock, n - buffered, deadline)
	body::collect(rest, MAX_BODY) |> result::map(fn(tail) binary::append(head_bytes, tail))
}

fn respond(sock socket::Socket, target Binary, payload Binary) Result(Nil, ServeError) {
	match target {
		<<'/pump'>> -> {
			bin = binary::from_string('pumped ${binary::byte_size(payload)} bytes')
			head = fixed_head(binary::byte_size(bin))
			body::drain_with_head(head, body::from_binary(bin), sock) |> drain_failed
		}
		<<'/bare'>> -> {
			bin = <<'drained bare'>>
			Nil <- result::then(
				socket::write(sock, fixed_head(binary::byte_size(bin))) |> net_failed,
			)
			body::drain(body::from_binary(bin), sock) |> drain_failed
		}
		<<'/chunked'>> -> {
			Nil <- result::then(socket::write(sock, chunked_head()) |> net_failed)
			body::drain_chunked(two_chunks(), sock) |> drain_failed
		}
		<<'/streamed'>> ->
			body::drain_chunked_with_head(chunked_head(), two_chunks(), sock) |> drain_failed
		<<'/counted'>> -> {
			bin = <<'counted body'>>
			n = binary::byte_size(bin)
			Nil <- result::then(socket::write(sock, fixed_head(n)) |> net_failed)
			body::drain_counted(body::from_binary(bin), sock, n)
			|> drain_failed
			|> result::map(fn(d) counted('counted', d))
		}
		// The head promises 5 bytes, so the second chunk is dropped.
		<<'/overrun'>> -> {
			Nil <- result::then(socket::write(sock, fixed_head(5)) |> net_failed)
			body::drain_counted(budget_body(), sock, 5)
			|> drain_failed
			|> result::map(fn(d) counted('overrun', d))
		}
		_ -> socket::write(sock, h1::serialize_head(404, [])) |> net_failed
	}
}

// Serves one connection and closes it, even after a failure. The first error
// is the one returned.
fn serve_raw(sock socket::Socket) Result(Nil, ServeError) {
	deadline = time::add_ms(time::monotonic(), DEADLINE_MS)
	served = match read_head(sock, <<>>, deadline) {
		Ok((buf, h1::Done(target: t, headers: hs, consumed: c, ..))) -> match h1::framing(hs) {
			h1::NoBody -> respond(sock, t, <<>>)
			h1::Length(n) -> {
				payload <- result::then(read_length(sock, buf, c, n, deadline) |> net_failed)
				respond(sock, t, payload)
			}
			// This server reads no chunked request bodies.
			h1::Chunked -> reject(sock, 501)
			h1::Invalid(status) -> reject(sock, status)
		}
		Ok((_, h1::Bad(status))) -> reject(sock, status)
		// `read_head` reads until the head is whole, so it never returns this.
		Ok((_, h1::NeedMore)) -> Ok(Nil)
		// A peer that closes before sending a request has nothing to answer.
		Err(e) -> if e == error::UnexpectedEof {
			Ok(Nil)
		} else {
			Err(NetFailed(e))
		}
	}
	closed = socket::close(sock) |> net_failed
	served |> result::then(fn(_) closed)
}

fn reject(sock socket::Socket, status Int) Result(Nil, ServeError) {
	socket::write(sock, h1::serialize_head(status, [])) |> net_failed
}

// Each connection runs in its own process, and a process's result goes
// nowhere, so this is where a failed connection is reported.
fn accept_loop(server net::Server) Nil {
	match net::accept(server) {
		Ok(Some(sock)) -> {
			_ = process::spawn(
				fn() serve_raw(sock) or e -> println('raw server: ${describe_serve(e)}'),
			)
			accept_loop(server)
		}
		Ok(None) -> Nil
		Err(e) -> println('raw server: accept failed: ${string::inspect(e)}')
	}
}

// Running the demo.

/** Why the demo stopped early. */
type DemoError {
	StepFailed(step Step, error error::NetError)
}

type Step {
	Listen
	LocalAddr
	Request(label String)
	Close
}

fn describe(e DemoError) String {
	match e {
		StepFailed(Listen, err) -> 'listen failed: ${string::inspect(err)}'
		StepFailed(LocalAddr, err) -> 'local_addr failed: ${string::inspect(err)}'
		StepFailed(Request(label), err) -> '${label} failed: ${string::inspect(err)}'
		StepFailed(Close, err) -> 'close failed: ${string::inspect(err)}'
	}
}

fn step(r Result(a, error::NetError), s Step) Result(a, DemoError) {
	r |> result::map_err(fn(e) StepFailed(step: s, error: e))
}

// Listens on a spare loopback port.
fn loopback() Result((Int, net::Server), DemoError) {
	server <- result::then(net::listen('127.0.0.1', 0) |> step(Listen))
	addr <- result::then(net::local_addr(server) |> step(LocalAddr))
	Ok((address::port(addr), server))
}

// Sends one request and prints the response.
fn fetch(port Int, method String, target String, payload String) Result(Nil, DemoError) {
	label = '${method} ${target}'
	response <- result::then(request(port, method, target, payload) |> step(Request(label)))
	Ok(show(label, response))
}

fn pump_payload() String {
	array::fold(1..129, '', fn(acc, _i) '${acc}0123456789abcdef')
}

fn by_hand() Result(Nil, DemoError) {
	(port, server) <- result::then(loopback())
	_ = process::spawn(fn() accept_loop(server))

	Nil <- result::then(fetch(port, 'POST', '/pump', pump_payload()))
	Nil <- result::then(fetch(port, 'GET', '/bare', ''))
	Nil <- result::then(fetch(port, 'GET', '/chunked', ''))
	Nil <- result::then(fetch(port, 'GET', '/streamed', ''))
	Nil <- result::then(fetch(port, 'GET', '/counted', ''))
	Nil <- result::then(fetch(port, 'GET', '/overrun', ''))
	net::close(server) |> step(Close)
}

fn run() Result(Nil, DemoError) {
	(port, server) <- result::then(loopback())
	_ = http::serve_on(
		server,
		route,
		fn(e) println('client ${address::to_string(e.peer)} failed: ${string::inspect(e.error)}'),
	)

	Nil <- result::then(fetch(port, 'GET', '/', ''))
	Nil <- result::then(fetch(port, 'POST', '/echo', 'hello'))
	Nil <- result::then(fetch(port, 'GET', '/stream', ''))
	Nil <- result::then(fetch(port, 'GET', '/nope', ''))

	// Wakes the acceptors with Ok(None), so the program can end.
	Nil <- result::then(net::close(server) |> step(Close))
	by_hand()
}

pub fn main() {
	run() or e -> println('demo stopped: ${describe(e)}')
}

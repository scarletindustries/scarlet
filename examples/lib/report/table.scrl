/**
 * Column formatting for a table of temperature readings.
 *
 * `../units` steps up out of this directory to examples/lib/units.scrl, the
 * same module examples/modules.scrl reaches as `./lib/units`.
 */

import scarlet/array
import scarlet/string
import ../units

const COLUMN = 12

/** A row: the reading in the first column, then what it was converted into. */
pub fn row(t units.Celsius, cells Array(String)) String {
	match cells {
		[] -> units.show(t)
		[first, ..rest] ->
			array.fold(rest, pad(units.show(t)) + first, fn(line, cell) line + ' = ' + cell)
	}
}

// Pad to COLUMN scalars so the second column lines up whatever precedes it.
fn pad(cell String) String {
	if string.length(cell) >= COLUMN {
		cell
	} else {
		pad(cell + ' ')
	}
}

// An HTTP server and a hand-written client for it, in one program.

import scarlet/array
import scarlet/binary
import scarlet/http
import scarlet/http/body
import scarlet/http/h1
import scarlet/http/headers
import scarlet/int
import scarlet/net
import scarlet/net/address
import scarlet/net/error
import scarlet/net/socket
import scarlet/process
import scarlet/result
import scarlet/string
import scarlet/time

const MAX_BODY = 8192

// The server half.

fn route(req http.Request) http.Response {
	match (req.method, http.path(req)) {
		(_, <<'/'>>) -> http.text('root')
		// http.ok has no known length, so it goes out chunked.
		(_, <<'/stream'>>) -> http.ok(body.from_binary(<<'streamed'>>))
		(http.Post, <<'/echo'>>) -> echo_reply(body.collect(req.body, MAX_BODY) or <<>>)
		_ -> http.not_found()
	}
}

fn echo_reply(bytes Binary) http.Response {
	match binary.to_string(bytes) {
		Ok(text) -> http.text('echo: ${text}')
		Err(Nil) -> http.text('echo: <not utf-8>')
	}
}

// The client half.

// Connection: close makes the end of the stream the end of the response.
fn read_to_close(conn socket.Socket, acc Binary) Binary {
	match socket.read(conn, 65536) {
		Ok(socket.Data(bytes)) -> read_to_close(conn, binary.append(acc, bytes))
		Ok(socket.Closed) -> acc
		Err(_) -> acc
	}
}

fn request(port Int, method String, target String, payload String) String {
	bytes = binary.from_string(payload)
	length = binary.byte_size(bytes)
	head = '${method} ${target} HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\nContent-Length: ${length}\r\n\r\n'
	match net.connect('127.0.0.1', port) {
		Ok(conn) -> {
			socket.write(conn, binary.append(binary.from_string(head), bytes)) or Nil
			response = read_to_close(conn, <<>>)
			socket.close(conn) or Nil
			binary.to_string(response) or '<not utf-8>'
		}
		Err(e) -> 'connect failed: ${e}'
	}
}

fn show(label String, response String) Nil {
	println(label)
	array.each(string.split(response, '\r\n'), fn(line) println('  | ${line}'))
}

// A second server that writes responses by hand, one target per drain style.

// Small on purpose, so the body cannot arrive whole with the head.
const HEAD_READ = 128
const DEADLINE_MS = 5000

const NAME_LENGTH = <<'Content-Length'>>
const NAME_TE = <<'Transfer-Encoding'>>
const VAL_CHUNKED = <<'chunked'>>

fn fixed_head(n Int) Binary {
	length = headers.Header(name: NAME_LENGTH, value: binary.from_int_ascii(n, binary.Dec))
	h1.serialize_head(200, [length])
}

fn chunked_head() Binary {
	h1.serialize_head(200, [headers.Header(name: NAME_TE, value: VAL_CHUNKED)])
}

// A Body is a thunk that yields one chunk and the rest.
fn two_chunks() body.Body {
	fn() Ok(body.Chunk(<<'first '>>, body.from_binary(<<'second'>>)))
}

fn budget_body() body.Body {
	fn() Ok(body.Chunk(<<'five!'>>, body.from_binary(<<'more'>>)))
}

fn sent(what String, r Result(Nil, body.DrainError)) Nil {
	match r {
		Ok(Nil) -> Nil
		Err(body.SourceFailed(e)) -> println('${what}: source failed: ${string.inspect(e)}')
		Err(body.SinkFailed(e)) -> println('${what}: sink failed: ${string.inspect(e)}')
	}
}

fn counted(what String, r Result(body.Drained, body.DrainError)) Nil {
	match r {
		Ok(body.Complete) -> println('${what}: Complete')
		Ok(body.Short(written)) -> println('${what}: Short(${written})')
		Ok(body.Overran(written)) -> println('${what}: Overran(${written})')
		Err(body.SourceFailed(e)) -> println('${what}: source failed: ${string.inspect(e)}')
		Err(body.SinkFailed(e)) -> println('${what}: sink failed: ${string.inspect(e)}')
	}
}

fn read_head(sock socket.Socket, buf Binary, deadline time.Instant) Result((Binary, h1.Parsed), error.NetError) {
	match h1.parse_request(buf, 0) {
		h1.NeedMore -> match socket.read_until(sock, HEAD_READ, deadline) {
			Ok(socket.Data(chunk)) -> read_head(sock, binary.append(buf, chunk), deadline)
			Ok(socket.Closed) -> Err(error.UnexpectedEof)
			Err(e) -> Err(e)
		}
		parsed -> Ok((buf, parsed))
	}
}

// One deadline for the whole body, so a slow peer cannot reset the clock.
fn read_body(
	sock socket.Socket,
	buf Binary,
	consumed Int,
	hs headers.Headers,
	deadline time.Instant,
) Result(Binary, error.NetError) {
	match h1.framing(hs) {
		h1.Length(n) -> {
			avail = binary.byte_size(buf) - consumed
			buffered = int.min(avail, n)
			head_bytes = binary.slice_bytes(buf, consumed, buffered) or <<>>
			rest = body.content_length(sock, n - buffered, deadline)
			result.map(body.collect(rest, MAX_BODY), fn(tail) binary.append(head_bytes, tail))
		}
		_ -> Ok(<<>>)
	}
}

fn respond(sock socket.Socket, target Binary, payload Binary) Nil {
	match target {
		<<'/pump'>> -> {
			bin = binary.from_string('pumped ${binary.byte_size(payload)} bytes')
			head = fixed_head(binary.byte_size(bin))
			sent('pump', body.drain_with_head(head, body.from_binary(bin), sock))
		}
		<<'/bare'>> -> {
			bin = <<'drained bare'>>
			socket.write(sock, fixed_head(binary.byte_size(bin))) or Nil
			sent('bare', body.drain(body.from_binary(bin), sock))
		}
		<<'/chunked'>> -> {
			socket.write(sock, chunked_head()) or Nil
			sent('chunked', body.drain_chunked(two_chunks(), sock))
		}
		<<'/streamed'>> ->
			sent('streamed', body.drain_chunked_with_head(chunked_head(), two_chunks(), sock))
		<<'/counted'>> -> {
			bin = <<'counted body'>>
			n = binary.byte_size(bin)
			socket.write(sock, fixed_head(n)) or Nil
			counted('counted', body.drain_counted(body.from_binary(bin), sock, n))
		}
		// The head promises 5 bytes, so the second chunk is dropped.
		<<'/overrun'>> -> {
			socket.write(sock, fixed_head(5)) or Nil
			counted('overrun', body.drain_counted(budget_body(), sock, 5))
		}
		_ -> socket.write(sock, h1.serialize_head(404, [])) or Nil
	}
}

fn serve_raw(sock socket.Socket) Nil {
	deadline = time.add_ms(time.monotonic(), DEADLINE_MS)
	match read_head(sock, <<>>, deadline) {
		Ok((buf, h1.Done(target: t, headers: hs, consumed: c, ..))) ->
			respond(sock, t, read_body(sock, buf, c, hs, deadline) or <<>>)
		_ -> Nil
	}
	socket.close(sock) or Nil
}

fn accept_loop(server net.Server) Nil {
	match net.accept(server) {
		Ok(Some(sock)) -> {
			_ = process.spawn(fn() serve_raw(sock))
			accept_loop(server)
		}
		Ok(None) -> Nil
		Err(_) -> Nil
	}
}

fn pump_payload() String {
	array.fold(1..129, '', fn(acc, _i) '${acc}0123456789abcdef')
}

// Listens on a spare loopback port, then runs the rest of the caller's block.
fn bind_loopback(next fn(Int, net.Server) Nil) Nil {
	match loopback() {
		Ok((port, server)) -> next(port, server)
		Err(why) -> println(why)
	}
}

fn loopback() Result((Int, net.Server), String) {
	server <- result.then(result.map_err(net.listen('127.0.0.1', 0), fn(e) 'listen failed: ${e}'))
	addr <- result.then(result.map_err(net.local_addr(server), fn(e) 'local_addr failed: ${e}'))
	Ok((address.port(addr), server))
}

fn by_hand() Nil {
	port, server <- bind_loopback()
	_ = process.spawn(fn() accept_loop(server))

	show('POST /pump', request(port, 'POST', '/pump', pump_payload()))
	show('GET /bare', request(port, 'GET', '/bare', ''))
	show('GET /chunked', request(port, 'GET', '/chunked', ''))
	show('GET /streamed', request(port, 'GET', '/streamed', ''))
	show('GET /counted', request(port, 'GET', '/counted', ''))
	show('GET /overrun', request(port, 'GET', '/overrun', ''))

	net.close(server) or Nil
}

pub fn main() {
	port, server <- bind_loopback()
	_ = http.serve_on(server, route)

	show('GET /', request(port, 'GET', '/', ''))
	show('POST /echo', request(port, 'POST', '/echo', 'hello'))
	show('GET /stream', request(port, 'GET', '/stream', ''))
	show('GET /nope', request(port, 'GET', '/nope', ''))

	// Wakes the acceptors with Ok(None), so the program can end.
	net.close(server) or Nil

	by_hand()
}

// A workload that leans on maps. No other bench touches a map, so nothing else
// would notice if the map built-ins got slower.

import scarlet/map

fn fill(m map::Map(Int, Int), i Int) map::Map(Int, Int) {
	if i == 0 {
		m
	} else {
		fill(map::set(m, i, i * 2), i - 1)
	}
}

fn sum_lookups(m map::Map(Int, Int), i Int, acc Int) Int {
	if i == 0 {
		acc
	} else {
		next = match map::get(m, i) {
			Some(v) -> acc + v
			None -> acc
		}
		sum_lookups(m, i - 1, next)
	}
}

fn churn(m map::Map(Int, Int), i Int) Int {
	if i == 0 {
		map::size(m)
	} else {
		churn(map::delete(map::set(m, i, i), i - 1), i - 1)
	}
}

// It's sized to run for about a second, so the 10ms timer can see a slowdown.
fn repeat_lookups(m map::Map(Int, Int), rounds Int, acc Int) Int {
	if rounds == 0 {
		acc
	} else {
		repeat_lookups(m, rounds - 1, acc + sum_lookups(m, 50000, 0))
	}
}

pub fn main() {
	m = fill(map::new(), 50000)
	println(repeat_lookups(m, 100, 0))
	println(churn(m, 2000000))
}

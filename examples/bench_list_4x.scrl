// Timing bench, size 4x of the bench_list_{1x,2x,4x} triple: identical bodies
// at N / 2N / 4N. A ~2x runtime ratio per doubling proves the list path is
// linear, not quadratic. Strictly tail-recursive so it survives huge N.

import scarlet/array

fn idx(arr Array(Int), i Int, acc Int) Int {
	if i < 0 {
		acc
	} else {
		idx(arr, i - 1, acc + { arr[i] or 0 })
	}
}

pub fn main() {
	n = 2000000
	xs = [..{ 0..n }, ..[]]

	a = array::fold(xs, 0, fn(p, q) p + q)
	b = array::length(xs)
	c = array::contains(xs, -1)
	r = array::reverse(xs)
	d = array::length(r)
	e = idx(xs, n - 1, 0)

	println(a + b + d + e + { if c { 1 } else { 0 } })
}

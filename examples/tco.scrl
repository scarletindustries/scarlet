// Tail recursion. A tail call reuses the current stack frame instead of
// pushing a new one, so recursion here runs in constant stack space.

import scarlet/internal

// The accumulator makes this a tail call: without it, + would wait for the
// recursive call to return.
fn sum_to(n Int, acc Int) Int {
	if n == 0 {
		acc
	} else {
		sum_to(n - 1, acc + n)
	}
}

// Recurse hops times and report the live frame count at the bottom.
fn depth_after(hops Int) Int {
	if hops == 0 {
		internal::stack_depth()
	} else {
		depth_after(hops - 1)
	}
}

// Mutual tail calls optimise the same way: is_even and is_odd swap in one
// frame instead of stacking a million of them.
fn is_even(n Int) Bool {
	if n == 0 {
		True
	} else {
		is_odd(n - 1)
	}
}

fn is_odd(n Int) Bool {
	if n == 0 {
		False
	} else {
		is_even(n - 1)
	}
}

pub fn main() {
	println(sum_to(1000000, 0))

	// Three frames total: entry, main, and depth_after's one live frame.
	println('depth after 1 hop: ${depth_after(1)}')
	println('depth after 1000000 hops: ${depth_after(1000000)}')

	println('1000001 is even: ${is_even(1000001)}')
}

// An HTTP/1.1 server: a handler is a plain fn(Request) Response. Run it, then:
//   curl localhost:8080/
//   curl 'localhost:8080/hello?name=al'
//   curl -d 'ledger v1' localhost:8080/echo
//   curl -i localhost:8080/nope

import scarlet/binary
import scarlet/http
import scarlet/http/body
import scarlet/http/headers
import scarlet/net/error
import scarlet/result

const MAX_BODY = 8192

const NAME_CONTENT_TYPE = <<'Content-Type'>>
const NAME_SERVER = <<'Server'>>
const VAL_TEXT = <<'text/plain; charset=utf-8'>>
const VAL_AL = <<'al'>>

// Fixed(len, body) ties the Content-Length to the bytes actually sent.
fn respond(code Int, s String) http::Response {
	bin = binary::from_string(s)
	http::Response(
		status: code,
		headers: [headers::Header(name: NAME_CONTENT_TYPE, value: VAL_TEXT)],
		body: http::Fixed(binary::byte_size(bin), body::from_binary(bin)),
	)
}

fn hello(req http::Request) http::Response {
	match req |> http::query |> binary::to_string {
		Ok('') -> respond(200, 'hello, stranger\n')
		Ok(q) -> respond(200, 'hello, ${q}\n')
		Err(Nil) -> respond(400, 'query is not utf-8\n')
	}
}

/** Why a body could not be echoed. */
type EchoError {
	ReadFailed(error error::NetError)
	NotUtf8
}

fn echo(req http::Request) http::Response {
	match echo_text(req) {
		Ok(text) -> respond(200, 'echo: ${text}\n')
		Err(ReadFailed(e)) -> respond(400, 'read failed: ${e}\n')
		Err(NotUtf8) -> respond(400, 'body is not utf-8\n')
	}
}

fn echo_text(req http::Request) Result(String, EchoError) {
	bytes <- result::then(body::collect(req.body, MAX_BODY) |> result::map_err(ReadFailed))
	binary::to_string(bytes) |> result::replace_err(NotUtf8)
}

fn route(req http::Request) http::Response {
	response = match (req.method, http::path(req)) {
		(http::Get, <<'/'>>) -> respond(200, 'al http server\n')
		(http::Get, <<'/hello'>>) -> hello(req)
		(http::Post, <<'/echo'>>) -> echo(req)
		(http::Get, _) | (http::Post, _) -> http::not_found()
		(http::Put | http::Delete | http::Patch | http::Head | http::Options | http::Other(_), _) ->
			respond(405, 'method not allowed\n')
	}
	http::with_header(response, NAME_SERVER, VAL_AL)
}

pub fn main() {
	// One acceptor per core. They keep the program alive after main returns.
	match http::serve('0.0.0.0', 8080, route) {
		Ok(_) -> println('Listening on http://localhost:8080')
		Err(e) -> println('serve failed: ${e}')
	}
}

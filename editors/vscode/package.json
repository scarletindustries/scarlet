{
  "name": "scarlet-lang",
  "displayName": "Scarlet",
  "description": "Scarlet language support for Visual Studio Code. Syntax highlighting, diagnostics, completions, and formatting.",
  "version": "0.0.3",
  "publisher": "alistaiir",
  "author": {
    "name": "Alistair Smith",
    "email": "hi@alistair.sh"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#030203",
    "theme": "dark"
  },
  "homepage": "https://scarlet.industries",
  "repository": {
    "type": "git",
    "url": "https://github.com/scarletindustries/scarlet",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/scarletindustries/scarlet/issues"
  },
  "keywords": [
    "scarlet",
    "sca",
    "language-server",
    "lsp",
    "formatter"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "scarlet",
        "aliases": [
          "Scarlet",
          "sca"
        ],
        "extensions": [
          ".sca"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scarlet",
        "scopeName": "source.sca",
        "path": "./syntaxes/scarlet.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Scarlet",
      "properties": {
        "scarlet.binaryPath": {
          "type": "string",
          "default": "scarlet",
          "description": "Path to the Scarlet binary"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "tsc --noEmit -p ./ && bun build src/extension.ts --outfile=out/extension.js --target=node --format=cjs --external vscode",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/node": "^25.0.3",
    "@types/vscode": "~1.107.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.9.3"
  }
}

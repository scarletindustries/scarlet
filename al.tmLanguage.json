{
  "name": "AL",
  "scopeName": "source.al",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#import-statement" },
    { "include": "#type-definition" },
    { "include": "#function-definition" },
    { "include": "#const-definition" },
    { "include": "#variable-with-type" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#module-qualified-access" },
    { "include": "#constructor-call" },
    { "include": "#function-call" },
    { "include": "#labeled-argument" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.al",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)(\\()?([a-zA-Z_][a-zA-Z0-9_]*)?(\\))?",
          "captures": {
            "1": { "name": "punctuation.definition.attribute.al" },
            "2": { "name": "entity.name.function.decorator.al" },
            "3": { "name": "punctuation.brackets.round.al" },
            "4": { "name": "string.unquoted.attribute.al" },
            "5": { "name": "punctuation.brackets.round.al" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.al",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.al",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.other.documentation.al",
              "match": "@(param|returns|example|throws|deprecated)\\b"
            }
          ]
        },
        {
          "name": "comment.block.al",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.al",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.al",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.al",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.al" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.al" }
              },
              "patterns": [{ "include": "#interpolation-expression" }]
            },
            {
              "name": "variable.other.interpolation.al",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.al",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.al",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "interpolation-expression": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#module-qualified-access" },
        { "include": "#constructor-call" },
        { "include": "#function-call" },
        { "include": "#types" },
        { "include": "#operators" },
        {
          "name": "variable.other.al",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        { "include": "#punctuation" }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.other.character.al",
          "match": "`[^`]`"
        }
      ]
    },
    "import-statement": {
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.al" }
      },
      "end": "(?=$|\\n)",
      "patterns": [
        {
          "name": "keyword.control.import.al",
          "match": "\\b(as)\\b"
        },
        {
          "name": "punctuation.separator.path.al",
          "match": "/"
        },
        {
          "name": "entity.name.type.al",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.namespace.al",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.accessor.al",
          "match": "\\."
        },
        { "include": "#punctuation" }
      ]
    },
    "type-definition": {
      "patterns": [
        {
          "comment": "type alias: type Name(params) = Type",
          "match": "\\b(pub\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*\\(([^)]*)\\))?\\s*(=)",
          "captures": {
            "1": { "name": "storage.modifier.visibility.al" },
            "2": { "name": "keyword.other.type.al" },
            "3": { "name": "entity.name.type.al" },
            "4": {
              "patterns": [
                {
                  "name": "variable.other.type.al",
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
                }
              ]
            },
            "5": { "name": "keyword.operator.assignment.al" }
          }
        },
        {
          "comment": "opaque type: pub type Name(params) — no body, ends at EOL",
          "match": "\\b(pub\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*\\(([^)]*)\\))?\\s*$",
          "captures": {
            "1": { "name": "storage.modifier.visibility.al" },
            "2": { "name": "keyword.other.type.al" },
            "3": { "name": "entity.name.type.al" },
            "4": {
              "patterns": [
                {
                  "name": "variable.other.type.al",
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
                }
              ]
            }
          }
        },
        {
          "comment": "type definition: type Name(params) { ... }",
          "begin": "\\b(pub\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(\\())?",
          "beginCaptures": {
            "1": { "name": "storage.modifier.visibility.al" },
            "2": { "name": "keyword.other.type.al" },
            "3": { "name": "entity.name.type.al" },
            "4": { "name": "punctuation.definition.typeparameters.begin.al" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.type.end.al" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#generic-params" },
            { "include": "#type-body" }
          ]
        }
      ]
    },
    "generic-params": {
      "begin": "(?<=\\()",
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.al" }
      },
      "patterns": [
        {
          "name": "variable.other.type.al",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.al",
          "match": ","
        }
      ]
    },
    "type-body": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.type.begin.al" }
      },
      "end": "(?=\\})",
      "patterns": [
        { "include": "#comments" },
        {
          "comment": "Constructor with payload: Ctor(label Type, ...)",
          "begin": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.function.constructor.al" },
            "2": { "name": "punctuation.definition.parameters.begin.al" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.al" }
          },
          "patterns": [{ "include": "#field-decl" }]
        },
        {
          "comment": "Nullary constructor",
          "name": "entity.name.function.constructor.al",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        { "include": "#field-decl" }
      ]
    },
    "field-decl": {
      "patterns": [
        {
          "comment": "Field label + concrete type",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.member.al" },
            "2": { "name": "entity.name.type.al" }
          }
        },
        {
          "comment": "Field label + type parameter",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.member.al" },
            "2": { "name": "variable.other.type.al" }
          }
        },
        {
          "name": "entity.name.type.al",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.al",
          "match": ","
        },
        { "include": "#punctuation" }
      ]
    },
    "function-definition": {
      "begin": "\\b(pub\\s+)?(fn)\\s+([a-z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.al" },
        "2": { "name": "keyword.other.fn.al" },
        "3": { "name": "entity.name.function.al" }
      },
      "end": "(?=\\{|\\n|$)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#function-params" },
        { "include": "#type-args" },
        {
          "name": "keyword.other.fn.al",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.operator.arrow.al",
          "match": "->"
        },
        {
          "name": "entity.name.type.al",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.type.al",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "function-params": {
      "comment": "The param list opens immediately after the function name (\\G) and closes at the matching paren. Nested type-argument parens are consumed by #type-args so the inner ) of e.g. Option(a) cannot end the list early.",
      "begin": "\\G\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.parameters.begin.al" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.al" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#type-args" },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.parameter.al" },
            "2": { "name": "entity.name.type.al" }
          }
        },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+(fn)\\b",
          "captures": {
            "1": { "name": "variable.parameter.al" },
            "2": { "name": "keyword.other.fn.al" }
          }
        },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.parameter.al" },
            "2": { "name": "variable.other.type.al" }
          }
        },
        {
          "name": "variable.parameter.al",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.al",
          "match": ","
        }
      ]
    },
    "type-args": {
      "comment": "Balanced ( ... ) for a parametrized/fn type. Recursive so Option(List(a)) and Result(a, e) nest correctly.",
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.begin.al" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.al" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "keyword.other.fn.al",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.operator.arrow.al",
          "match": "->"
        },
        {
          "name": "entity.name.type.al",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        { "include": "#type-args" },
        {
          "name": "variable.other.type.al",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.al",
          "match": ","
        }
      ]
    },
    "const-definition": {
      "match": "\\b(pub\\s+)?(const)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "storage.modifier.visibility.al" },
        "2": { "name": "keyword.other.const.al" },
        "3": { "name": "variable.other.constant.al" },
        "4": { "name": "keyword.operator.assignment.al" }
      }
    },
    "variable-with-type": {
      "comment": "Variable declaration with type annotation: name Type = ...",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.al" },
        "2": { "name": "entity.name.type.al" },
        "3": { "name": "keyword.operator.assignment.al" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.al",
          "match": "\\b(if|else|match|in|or|assert)\\b"
        },
        {
          "name": "keyword.control.import.al",
          "match": "\\b(import|as)\\b"
        },
        {
          "name": "storage.modifier.visibility.al",
          "match": "\\bpub\\b"
        },
        {
          "name": "keyword.other.al",
          "match": "\\b(fn|type|const)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.al",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.al",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.al",
          "match": "\\b(Nil|None|Some|Ok|Err)\\b"
        }
      ]
    },
    "module-qualified-access": {
      "comment": "module.name access (lowercase qualifier)",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)(\\.)(?=[A-Za-z_])",
      "captures": {
        "1": { "name": "entity.name.namespace.al" },
        "2": { "name": "punctuation.accessor.al" }
      }
    },
    "constructor-call": {
      "comment": "Constructor invocation / pattern: Uppercase optionally followed by (",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.constructor.al" }
      }
    },
    "function-call": {
      "comment": "Function calls",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.al" }
      }
    },
    "labeled-argument": {
      "comment": "Labeled call argument: label: value",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "variable.parameter.label.al" },
        "2": { "name": "punctuation.separator.colon.al" }
      }
    },
    "types": {
      "patterns": [
        {
          "comment": "Standalone type name",
          "name": "entity.name.type.al",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.al",
          "match": "->"
        },
        {
          "name": "keyword.operator.spread.al",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.al",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.al",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.al",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.al",
          "match": "="
        },
        {
          "name": "keyword.operator.attribute.al",
          "match": "@"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.al",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.al",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.al",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.begin.al",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.al",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.al",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.al",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.al",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.al",
          "match": "\\)"
        }
      ]
    }
  }
}

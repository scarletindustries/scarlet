const rounds = 300

pub fn main() {
	match run(binary::from_string(rap_benchmark_minified), rounds, 0, JsonNull) {
		Ok((total, document)) -> {
			t = tally(document, Tally(0, 0, 0, 0, 0, 0))
			println(total)
			println(
				"${t.objects} ${t.arrays} ${t.strings} ${t.numbers} ${t.literals} ${t.characters}",
			)
		}
		Err(e) -> println("parse error: ${string::inspect(e)}")
	}
}

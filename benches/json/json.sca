// Json from the Are We Fast Yet suite: a hand-written JSON parser run over the
// suite's fixed 25,820-byte document. It stresses byte scanning, cutting strings
// out of the input and building a tree. Ported from benchmarks/Lua/json.lua in
// https://github.com/smarr/are-we-fast-yet (MIT licence).
// The suite's parser is based on https://github.com/ralfstx/minimal-json (MIT).

import scarlet/array
import scarlet/binary
import scarlet/map
import scarlet/result
import scarlet/string

type Json {
	JsonNull
	JsonTrue
	JsonFalse
	JsonNumber(text String)
	JsonString(text String)
	JsonArray(items Array(Json))
	// `table` maps a name to its place in `names` and `values`.
	JsonObject(names Array(String), values Array(Json), table map::Map(String, Int))
}

type Expected {
	Value
	Name
	Digit
	Escape
	Byte(byte Int)
	CommaOrBracket
	CommaOrBrace
	EndOfText
	Utf8
}

type ParseError {
	offset Int
	expected Expected
}

fn parse(input Binary) Result(Json, ParseError) {
	(value, after) <- result::then(read_value(input, skip_white_space(input, 0)))
	end = skip_white_space(input, after)
	if binary::byte_at(input, end) == -1 {
		Ok(value)
	} else {
		Err(ParseError(end, EndOfText))
	}
}

fn read_value(input Binary, i Int) Result((Json, Int), ParseError) {
	match binary::byte_at(input, i) {
		// n, t, f
		110 -> read_null(input, i)
		116 -> read_true(input, i)
		102 -> read_false(input, i)
		// "
		34 -> read_string(input, i)
		// [
		91 -> read_array(input, i)
		// {
		123 -> read_object(input, i)
		// - and 0 to 9
		45 | 48..58 -> read_number(input, i)
		_ -> Err(ParseError(i, Value))
	}
}

fn read_array(input Binary, i Int) Result((Json, Int), ParseError) {
	first = skip_white_space(input, i + 1)
	// ]
	if binary::byte_at(input, first) == 93 {
		Ok((JsonArray([]), first + 1))
	} else {
		read_elements(input, first, [])
	}
}

fn read_elements(input Binary, i Int, items Array(Json)) Result((Json, Int), ParseError) {
	(value, after) <- result::then(read_value(input, skip_white_space(input, i)))
	next = skip_white_space(input, after)
	match binary::byte_at(input, next) {
		// ,
		44 -> read_elements(input, next + 1, [..items, value])
		// ]
		93 -> Ok((JsonArray([..items, value]), next + 1))
		_ -> Err(ParseError(next, CommaOrBracket))
	}
}

fn read_object(input Binary, i Int) Result((Json, Int), ParseError) {
	first = skip_white_space(input, i + 1)
	// }
	if binary::byte_at(input, first) == 125 {
		Ok((JsonObject([], [], map::new()), first + 1))
	} else {
		read_members(input, first, [], [], map::new())
	}
}

fn read_members(
	input Binary,
	i Int,
	names Array(String),
	values Array(Json),
	table map::Map(String, Int),
) Result((Json, Int), ParseError) {
	(name, after_name) <- result::then(read_name(input, skip_white_space(input, i)))
	// :
	colon <- result::then(read_required_byte(input, skip_white_space(input, after_name), 58))
	(value, after) <- result::then(read_value(input, skip_white_space(input, colon)))
	next = skip_white_space(input, after)
	more_table = map::set(table, name, array::length(names))
	more_names = [..names, name]
	more_values = [..values, value]
	match binary::byte_at(input, next) {
		// ,
		44 -> read_members(input, next + 1, more_names, more_values, more_table)
		// }
		125 -> Ok((JsonObject(more_names, more_values, more_table), next + 1))
		_ -> Err(ParseError(next, CommaOrBrace))
	}
}

fn read_name(input Binary, i Int) Result((String, Int), ParseError) {
	if binary::byte_at(input, i) == 34 {
		read_string_internal(input, i)
	} else {
		Err(ParseError(i, Name))
	}
}

fn read_null(input Binary, i Int) Result((Json, Int), ParseError) {
	u <- result::then(read_required_byte(input, i + 1, 117))
	l <- result::then(read_required_byte(input, u, 108))
	end <- result::then(read_required_byte(input, l, 108))
	Ok((JsonNull, end))
}

fn read_true(input Binary, i Int) Result((Json, Int), ParseError) {
	r <- result::then(read_required_byte(input, i + 1, 114))
	u <- result::then(read_required_byte(input, r, 117))
	end <- result::then(read_required_byte(input, u, 101))
	Ok((JsonTrue, end))
}

fn read_false(input Binary, i Int) Result((Json, Int), ParseError) {
	a <- result::then(read_required_byte(input, i + 1, 97))
	l <- result::then(read_required_byte(input, a, 108))
	s <- result::then(read_required_byte(input, l, 115))
	end <- result::then(read_required_byte(input, s, 101))
	Ok((JsonFalse, end))
}

// Gives the place after `byte` if it is the one at `i`.
fn read_required_byte(input Binary, i Int, byte Int) Result(Int, ParseError) {
	if binary::byte_at(input, i) == byte {
		Ok(i + 1)
	} else {
		Err(ParseError(i, Byte(byte)))
	}
}

fn read_string(input Binary, i Int) Result((Json, Int), ParseError) {
	(text, after) <- result::then(read_string_internal(input, i))
	Ok((JsonString(text), after))
}

fn read_string_internal(input Binary, i Int) Result((String, Int), ParseError) {
	scan_string(input, i + 1, i + 1, "")
}

// `start` is where the run of plain bytes being captured began, and `buffer`
// holds what earlier runs and escapes came to.
fn scan_string(input Binary, i Int, start Int, buffer String) Result((String, Int), ParseError) {
	match binary::byte_at(input, i) {
		// "
		34 -> {
			run <- result::then(capture(input, start, i))
			if buffer == "" {
				Ok((run, i + 1))
			} else {
				Ok((buffer + run, i + 1))
			}
		}
		// \
		92 -> {
			run <- result::then(capture(input, start, i))
			escaped <- result::then(read_escape(input, i + 1))
			scan_string(input, i + 2, i + 2, buffer + run + escaped)
		}
		-1 -> Err(ParseError(i, Byte(34)))
		_ -> scan_string(input, i + 1, start, buffer)
	}
}

fn read_escape(input Binary, i Int) Result(String, ParseError) {
	match binary::byte_at(input, i) {
		34 -> Ok("\"")
		47 -> Ok("/")
		92 -> Ok("\\")
		// b and f
		98 -> Ok("")
		102 -> Ok("")
		110 -> Ok("\n")
		114 -> Ok("\r")
		116 -> Ok("\t")
		_ -> Err(ParseError(i, Escape))
	}
}

fn capture(input Binary, start Int, end Int) Result(String, ParseError) {
	binary::slice_bytes(input, start, end - start)
	|> result::then(binary::to_string)
	|> result::replace_err(ParseError(start, Utf8))
}

fn read_number(input Binary, i Int) Result((Json, Int), ParseError) {
	// -
	digits = if binary::byte_at(input, i) == 45 {
		i + 1
	} else {
		i
	}
	first = binary::byte_at(input, digits)
	if is_digit(first) {
		// A leading 0 stands alone.
		whole = if first == 48 {
			digits + 1
		} else {
			skip_digits(input, digits + 1)
		}
		fraction <- result::then(read_fraction(input, whole))
		end <- result::then(read_exponent(input, fraction))
		text <- result::then(capture(input, i, end))
		Ok((JsonNumber(text), end))
	} else {
		Err(ParseError(digits, Digit))
	}
}

fn read_fraction(input Binary, i Int) Result(Int, ParseError) {
	// .
	if binary::byte_at(input, i) == 46 {
		read_digits(input, i + 1)
	} else {
		Ok(i)
	}
}

fn read_exponent(input Binary, i Int) Result(Int, ParseError) {
	match binary::byte_at(input, i) {
		// e and E, then + or -
		101 | 69 -> match binary::byte_at(input, i + 1) {
			43 | 45 -> read_digits(input, i + 2)
			_ -> read_digits(input, i + 1)
		}
		_ -> Ok(i)
	}
}

// One digit or more.
fn read_digits(input Binary, i Int) Result(Int, ParseError) {
	if is_digit(binary::byte_at(input, i)) {
		Ok(skip_digits(input, i + 1))
	} else {
		Err(ParseError(i, Digit))
	}
}

fn skip_digits(input Binary, i Int) Int {
	if is_digit(binary::byte_at(input, i)) {
		skip_digits(input, i + 1)
	} else {
		i
	}
}

fn is_digit(byte Int) Bool {
	byte >= 48 && byte <= 57
}

fn skip_white_space(input Binary, i Int) Int {
	match binary::byte_at(input, i) {
		// space, tab, line feed, carriage return
		32 | 9 | 10 | 13 -> skip_white_space(input, i + 1)
		_ -> i
	}
}

fn get(object Json, name String) Option(Json) {
	match object {
		JsonObject(_, values, table) -> match map::get(table, name) {
			Some(index) -> values[index]
			None -> None
		}
		JsonNull | JsonTrue | JsonFalse | JsonNumber(_) | JsonString(_) | JsonArray(_) -> None
	}
}

fn is_object(value Json) Bool {
	match value {
		JsonObject(..) -> True
		JsonNull | JsonTrue | JsonFalse | JsonNumber(_) | JsonString(_) | JsonArray(_) -> False
	}
}

// The suite's check: `head` is an object and `operations` is an array. It
// gives the number of operations, or -1 for a document of another shape.
fn operations(document Json) Int {
	head = get(document, "head") or JsonNull
	if is_object(head) {
		match get(document, "operations") or JsonNull {
			JsonArray(items) -> array::length(items)
			JsonNull | JsonTrue | JsonFalse | JsonNumber(_) | JsonString(_) | JsonObject(..) -> -1
		}
	} else {
		-1
	}
}

type Tally {
	objects Int
	arrays Int
	strings Int
	numbers Int
	literals Int
	characters Int
}

fn tally(value Json, t Tally) Tally {
	match value {
		JsonNull | JsonTrue | JsonFalse -> Tally(..t, literals: t.literals + 1)
		JsonNumber(text) ->
			Tally(..t, numbers: t.numbers + 1, characters: t.characters + string::length(text))
		JsonString(text) ->
			Tally(..t, strings: t.strings + 1, characters: t.characters + string::length(text))
		JsonArray(items) ->
			array::fold(items, Tally(..t, arrays: t.arrays + 1), fn(acc, item) tally(item, acc))
		JsonObject(names, values, _) -> {
			named = array::fold(
				names,
				Tally(..t, objects: t.objects + 1),
				fn(acc, name) Tally(..acc, characters: acc.characters + string::length(name)),
			)
			array::fold(values, named, fn(acc, item) tally(item, acc))
		}
	}
}

// Parses the document `rounds` times, adding up the operations each parse
// found, and gives the last tree back with the total.
fn run(input Binary, rounds Int, total Int, last Json) Result((Int, Json), ParseError) {
	if rounds == 0 {
		Ok((total, last))
	} else {
		match parse(input) {
			Ok(document) -> run(input, rounds - 1, total + operations(document), document)
			Err(e) -> Err(e)
		}
	}
}


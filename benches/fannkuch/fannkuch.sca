// fannkuch-redux: flips the front of every permutation of 0..N-1 until 0 leads,
// and keeps a checksum and the longest run of flips. It stresses small-array
// reads, writes and reversal. Ported from Mike Pall's Lua program in the Computer
// Language Benchmarks Game (benchmarksgame-team.pages.debian.net, BSD-3 licence).

import scarlet/array

type Outcome {
	sum Int
	maxflips Int
}

type Step {
	Done
	Next(p Array(Int), s Array(Int))
}

fn iota(i Int, n Int, acc Array(Int)) Array(Int) {
	if i == n {
		acc
	} else {
		iota(i + 1, n, [..acc, i])
	}
}

// Swaps q[i] and q[j] and walks inwards until the two meet.
fn reverse(q Array(Int), i Int, j Int) Array(Int) {
	if i < j {
		reverse(array::swap(q, i, j), i + 1, j - 1)
	} else {
		q
	}
}

// The first element lives in q1, not in q, so slot 0 of q is never read. The
// first write copies q, which the caller keeps, and the rest are in place.
fn flip(q Array(Int), q1 Int, flips Int) Int {
	qq = q[q1] or 0
	if qq == 0 {
		flips
	} else {
		flip(q |> array::put(q1, q1) |> reverse(1, q1 - 1), qq, flips + 1)
	}
}

// Rotates the first m + 1 elements left by one.
fn rotate(p Array(Int), m Int, n Int) Array(Int) {
	match p {
		[] -> p
		[h, ..t] -> {
			moved = t[0..m] or []
			rest = t[m..n - 1] or []
			[..moved, h, ..rest]
		}
	}
}

fn advance(p Array(Int), s Array(Int), i Int, n Int) Step {
	sx = s[i] or 0
	if sx != 0 {
		Next(p, array::put(s, i, sx - 1))
	} else if i == n - 1 {
		Done
	} else {
		advance(rotate(p, i + 1, n), array::put(s, i, i), i + 1, n)
	}
}

fn run(p Array(Int), s Array(Int), sign Int, sum Int, maxflips Int, n Int) Outcome {
	q1 = p[0] or 0
	flips = if q1 == 0 {
		0
	} else {
		flip(p, q1, 1)
	}
	sum2 = sum + sign * flips
	max2 = if flips > maxflips { flips } else { maxflips }
	if sign == 1 {
		run(array::swap(p, 0, 1), s, -1, sum2, max2, n)
	} else {
		match advance(array::swap(p, 1, 2), s, 2, n) {
			Done -> Outcome(sum2, max2)
			Next(p2, s2) -> run(p2, s2, 1, sum2, max2, n)
		}
	}
}

pub fn main() {
	n = 9
	done = run(iota(0, n, []), iota(0, n, []), 1, 0, 0, n)
	println(done.sum)
	println("Pfannkuchen(${n}) = ${done.maxflips}")
}

// AWFY List: builds linked lists of a user-defined type and runs the recursive
// tail (Takeuchi) comparison over them. It stresses allocation and recursion.
// Ported from Are We Fast Yet (github.com/smarr/are-we-fast-yet, MIT licence).

type List {
	Empty
	Element(val Int, next List)
}

fn length(l List) Int {
	match l {
		Empty -> 0
		Element(_, next) -> 1 + length(next)
	}
}

fn make_list(length Int) List {
	if length == 0 {
		Empty
	} else {
		Element(length, make_list(length - 1))
	}
}

fn is_shorter_than(x List, y List) Bool {
	match y {
		Empty -> False
		Element(_, y_tail) -> match x {
			Empty -> True
			Element(_, x_tail) -> is_shorter_than(x_tail, y_tail)
		}
	}
}

fn next(l List) List {
	match l {
		Empty -> Empty
		Element(_, rest) -> rest
	}
}

fn tail(x List, y List, z List) List {
	if is_shorter_than(y, x) {
		tail(tail(next(x), y, z), tail(next(y), z, x), tail(next(z), x, y))
	} else {
		z
	}
}

fn benchmark() Int {
	length(tail(make_list(15), make_list(10), make_list(6)))
}

fn run(iterations Int, total Int) Int {
	if iterations == 0 {
		total
	} else {
		run(iterations - 1, total + benchmark())
	}
}

pub fn main() {
	println(run(2000, 0))
}

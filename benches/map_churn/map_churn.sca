// Stresses the built-in map: insert scattered int keys, look them all up
// several times (with a miss probe beside each hit), then delete the oldest
// key and insert a new one in a long churn loop. Written for this suite,
// starting from examples/bench_map.sca.

import scarlet/map

// A full-period generator, so the keys never repeat. Its products stay far
// below 2^53, which keeps Lua and JavaScript numbers exact.
fn next(x Int) Int {
	{ x * 69069 + 1 } % 4294967296
}

fn fill(m map::Map(Int, Int), x Int, i Int, n Int) (map::Map(Int, Int), Int) {
	if i == n {
		(m, x)
	} else {
		k = next(x)
		fill(map::set(m, k, i), k, i + 1, n)
	}
}

fn lookups(m map::Map(Int, Int), x Int, i Int, acc Int) Int {
	if i == 0 {
		acc
	} else {
		k = next(x)
		hit = match map::get(m, k) {
			Some(v) -> { acc * 31 + v } % 1000000007
			None -> acc
		}
		probed = match map::get(m, k + 1) {
			Some(v) -> hit + v
			None -> hit
		}
		lookups(m, k, i - 1, probed)
	}
}

fn rounds(m map::Map(Int, Int), x Int, n Int, r Int, acc Int) Int {
	if r == 0 {
		acc
	} else {
		rounds(m, x, n, r - 1, lookups(m, x, n, acc))
	}
}

// The map is a sliding window over the key sequence: `trail` names the oldest
// key, which goes, and `lead` the next new one, which comes in.
fn churn(m map::Map(Int, Int), lead Int, trail Int, i Int, steps Int) (map::Map(Int, Int), Int) {
	if i == steps {
		(m, trail)
	} else {
		t = next(trail)
		l = next(lead)
		m |> map::delete(t) |> map::set(l, i) |> churn(l, t, i + 1, steps)
	}
}

pub fn main() {
	n = 200000
	seed = 42
	(m, lead) = fill(map::new(), seed, 0, n)
	println(rounds(m, seed, n, 10, 0))
	(churned, trail) = churn(m, lead, seed, 0, 3000000)
	// The window's keys must all be there and the first `n`, long deleted, must
	// all be gone: a hit in the second pass would change the sum.
	window = lookups(churned, trail, n, 0)
	println(lookups(churned, seed, n, window))
}

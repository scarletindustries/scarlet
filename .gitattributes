* text=auto eol=lf
*.bat eol=crlf

# Golden test outputs are compared byte-for-byte; some contain literal CRLF
# (e.g. HTTP wire output), so they must never be eol-normalized.
crates/al/tests/golden/** -text

*.sca linguist-language=Rust

# Generated artifacts: collapsed in GitHub diffs, excluded from language
# stats. tree-sitter output is rebuilt by `bun run generate`; lexical.js and
# the tmLanguage by `cargo xtask gen-editor-syntax`.
editors/tree-sitter-scarlet/src/** linguist-generated=true
# ...except the hand-written external scanner.
editors/tree-sitter-scarlet/src/scanner.c -linguist-generated
editors/tree-sitter-scarlet/lexical.js linguist-generated=true
scarlet.tmLanguage.json linguist-generated=true
